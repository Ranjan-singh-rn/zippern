# LOCAL DEVELOPMENT template. Copy to .env.local — the API reads .env.local
# instead of .env whenever it exists. Never commit either file.
#
# Outside production the API refuses to start unless MongoDB is on this machine
# and every Firebase service goes to its local emulator under a demo- project.
# No service-account key is read and no email is sent. Production values never
# belong in this file. See LOCAL_DEVELOPMENT.md.

# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
# 8000, not 8080: the Firestore emulator listens on 8080 (firebase.json).
API_PORT=8000

# ── MongoDB — a server on this machine only ──────────────────────────────────
# A replica set is required — transactions do not work on a standalone server.
# A single-node one in Docker is enough; see LOCAL_DEVELOPMENT.md. A separate
# database name keeps local data visibly apart from anything else.
MONGO_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGO_DB=zipper_dev

# ── Firebase — local emulators only ──────────────────────────────────────────
# A demo- project exists only in the emulators. Start them with
#   backend/scripts/start_local_emulators.sh
# which always passes --project demo-zipper (.firebaserc's default is production).
# No credentials path: outside production the SDK runs with anonymous
# credentials and never reads a key file.
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=demo-zipper
FIREBASE_STORAGE_BUCKET=demo-zipper.appspot.com
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
STORAGE_EMULATOR_HOST=http://127.0.0.1:9199

# ── Session tokens ───────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ISSUER=zipper-api
SESSION_TTL_MINUTES=10080

# The observer is deliberately NOT on the figure above. Their credential is a
# one-time code emailed to a mailbox that is not the account address, and
# `renew_session` refuses to renew an observer session at all — a week-long,
# self-renewing token minted from one code would undo the control the code is.
OBSERVER_SESSION_TTL_MINUTES=720

# How long after a token expires it may still be renewed silently. This is the
# "long time no see" line: inside it the CRM renews without a word, outside it
# the person is asked to sign in. 4320 = 3 days, so with the week above nobody
# is asked for a password until they have been away for ten days.
SESSION_RENEWAL_GRACE_MINUTES=4320

# When the browser renews. Served to it on every session response, so this is
# the only place the number lives. 1440 = one day before expiry.
SESSION_RENEW_BEFORE_MINUTES=1440

# ── Observer access ──────────────────────────────────────────────────────────
# The observer logs in with this address. No stored password — a one-time code
# is emailed for every login.
OBSERVER_EMAIL=314zipper@gmail.com
# The one-time code is delivered here, deliberately a different mailbox.
OBSERVER_OTP_DELIVERY_EMAIL=soumyars675@gmail.com
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ── Email (SendGrid) ─────────────────────────────────────────────────────────
# Ignored outside production: the key is dropped when settings load, and every
# delivery is recorded as not_configured. Leave it empty here.
SENDGRID_API_KEY=
# MUST be an address verified in SendGrid (Single Sender Verification or a
# domain you have authenticated). Sending from an unverified address is
# rejected with a 403 and the mail silently never arrives.
#
# Verified is NOT the same as authenticated. A @gmail.com From sent through
# SendGrid can never carry an aligned SPF or DKIM signature — nobody outside
# Google can publish DNS for gmail.com — so it is filed as spam at every
# serious receiver, whatever the content says. DEPLOYMENT.md § 11 is the fix,
# and a real domain is the only fix. `/tech/email` shows `sender.aligned:
# false` with the reason on every row until it is done.
MAIL_FROM=314zipper@gmail.com
MAIL_FROM_NAME=Zipper Team

# ── Sender identities — three streams, ONE authenticated domain ──────────────
# Empty means "use MAIL_FROM", so leaving these blank changes nothing.
# Splitting them keeps a reputation problem on daily reports from stopping a
# payout receipt. They must all sit on the same domain or one DKIM key cannot
# cover them — `email.sender_alignment()` records it on the delivery row when
# they do not.
#
# MAIL_FROM_TRANSACTIONAL  approvals, receipts, invitations, sign-in codes
# MAIL_FROM_BULK           scheduled reports and alerts
# MAIL_FROM_SUPPORT        sends nothing; it is the Reply-To on everything
MAIL_FROM_TRANSACTIONAL=
MAIL_FROM_NAME_TRANSACTIONAL=
MAIL_FROM_BULK=
MAIL_FROM_NAME_BULK=
MAIL_FROM_SUPPORT=
SUPPORT_EMAIL=

# ── Unsubscribe — Gmail and Yahoo require this of bulk senders ───────────────
# The mailbox the List-Unsubscribe mailto: reaches. Must accept mail; Gmail
# checks that it does not hard-bounce. Empty derives unsubscribe@<MAIL_FROM's
# domain>.
UNSUBSCRIBE_EMAIL=
# The RFC 8058 one-click endpoint. List-Unsubscribe-Post is only ever sent when
# this is set, because advertising one-click and then not answering it is worse
# for a domain than never advertising it. The route exists and is
# token-authenticated: https://<api host>/api/notifications/unsubscribe
UNSUBSCRIBE_URL=

# ── Attachment limits ────────────────────────────────────────────────────────
# Per file, and for one whole message. A CSV over the per-file limit, or that
# would push the message over the total, is left OFF and named in the email
# body — a report that arrives without one CSV beats one that does not arrive.
EMAIL_MAX_ATTACHMENT_BYTES=5000000
EMAIL_MAX_TOTAL_ATTACHMENT_BYTES=20000000

# ── Composed broadcasts (8A.7.2) — the email a person types ──────────────────
# The CRM's email composer at /broadcasts/email. These are not tuning knobs:
# they are the shape of what one click is allowed to do.
#
# MAX_RECIPIENTS   An audience larger than this is REFUSED, never trimmed —
#                  half a broadcast is worse than none, because nobody can tell
#                  from outside which half arrived. The default is arithmetic:
#                  the send runs inside the HTTP request that asked for it, and
#                  2,000 messages is roughly 50 s at the concurrency below,
#                  inside Cloud Run's 300 s request timeout with room to spare.
#                  Do not raise it without moving the send onto a queue.
# CONFIRM_ABOVE    Above this many recipients the request must echo the exact
#                  resolved count back before anything is sent. A dialog can be
#                  clicked through; this cannot, and it is checked on the server
#                  whether the request came from the CRM or from curl.
BROADCAST_MAX_RECIPIENTS=2000
BROADCAST_CONFIRM_ABOVE=25
# Pacing against SendGrid. `broadcast_batch_size` messages per serial slice,
# `broadcast_concurrency` slices at once, a pause between waves. After
# THROTTLE_WAVES_BEFORE_STOP consecutive rate-limited waves the send stops and
# names every address it never attempted, rather than turning a throttle that
# would have cleared into hundreds of permanent-looking failures.
BROADCAST_BATCH_SIZE=25
BROADCAST_CONCURRENCY=8
BROADCAST_WAVE_PAUSE_SECONDS=0.5
BROADCAST_THROTTLE_WAVES_BEFORE_STOP=3

# ── Weekly accrual service credential ────────────────────────────────────────
# The standing key the Sunday Cloud Function presents as `X-Service-Key` to
# accrue agency commission unattended. It unlocks two operations —
# commission accrual and its preview — and nothing else. See
# `app/core/security.py` → SERVICE_CREDENTIALS.
#
# Generate with: python3 -m scripts.generate_service_key
# In production it comes from Secret Manager as a Cloud Run environment
# variable and is never written to a file. See DEPLOYMENT.md § 8.
#
# LEAVE THIS EMPTY LOCALLY unless you are deliberately testing the machine
# path. Empty means no machine may call anything, which is the right default.
# A value below 32 characters is treated as unset.
SERVICE_KEY_WEEKLY_ACCRUAL=

# The most commission one unattended run may accrue for one agency in one
# period, in paise. Above this the accrual is refused whole and a person is
# asked to look. 125000000 = ₹12,50,000. See the comment in app/config.py.
SERVICE_ACCRUAL_MAX_MINOR=125000000

# ── Scheduled reporting service credential ───────────────────────────────────
# The standing key the six scheduled Cloud Functions present as `X-Service-Key`
# to run the reports, the alert scan and the transactional email sweep. It
# unlocks four operations — reports.send, alerts.scan, email.sweep,
# email.events — and no money operation at all: nothing it can reach moves a
# balance, signs a card or creates a liability.
#
# A DIFFERENT VALUE from SERVICE_KEY_WEEKLY_ACCRUAL, deliberately. Leaking the
# ability to email a report must not also grant the ability to create a
# commission liability. Never set them to the same string.
#
# Generate with: python3 -m scripts.generate_service_key --credential reporting
# In production it comes from Secret Manager as a Cloud Run environment
# variable and is never written to a file. See DEPLOYMENT.md § 9.
#
# LEAVE THIS EMPTY LOCALLY unless you are deliberately testing the machine
# path. Empty means no machine may call anything. A value below 32 characters
# is treated as unset — and every scheduled job is then refused with a 401,
# which the Cloud Function logs as an error naming this variable.
SERVICE_KEY_REPORTING=

# ── Partner registration service credential ──────────────────────────────────
# The standing key the two Firestore onboarding triggers
# (`registerAgencyPartner` / `registerSellerPartner`) present as `X-Service-Key`
# to register a newly created agency or coin seller with the API.
#
# It unlocks exactly one operation — partner.register — and therefore exactly
# one route, POST /api/partner-ops/partners. That route creates the business
# record holding NOTHING: zero coins, zero credit, zero commission, zero cash,
# status pending, inactive. Approval stays a human decision and every /execute
# and /approve still requires an owner's signature.
#
# A THIRD, DIFFERENT VALUE from the two above, deliberately. This key is held
# by a trigger that fires on every public signup — the most frequently
# exercised machine path in the system — so it must not be able to accrue
# commission or email a business-wide figure. Never reuse either other value.
#
# Generate with:
#   python3 -m scripts.generate_service_key --credential partner-registration
# In production it comes from Secret Manager as a Cloud Run environment
# variable and is never written to a file. See DEPLOYMENT.md § 10.
#
# LEAVE THIS EMPTY LOCALLY unless you are deliberately testing the machine
# path. Empty means no machine may call anything — and a new agency or seller
# then exists in Firestore, invisible to every staff screen, until somebody
# runs `python -m scripts.backfill_partners --confirm`. That is the bug this
# credential exists to stop, so do not skip it in production.
#
# The SAME VALUE is given to the Cloud Functions runtime as
# ZIPPER_PARTNER_REGISTRATION_KEY. Two secrets, one value — the two runtimes
# bind secrets differently and nothing keeps them in step but you. Rotating
# one side alone makes every registration fail with a 401, which the trigger
# writes onto the applicant's Firestore document. See DEPLOYMENT.md § 10.
SERVICE_KEY_PARTNER_REGISTRATION=

# ── The business day ─────────────────────────────────────────────────────────
# Which calendar the scheduled reports are cut in. A "daily" report covers
# 00:00–24:00 in this zone, not [00:00 UTC, 24:00 UTC) — at UTC+05:30 those are
# five and a half hours apart, and the difference is the whole of the previous
# evening. The ledger is still stored and queried in UTC; this decides only
# where the day, week and month are cut, and every report prints the bounds it
# used. The on-demand /api/reports/* endpoints are unaffected.
#
# The Cloud Scheduler jobs in functions/src/index.ts fire on this same zone.
# Change both, or a report will arrive at the wrong hour for the day it covers.
REPORT_TIMEZONE=Asia/Kolkata
