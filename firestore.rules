rules_version = '2';
// Deployed copy: comment lines inside the service block removed to fit Firebase's 256 KB limit;
// the fully annotated copy, identical rules, is docs/firestore.rules.annotated.

// ════════════════════════════════════════════════════════════════════════════
// ZIPPER FIRESTORE RULES — RELEASE CANDIDATE 2 ("rules RC2", 2026-11-01)
// ════════════════════════════════════════════════════════════════════════════
//
// Lineage: DEPLOYED text 17b8ffee… (ruleset b2104a12…, released 20 Oct 2026)
//   → Owner-MFA candidate 93453763… (zipper-release/mfa-release-rc2-…/candidate)
//   → working-tree P1-A1 / P1-D / P1-E hunks (26dac8f5…)
//   → hotfix-1 hunks ported from hotfix/rules-20261101/ (deployable alone)
//   → this file. The full diff against DEPLOYED and against hotfix-1, and the
//   ordered deploy plan, are in hotfix/rules-20261101/RC2-DIFF.md.
//
// Tests: tests/firestore.rc2.rules.test.mjs (+ every older suite) through
// tests/run-rc2-rules-tests.command. Emulator only, demo project, no deploy.
//
// EVERY CHANGE SINCE 17b8ffee, WITH WHAT IT DEPENDS ON. "none" = the rule can
// be released on its own without breaking a live client. Deploy this file ONLY
// when every "needs" below is already live; see RC2-DIFF.md for the order.
//
// ── A. Owner MFA boundary (P1-A3b / P1-A3, from the MFA candidate) ──────────
//   A1 crmRole(): an Owner (`superadmin`) reads as 'superadmin_mfa_pending'
//      unless ownerMfaOk() — a backend-minted custom-token session whose
//      ownerMfaSessions/{uid}.bindings[mfa_sid] is active, matches auth_time
//      and is unexpired. hasPerm() refuses the pending role explicitly.
//        needs: backend rc2 key revision (owner_mfa routes, OWNER_MFA_ENCRYPTION_KEY)
//               serving 100% AND the MFA CRM (replaces the Owner's Firebase
//               sign-in after TOTP) live. Deployed earlier, every Owner is
//               locked out of every staff grant.
//   A2 ownerMfaSessions/{uid}: deny-all for clients.           needs: none.
//   A3 crmUsers update: the Owner first-login `gateAnswers` arm is removed and
//      `gateAnswers` joins the refused key list.                needs: MFA CRM
//      (the old CRM's /login gate writes gateAnswers and would stall).
//
// ── B. Hotfix-1 hunks (hotfix/rules-20261101, deployable before RC2) ────────
//   B1 A-1 ownerContactWriteOk(): an EMPTY email/phoneNumber written over an
//      absent/empty one is "no change" (pre-19 app builds).     needs: none.
//   B2 R-3 calls/{id} and callHistory/{id}: `allow write: if false` (Functions
//      write them with the Admin SDK; `isAdmin()` is spelling-based). needs: none.
//   B3 A-5 appConfig/androidUpdate: no client writer (publish_apk.py only).
//                                                               needs: none.
//   B4 R-2 coinPurchaseRequests list: a partner lists only queries constrained
//      to its own seller record; admin/finance unchanged.       needs: none
//      (the seller dashboard already filters on sellerUid).
//   B5 R-5 techTickets read: isStaff() (partners refused) — superseded by C2
//      for writes.                                              needs: none.
//
// ── C. Working-tree hunks (P1-A1 / P1-D / P1-E) ─────────────────────────────
//   C1 staffRoster/{uid}: staff read, no client write; crmUsers read narrowed
//      to self / Owner / same-department admin for a member (callerDept()).
//        needs: backend roster backfill (`crm_directory.write_roster`) run
//               AND the staffRoster(role, isActive) index deployed, AND the
//               CRM that reads names from staffRoster (commit 64f9974).
//   C2 techTickets: create/update `if false`; read isStaff(); delete Owner.
//        needs: backend tickets API (`backend/app/routers/tickets.py`,
//               POST /tickets/team, /tickets/{kind}/{id}/update,
//               /tickets/support/{id}/route) live AND the CRM calling it
//               (lib/tech.ts, lib/operations.ts in commit 64f9974).
//   C3 feedbackTickets / supportTickets: an app user creates in its own name
//      and reads its own; staff (ops / admins / support) read; staff UPDATE
//      only through the tickets API (POST /tickets/{feedback|support}/{id}/
//      update — CRM lib/operations.ts, APK-20 work hub), so client
//      update/delete is `if false`.                             needs: as C2.
//
// ── D. This release (item 5 of the RC2 brief + audit §2) ────────────────────
//   D1 weeklyPayoutReports/{reportId}/hostPayouts/{payoutId}: read for Finance
//      and admins and for the report's agency owner on its own rows (the
//      caller's crmUsers.agencyId == the row's `agencyId` — the generator
//      writes agencyId + hostUid, never agencyOwnerUid); nobody else; write
//      `if false` (weeklyPayoutReportGenerator, Admin SDK).
//        needs: none (the CRM's finance.ts already reads this path and falls
//               back silently; this rule makes the read succeed).
//   D2 top-level hostPayouts: the agency `agencyOwnerUid` update arm (any
//      field) is closed — R-11; nothing writes this legacy path. needs: none.
//   D3 salaryRequests update: Finance/Owner may also write the actor key
//      `approvedBy` (the key Client.tsx's C-8 note names and lib/finance.ts /
//      lib/coinPurchases.ts already write), only as their own uid.
//        needs: none (the old write without it still passes; the CRM can
//               start writing it whenever it ships).
//   D4 users: `banScope`, `banCategory`, `banEvidence`, `payoutHoldReason`,
//      `payoutHoldAt` join ownerProtectedFields() and staffProtectedFields()
//      (`credentialsValidAfter` already was). Backend writes them (Admin SDK).
//                                                               needs: none.
//   D5 users: `gender` is set once — the owner arm refuses a change once a
//      non-empty value is stored (A-10; Edit Profile shows it locked).
//                                                               needs: none.
//   D6 notifications/{id}: read by the addressee only; no client write
//      (backend notices.py and Functions write them).           needs: none
//      (no CRM or app code writes or admin-reads this collection).
//   D7 R-6 appConfig/paymentCredentials: readable by staff, by a CRM seller
//      with a started seller role, and by an app seller with a verified
//      contact and a started seller record — never by a guest or an ordinary
//      user. Every other appConfig document reads as before.   needs: none
//      (BuyCoinScreen and the CRM BuyInventoryDialog are the only readers).
//   D8 R-8 hostKyc/{hostUid}: read by admins and the host only.  needs: none.
//   D9 R-10 users/{uid}/followers/{followerUid}: the follower writes its own
//      row; users/{uid}/giftsReceived create `if false`.         needs: none
//      (ProfileRepository writes followers/{me}; nothing writes giftsReceived).
//   D10 appConfig/luckyGifts: confirmed covered by the existing appConfig rule
//      (signed-in read; Tech + Owner write). No change — but see D15.
//   D11 publicProfiles: no change (the projection omits hostLevel for non-hosts
//      server-side).
//   D12 rateLimits/{bucket}: explicit deny-all (functions/src/rateLimit.ts,
//      Admin SDK). Same answer as the catch-all, stated.        needs: none.
//   D13 partyRooms/{roomId}/private/{docId}: explicit deny-all — the room PIN
//      secret functions/src/party.ts keeps at private/secret. No rule ever
//      admitted it (the catch-all denies); stated.              needs: none.
//   D14 §5 Host role suspension: users `hostSuspended` / `hostSuspendedUntil` /
//      `hostSuspendedReason` / `hostSuspensionDays` / `hostStatusBeforeSuspension`
//      and the `hostSuspended*` / `hostResumed*` stamps on both protected
//      lists; liveRooms `mayGoLive()` refuses a suspended Host role.
//                                    needs: backend users.suspend_host / resume_host.
//   D15 appConfig/luckyGifts.enabled (the lucky-gift switch, off until legal
//      clearance): Owner only. A Tech write to luckyGifts may not add, change
//      or remove `enabled`; a delete of luckyGifts is the Owner's. Other
//      appConfig documents unchanged.   needs: Functions settleGift
//      LUCKY_GIFTS_DISABLED + the CRM page's Owner-only toggle (Tech saves
//      merge without `enabled`).
//
// ── E. Track B (3 Nov 2026) ──────────────────────────────────────────────────
//   E1 gameMatches/{matchId}: read by any signed-in account (lobby, spectators);
//      write `if false` (functions/src/games, Admin SDK). gameMatches/{id}/
//      private/{doc} (seed, invite code): deny-all.             needs: none.
//   E2 users/{uid}/gameHistory/{matchId}: the owner, Finance and admins read;
//      write `if false`.                                         needs: none.
//   E3 gameLedger, gameIdempotency, promoCredits: deny-all, stated (the CRM
//      reads through the API).                                   needs: none.
//   E4 appConfig/games (every game's switch, entries, fee): Owner-only write,
//      the whole document. Read as every other appConfig document.
//                                    needs: the CRM Games page (Owner).
//   E5 partyRooms/{roomId}/admitted/{uid} (who a private room let in): no rule
//      — the catch-all denies; written by joinPartyRoom (Admin SDK). needs: none.
//   E7 partyRooms/{roomId}/accessLog: the room's owner and staff read; no
//      writes. pinMisses: deny-all. partySubscriptions/{uid}: the holder and
//      staff read; no writes. subscriptionPayments, subscriptionIdempotency:
//      deny-all. appConfig/partySubscription: Owner-only write.
//                                    needs: Functions joinPartyRoom (B7),
//                                    subscribePrivateRooms & co.
//   E6 leaderboards/{board_period_key} and its entries/{uid}: read by any
//      signed-in account; written only by settleGift / call billing (Admin
//      SDK). leaderboardSettlements: Owner and Finance read; no writes.
//      appConfig/leaderboards (reward tiers): Owner-only write.
//                                    needs: Functions settleLeaderboards.
//   E8 (B12, 4 Nov 2026) liveRooms: created live, empty and unpaid; the host
//      may change only `hostLiveFields()` (no totals, peak, server marks or PK
//      fields but `pkWaiting`; heartbeat/pause marks = request.time; pinned
//      ≤ 140; an ended room stays ended); viewers move `viewerCount` by ±1 and
//      `likeCount` by +1 only. comments: the writer's own uid, 1–300 chars,
//      not muted (`mutedViewers`) or blocked by the host; the host may delete.
//      viewers/{uid}: not blocked by the host. pkInvites: no client writes.
//                                    needs: Functions liveViewerCount,
//                                    sweepLiveRooms, pkMatch/pkRespond/pkEnd,
//                                    settleGift (B12) + the B12 app (heart-
//                                    beat, PK via callables, no client PK
//                                    score, no client viewerCount increments).
//
// ── Indexes (firestore.indexes.json, additive; never accept a deletion) ─────
//   staffRoster(role, isActive) — needed by C1. The Owner work hub (APK ≥ 20)
//   needs salaryRequests / hostApplications / supportTickets / techTickets
//   (status ASC, createdAt DESC). Also in the file: three publicProfiles feed
//   indexes (isListed, [country,] isVerifiedHost, [languageCodes CONTAINS,]
//   presenceRank DESC, lastSeen DESC) for DiscoverRepository.feed's filter
//   combinations. Deploy indexes BEFORE (or with) this file and let them
//   reach READY before the C1 CRM pickers are used.
//
// ── Storage (storage.rules, same release) ───────────────────────────────────
//   Owner `role` claim gated by ownerMfaOk() through a cross-service Firestore
//   read — needs the Storage service agent granted
//   roles/firebaserules.firestoreServiceAgent BEFORE the Storage deploy, or
//   every Owner Storage request fails closed. profileMedia images 15 MB (B).
//
// NOT in RC2: hotfix-1's withheld C-1 (self-signup logins born inactive) —
// the CRM in this tree still writes `isActive: true` (lib/auth.ts
// createAgencyAccount / createSellerAccount / createSubAgencyAccount) and
// signs out inactive logins, so the hunk would break live self-signup.
// R-1 (users/{uid} get for any signed-in account) needs the publicProfiles
// migration in the app first. R-7 (public KYC signup prefixes) is a Storage
// item, documented there.
// ════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * ── A DEACTIVATED ACCOUNT IS NOT A CRM USER ──────────────────────────────
     *
     * `isActive` is checked HERE rather than at each call site, because every
     * other role helper in this file is built on this one — `isStaff`,
     * `isAdmin`, `isOps`, `isFinance`, `isTech`, `isAgencyCrmUser`,
     * `isSellerCrmUser` all begin with `isCrmUser()`. One place to say it, and
     * no clause anywhere can forget.
     *
     * Before this, nothing in these rules read `isActive` at all. Revoking
     * somebody set `staff.is_active = false` in Mongo, `crmUsers.isActive =
     * false` in Firestore and disabled their Firebase login — and the first two
     * were only ever checked by the API and by `resolveCrmUser` in the browser.
     * A revoked person driving the Firebase SDK directly kept full staff rights
     * in Firestore for as long as their ID token lived, and indefinitely if the
     * Firebase disable had failed — which is an outcome the code reports and
     * audits rather than prevents (`staff.firebase_revoke_failed`).
     *
     * Absent reads as ACTIVE, deliberately. Documents written before this field
     * existed have no `isActive`, and defaulting those to inactive would lock
     * out every long-standing account at once.
     */
    function isCrmUser() {
      return request.auth != null
          && exists(/databases/$(database)/documents/crmUsers/$(request.auth.uid))
          && get(/databases/$(database)/documents/crmUsers/$(request.auth.uid))
               .data.get('isActive', true) != false;
    }

    function crmRole() {
      let r = get(/databases/$(database)/documents/crmUsers/$(request.auth.uid)).data.get('role', '');
      return (r != 'superadmin' || ownerMfaOk()) ? r : 'superadmin_mfa_pending';
    }

    function ownerMfaOk() {
      let sid = request.auth.token.get('mfa_sid', '');
      let p = /databases/$(database)/documents/ownerMfaSessions/$(request.auth.uid);
      return sid is string && sid != ''
          && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'custom'
          && exists(p)
          && ownerMfaBindingLive(get(p).data.get('bindings', {}).get(sid, {}));
    }

    function ownerMfaBindingLive(b) {
      return b.get('state', '') == 'active'
          && b.get('authTime', -1) == request.auth.token.get('auth_time', -2)
          && b.get('expiresAt', timestamp.value(0)) > request.time;
    }

    function isAgencyCrmUser() {
      return isCrmUser()
          && (crmRole() == 'agency'
              || 'agency' in get(/databases/$(database)/documents/crmUsers/$(request.auth.uid))
                               .data.get('roles', []))
          && agencyRoleLive();
    }

    function agencyRoleLive() {
      return !(get(/databases/$(database)/documents/crmUsers/$(request.auth.uid))
                 .data.get('roleStatus', {}).get('agency', '')
               in ['revoked', 'suspended', 'rejected'])
          && get(/databases/$(database)/documents/crmUsers/$(request.auth.uid))
               .data.get('roleStatus', {}).get('agency', '') in ['', 'approved', 'pending'];
    }

    function sellerRoleLive() {
      return get(/databases/$(database)/documents/crmUsers/$(request.auth.uid))
               .data.get('roleStatus', {}).get('seller', '') in ['', 'approved', 'pending'];
    }
    function sellerRecordNotWithdrawn(sellerId) {
      return !exists(/databases/$(database)/documents/sellers/$(sellerId))
          || !(get(/databases/$(database)/documents/sellers/$(sellerId))
                 .data.get('status', '') in ['revoked', 'suspended', 'rejected']);
    }

    function agencyRoleApproved() {
      let c = get(/databases/$(database)/documents/crmUsers/$(request.auth.uid)).data;
      let rs = c.get('roleStatus', {}).get('agency', '');
      return rs == 'approved'
          || (rs == '' && c.get('role', '') == 'agency' && c.get('status', '') == 'approved');
    }
    function sellerRoleApproved() {
      let c = get(/databases/$(database)/documents/crmUsers/$(request.auth.uid)).data;
      let rs = c.get('roleStatus', {}).get('seller', '');
      return rs == 'approved'
          || (rs == '' && c.get('role', '') == 'seller' && c.get('status', '') == 'approved');
    }
    function sellerRecordApproved(sellerId) {
      return sellerId is string && sellerId != ''
          && exists(/databases/$(database)/documents/sellers/$(sellerId))
          && (get(/databases/$(database)/documents/sellers/$(sellerId)).data.get('status', '') == 'approved'
              || (get(/databases/$(database)/documents/sellers/$(sellerId)).data.get('status', '') == ''
                  && get(/databases/$(database)/documents/sellers/$(sellerId)).data.get('isApproved', false) == true));
    }
    function appSellerRecordStarted() {
      return sellerRecordApproved(request.auth.uid)
          || (exists(/databases/$(database)/documents/crmUsers/$(request.auth.uid))
              && sellerRoleApproved()
              && appSellerOwnsNamedRecord(
                   get(/databases/$(database)/documents/crmUsers/$(request.auth.uid)).data.get('sellerId', '')));
    }
    function appSellerOwnsNamedRecord(sellerId) {
      return sellerRecordApproved(sellerId)
          && (get(/databases/$(database)/documents/sellers/$(sellerId)).data.get('crmUid', '') == request.auth.uid
              || get(/databases/$(database)/documents/sellers/$(sellerId)).data.get('ownerUid', '') == request.auth.uid);
    }

    function crmLoginUnrestricted() {
      return get(/databases/$(database)/documents/crmUsers/$(request.auth.uid))
               .data.get('accountRestricted', false) != true;
    }

    function isAgencyCrmWriter() {
      return isAgencyCrmUser() && crmLoginUnrestricted();
    }

    function crmUserAgencyId() {
      return get(/databases/$(database)/documents/crmUsers/$(request.auth.uid)).data.get('agencyId', '');
    }

    function isSuperAdmin() {
      return isCrmUser() && crmRole() == 'superadmin';
    }

    function isAdmin() {
      return isCrmUser() && (crmRole() in ['superadmin', 'admin'] || crmRole().matches('.*_admin'));
    }

    function isApp() {
      return isCrmUser() && crmRole() in ['superadmin', 'admin', 'app', 'app_admin', 'app_member'];
    }

    function isOps() {
      return isCrmUser() && crmRole() in ['superadmin', 'admin', 'ops', 'ops_admin', 'ops_member'];
    }

    function isTech() {
      return isCrmUser() && crmRole() in ['superadmin', 'admin', 'tech', 'tech_admin', 'tech_member'];
    }

    function isFinance() {
      return isCrmUser() && crmRole() in ['superadmin', 'admin', 'finance', 'finance_admin', 'finance_member'];
    }

    function isSupport() {
      return isCrmUser() && crmRole() in ['superadmin', 'admin', 'support', 'support_admin', 'support_member'];
    }

    function isMarketing() {
      return isCrmUser() && crmRole() in ['superadmin', 'marketing_admin', 'marketing_member'];
    }

    function isStaff() {
      return isCrmUser() && crmRole() in [
        'superadmin', 'admin',
        'app_admin',     'app_member',
        'ops_admin',     'ops_member',
        'finance_admin', 'finance_member',
        'tech_admin',    'tech_member',
        'support_admin', 'support_member',
        'marketing_admin', 'marketing_member',
        'ops', 'tech', 'finance', 'support'
      ];
    }

    function crmPermissions() {
      return get(/databases/$(database)/documents/crmUsers/$(request.auth.uid))
               .data.get('permissions', []);
    }

    function hasPerm(p) {
      return isCrmUser()
          && crmRole() != 'superadmin_mfa_pending'
          && (crmRole() == 'superadmin' || p in crmPermissions());
    }

    function canDecideCoinOps() {
      return isSuperAdmin()
          || (hasPerm('can_coin_operations') && crmRole() == 'finance_admin');
    }

    function payoutFields() {
      return [
        'accountHolderName', 'accountNumber', 'bankAccount', 'ifscCode',
        'bankName', 'branch', 'upiId', 'binanceUid', 'paymentType', 'currency',
      ];
    }
    function identityFields() {
      return [
        'kycDocUrls', 'idDocUrls', 'dob', 'country', 'address',
        'agencyName', 'displayName', 'hostName', 'ownerName',
        'phone', 'applicantPhone', 'ownerPhone',
        'email', 'applicantEmail', 'ownerEmail',
      ];
    }
    function reapprovalFields() {
      return payoutFields().concat(identityFields());
    }
    /** True when this write touches nothing that needs re-approval. */
    function touchesNoSensitiveField() {
      return !request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(reapprovalFields());
    }
    /**
     * A partner proposing a change: the pending block moves, live fields do
     * not. `kycStatus` moves with it so the dashboard can say "with a
     * reviewer", but it is not what the queue keys off.
     */
    function proposesChangeOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['pendingChanges', 'kycStatus', 'kycSubmittedAt'])
          && request.resource.data.get('kycStatus', '') == 'submitted'
          && proposalIsWellFormed();
    }

    /**
     * What may be INSIDE a proposal.
     *
     * Constraining the key and not the contents would have been a hole rather
     * than a control: `pendingChanges` was writable by the partner, so a seller
     * could park `{coinBalance: 999999}` or `{status: 'approved'}` in it, and a
     * reviewer clicking "apply" on what looked like a bank-account change would
     * have minted coin inventory. The applying services keep their own
     * allow-list — they are the authority, and they refuse anything outside it
     * — but a proposal that cannot be written is better than one that is merely
     * refused later, because nothing misleading ever reaches a reviewer's
     * screen.
     *
     * A proposal with no `fields` map at all is also refused: it would render
     * as an empty review with nothing to decide.
     */
    function proposalIsWellFormed() {
      return request.resource.data.pendingChanges.keys()
               .hasOnly(['fields', 'submittedAt', 'submittedBy', 'note', 'previousKycStatus'])
          && request.resource.data.pendingChanges.keys().hasAll(['fields'])
          && request.resource.data.pendingChanges.fields.keys()
               .hasOnly(reapprovalFields());
    }

    function isAppUser() {
      return request.auth != null;
    }

    function hasContactIdentity() {
      return request.auth != null
          && (request.auth.token.get('phone_number', '') != ''
              || tokenEmailVerified());
    }

    function tokenEmailVerified() {
      return request.auth != null
          && request.auth.token.get('email_verified', false) == true
          && request.auth.token.get('email', '') != '';
    }

    function namesOnlyCaller(field) {
      return request.resource.data.get(field, '') == ''
          || (request.auth != null && request.resource.data.get(field, '') == request.auth.uid);
    }
    function adminPartnerEditSafe() {
      return !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['ownerUid', 'secondRoleOwnerUid', 'status', 'isActive',
                         'isApproved', 'approvedBy', 'approvedAt',
                         'referralCode', 'coinBalance', 'totalCoinsSold',
                         'parentAgencyId', 'type', 'kycStatus', 'commissionRate',
                         'createdByUid'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['crmUid'])
              || resource.data.get('crmUid', '') == '');
    }
    function staffPaymentEditAllowed() {
      return !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(payoutFields().concat(['payment', 'qrCodeUrl']))
          || isSuperAdmin();
    }
    function partnerCreateSafe() {
      return request.resource.data.get('status', 'pending') == 'pending'
          && request.resource.data.get('isActive', false) == false
          && request.resource.data.get('isApproved', false) == false
          && namesOnlyCaller('ownerUid')
          && namesOnlyCaller('crmUid')
          && namesOnlyCaller('secondRoleOwnerUid')
          && namesOnlyCaller('createdByUid');
    }

    function notBanned() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null
             && u.get('isBanned', false) != true
             && u.get('isSuspended', false) != true
             && u.get('isDeleted', false) != true
             && !(u.get('accountState', 'active')
                    in ['suspended', 'banned', 'recovery_pending', 'permanently_deactivated']);
    }

    function sessionCurrent() {
      return request.auth != null
             && request.auth.token.auth_time >=
                get(/databases/$(database)/documents/users/$(request.auth.uid))
                  .data.get('credentialsValidAfter', 0);
    }

    /**
     * A signed-in app user who is not banned and holds the current session.
     *
     * The ordinary write gate. Both halves read the SAME document, so this is
     * one distinct document access, not two — Firestore bills distinct paths.
     */
    function isActiveAppUser() {
      return isAppUser() && notBanned() && sessionCurrent();
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function callerDept() {
      return get(/databases/$(database)/documents/crmUsers/$(request.auth.uid)).data.get('dept', '');
    }

    function partnerSelfRegistration(uid) {
      return request.auth != null
          && request.auth.uid == uid
          && request.resource.data.get('status', '') == 'pending'
          && !exists(/databases/$(database)/documents/crmUsers/$(request.auth.uid));
    }

    function agencyNamesCaller(agencyId) {
      return exists(/databases/$(database)/documents/agencies/$(agencyId))
          && get(/databases/$(database)/documents/agencies/$(agencyId))
               .data.get('ownerEmail', '') == request.auth.token.email
          && ((get(/databases/$(database)/documents/agencies/$(agencyId))
                 .data.get('source', '') == 'self_signup'
               && tokenEmailVerified())
              || (get(/databases/$(database)/documents/agencies/$(agencyId))
                    .data.get('source', '') == 'agency_created'
                  && subAgencyMadeByItsParent(agencyId)));
    }

    function subAgencyMadeByItsParent(agencyId) {
      let a = get(/databases/$(database)/documents/agencies/$(agencyId)).data;
      let c = get(/databases/$(database)/documents/crmUsers/$(a.get('createdByUid', 'none'))).data;
      return a.get('type', '') == 'sub'
          && a.get('parentAgencyId', null) is string
          && a.get('parentAgencyId', '') != ''
          && a.get('createdByUid', '') != ''
          && c.get('agencyId', '') == a.get('parentAgencyId', '')
          && c.get('isActive', true) != false
          && (c.get('role', '') == 'agency' || 'agency' in c.get('roles', []))
          && (c.get('roleStatus', {}).get('agency', '') == 'approved'
              || (c.get('roleStatus', {}).get('agency', '') == ''
                  && c.get('role', '') == 'agency' && c.get('status', '') == 'approved'));
    }

    function ownAgencyIsMain() {
      let own = get(/databases/$(database)/documents/agencies/$(crmUserAgencyId())).data;
      let parent = own.get('parentAgencyId', null);
      return own.get('type', 'main').trim().lower() != 'sub'
          && (parent == null || parent == '');
    }

    function createsMainAgency() {
      let parent = request.resource.data.get('parentAgencyId', null);
      return request.resource.data.get('type', 'main') == 'main'
          && (parent == null || parent == '');
    }

    function sellerNamesCaller(sellerId) {
      return exists(/databases/$(database)/documents/sellers/$(sellerId))
          && get(/databases/$(database)/documents/sellers/$(sellerId))
               .data.get('email', '') == request.auth.token.email
          && tokenEmailVerified();
    }

    function agencySecondRoleNamesCaller(agencyId) {
      return agencyId is string
          && agencyId != ''
          && exists(/databases/$(database)/documents/agencies/$(agencyId))
          && get(/databases/$(database)/documents/agencies/$(agencyId))
               .data.get('secondRoleOwnerUid', '') == request.auth.uid;
    }

    function sellerSecondRoleNamesCaller(sellerId) {
      return sellerId is string
          && sellerId != ''
          && exists(/databases/$(database)/documents/sellers/$(sellerId))
          && get(/databases/$(database)/documents/sellers/$(sellerId))
               .data.get('secondRoleOwnerUid', '') == request.auth.uid;
    }

    function unlinked(value) {
      return value == '' || value == null;
    }

    match /bannedDevices/{deviceId} {
      /*
       * Readable by one document id at a time, not as a list.
       *
       * This was `allow read: if true` — unauthenticated, and `get` and `list`
       * are the same permission in Firestore, so the entire ban list was
       * enumerable by anybody who could reach the project. That is a register
       * of who has been thrown off the platform.
       *
       * The app still has to ask "is THIS device banned?" before anybody signs
       * in, and at that moment there is no auth token to check — so the single
       * document read stays open. `request.auth == null || request.auth != null`
       * cannot express "get but not list", so the list is closed by requiring
       * staff for any query, below.
       */
      allow get:   if true;
      allow list:  if isOps();
      /*
       * GOV C6 (B30): SERVER-ONLY. This was `isOps()`, so any ops login —
       * `ops_member` included — could bar or free any handset from a browser
       * console, with no reason, no audit entry and no named actor, and could
       * delete a `manualBan` that only `POST /users/devices/bans/{id}/unban`
       * is meant to lift. Every legitimate writer runs through the Admin SDK,
       * which these rules do not govern: the ban cascade in
       * `services/users.ban_user`, `barDevice` in functions/src/identity.ts,
       * and the CRM's manual ban/unban, which calls
       * `POST /users/devices/bans` and `POST /users/devices/bans/{id}/unban`
       * (zipper-crm/lib/operations.ts, app/operations/bans).
       */
      allow write: if false;
    }

    /*
     * QUICK-LOGIN TOKENS — server-only, in both directions.
     *
     * Each document id is `sha256(secret)` and the document names a uid. That
     * makes the collection a list of keys to accounts, so:
     *
     *   * READ is closed to everyone including the owner. A client that could
     *     read it could enumerate uids, and a client that could read its own
     *     row learns nothing it does not already hold.
     *   * WRITE is closed because a client that could write one could issue
     *     itself a key to any account by naming any uid.
     *
     * `mintQuickLoginToken`, `redeemQuickLogin` and `revokeQuickLogin` use the
     * Admin SDK, which is not subject to these rules. Not even ops gets a hand
     * here — there is nothing an operator could usefully do with a credential
     * store, and plenty they could do by accident.
     */
    match /quickLoginTokens/{tokenHash} {
      allow read, write: if false;
    }

    match /quickLoginChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /quickLoginRate/{bindingHash} {
      allow read, write: if false;
    }

    match /emailOtpChallenges/{uid} {
      allow read, write: if false;
    }
    match /emailOtpRate/{key} {
      allow read, write: if false;
    }

    match /rateLimits/{bucket} {
      allow read, write: if false;
    }

    match /authEvents/{eventId} {
      allow read:  if isStaff();
      allow write: if false;
    }

    /*
     * WHICH GUEST ACCOUNT BELONGS TO WHICH DEVICE.
     *
     * Closed to everybody, and this one has to be. The document holds the uid
     * of a guest account keyed by a device id, so `list` access would be a
     * ready-made map from device to account; and `write` access would let a
     * client point its own device id at somebody else's guest uid, or replace
     * the secret hash guarding its own. `claimGuestIdentity` is the only thing
     * that touches this, through the Admin SDK, which these rules do not apply
     * to.
     *
     * Not readable by staff either. A device id is not a support tool — nobody
     * in the CRM has a reason to resolve one to an account, and the ban list
     * already shows the device side of it.
     */
    match /guestDeviceBindings/{deviceId} {
      allow read, write: if false;
    }
    match /guestUidBindings/{uid} {
      allow read, write: if false;
    }

    /*
     * The record of "these two accounts were the same person, this one was
     * kept". Written by `resolveIdentityConflict`; read by staff when somebody
     * asks why their old account vanished.
     */
    match /identityResolutions/{id} {
      allow read:  if isStaff();
      allow write: if false;
    }

    match /verifiedIdentities/{docId} {
      allow read:  if isStaff();
      allow write: if isStaff();
    }

    match /ownerMfaSessions/{uid} {
      allow read, write: if false;
    }

    match /staffRoster/{uid} {
      allow read:  if isStaff();
      allow write: if false;
    }

    match /contactVerifications/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isStaff());
      allow write: if false;
    }

    match /crmUsers/{uid} {
      allow read:   if isOwner(uid)
                    || isSuperAdmin()
                    || (isAdmin()
                        && resource.data.get('dept', '') != ''
                        && resource.data.get('dept', '') == callerDept()
                        && resource.data.get('role', '').matches('.*_member'));

      /*
       * Phase 1A (STAFF-001/002/003, SECURITY-004). An Owner's browser is no
       * longer an unconditional writer of this collection:
       *
       *   * it cannot CREATE an Owner (`superadmin`) or any internal role —
       *     only the Observer provisions Owners, through POST /staff/owners;
       *     staff and department roles are made by POST /staff;
       *   * it cannot touch another Owner's document at all, nor change its
       *     own role;
       *   * it cannot write role, roles, roleStatus, permissions, isActive or
       *     the partner links on anybody — authority changes are API calls
       *     (change_role / deactivate / partner-ops), audited, with the
       *     last-Owner guard and session revocation;
       *   * it never deletes one (deactivation keeps history attributable).
       *
       * What remains is the admin-mode partner LOGIN creation in
       * lib/auth.ts (role agency/seller, for a uid that has no document yet —
       * so never a staff account) and cosmetic edits on non-Owner documents.
       */
      allow create: if (isSuperAdmin()
                        && uid != request.auth.uid
                        && request.resource.data.get('role', '') in ['agency', 'seller']
                        && !('superadmin' in request.resource.data.get('roles', []))
                        && request.resource.data.get('status', 'pending') == 'pending'
                        && !request.resource.data.keys().hasAny(['roles', 'roleStatus']))
                    || (partnerSelfRegistration(uid)
                        && request.resource.data.role == 'agency'
                        && request.resource.data.get('createdBy', '')
                             in ['self_signup', 'agency_created']
                        && !request.resource.data.keys().hasAny(['roles', 'roleStatus', 'secondRoleOwnerUid'])
                        && unlinked(request.resource.data.get('sellerId', ''))
                        && agencyNamesCaller(request.resource.data.agencyId))
                    || (partnerSelfRegistration(uid)
                        && request.resource.data.role == 'seller'
                        && request.resource.data.get('createdBy', '') == 'self_signup'
                        && !request.resource.data.keys().hasAny(['roles', 'roleStatus', 'secondRoleOwnerUid'])
                        && unlinked(request.resource.data.get('agencyId', ''))
                        && sellerNamesCaller(request.resource.data.sellerId));

      allow update: if (isSuperAdmin()
                        && uid != request.auth.uid
                        && resource.data.get('role', '') != 'superadmin'
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['role', 'roles', 'roleStatus', 'permissions',
                                       'isActive', 'status', 'agencyId', 'sellerId',
                                       'dept', 'team', 'uid', 'email',
                                       'accountRestricted', 'gateAnswers']))
                    || (isCrmUser() && request.auth.uid == uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['lastLoginAt']))
                    || (isOwner(uid)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['displayName', 'phone', 'personalEmail',
                                       'address', 'photoUrl']))
                    || (isOwner(uid)
                        && resource.data.get('accountRestricted', false) != true
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['roles', 'roleStatus', 'sellerId'])
                        && request.resource.data.get('roles', []).hasOnly(['agency', 'seller'])
                        && request.resource.data.get('roleStatus', {}).get('seller', '') == 'pending'
                        && request.resource.data.get('roleStatus', {})
                             .diff(resource.data.get('roleStatus', {})).affectedKeys().hasOnly(['seller'])
                        && unlinked(resource.data.get('sellerId', ''))
                        && sellerSecondRoleNamesCaller(request.resource.data.get('sellerId', '')))
                    || (isOwner(uid)
                        && resource.data.get('accountRestricted', false) != true
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['roles', 'roleStatus', 'agencyId'])
                        && request.resource.data.get('roles', []).hasOnly(['agency', 'seller'])
                        && request.resource.data.get('roleStatus', {}).get('agency', '') == 'pending'
                        && request.resource.data.get('roleStatus', {})
                             .diff(resource.data.get('roleStatus', {})).affectedKeys().hasOnly(['agency'])
                        && unlinked(resource.data.get('agencyId', ''))
                        && agencySecondRoleNamesCaller(request.resource.data.get('agencyId', '')));
      allow delete: if false;   // Phase 1A: deactivation via the API, never deletion from a browser.
    }

    match /agencies/{agencyId} {
      allow read: if isAdmin()
                  || (isAgencyCrmUser()
                      && (crmUserAgencyId() == agencyId
                          || crmUserAgencyId() == resource.data.get('parentAgencyId', '')))
                  || (request.auth != null
                      && (resource.data.get('ownerUid', '') == request.auth.uid
                          || resource.data.get('parentAgencyId', '') == request.auth.uid))
                  || (tokenEmailVerified()
                      && resource.data.get('ownerEmail', '') == request.auth.token.email);

      allow create: if partnerCreateSafe()
                    && !(request.resource.data.get('source', '') in ['self_app', 'reapply'])
                    && (isStaff()
                        || (isAgencyCrmWriter()
                            && agencyRoleApproved()
                            && request.resource.data.get('type', '') == 'sub'
                            && request.resource.data.get('parentAgencyId', '') == crmUserAgencyId()
                            && ownAgencyIsMain())
                        || (isCrmUser()
                            && crmLoginUnrestricted()
                            && request.resource.data.get('source', '') == 'second_role'
                            && request.resource.data.get('secondRoleOwnerUid', '') == request.auth.uid
                            && request.resource.data.get('crmUid', '') == request.auth.uid
                            && createsMainAgency())
                        || (hasContactIdentity()
                            && request.resource.data.kycStatus == 'pending'
                            && request.resource.data.get('source', '') == 'self_signup'
                            && createsMainAgency()));

      allow update: if (isAdmin() && adminPartnerEditSafe() && staffPaymentEditAllowed())
                    || (isAgencyCrmWriter() && crmUserAgencyId() == agencyId
                        && !request.resource.data.diff(resource.data)
                              .affectedKeys().hasAny(['status', 'approvedBy', 'approvedAt', 'isActive', 'crmUid', 'ownerUid',
                                                      'parentAgencyId', 'type', 'commissionRate',
                                                      'createdByUid'])
                        && (touchesNoSensitiveField()
                            || resource.data.get('status', '') == 'pending'))
                    || (isAgencyCrmWriter() && crmUserAgencyId() == agencyId
                        && proposesChangeOnly())
                    || (isAppUser()
                        && resource.data.get('ownerUid', '') == request.auth.uid
                        && resource.data.get('status', '') == 'pending'
                        && !request.resource.data.diff(resource.data)
                              .affectedKeys().hasAny(['status', 'approvedBy', 'approvedAt', 'crmUid', 'ownerUid',
                                                      'parentAgencyId', 'type', 'commissionRate',
                                                      'createdByUid']))
                    || (tokenEmailVerified()
                        && resource.data.get('ownerEmail', '') == request.auth.token.email
                        && resource.data.get('status', '') == 'pending'
                        && resource.data.get('crmUid', '') == ''
                        && request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly(['crmUid']))
                    || (request.auth != null
                        && resource.data.get('source', '') == 'agency_created'
                        && resource.data.get('status', '') == 'pending'
                        && resource.data.get('crmUid', '') == ''
                        && resource.data.get('ownerEmail', '') != ''
                        && resource.data.get('ownerEmail', '') == request.auth.token.get('email', '')
                        && request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly(['crmUid'])
                        && request.resource.data.get('crmUid', '') == request.auth.uid
                        && isCrmUser()
                        && crmUserAgencyId() == agencyId
                        && crmLoginUnrestricted()
                        && subAgencyMadeByItsParent(agencyId));

      allow delete: if isSuperAdmin();

      match /agencyHosts/{hostUid} {
        allow read: if isAdmin()
                    || (isAgencyCrmUser() && crmUserAgencyId() == agencyId)
                    || (request.auth != null
                        && (get(/databases/$(database)/documents/agencies/$(agencyId)).data.ownerUid
                              == request.auth.uid));
        allow write: if false;
      }

      match /commissionLedger/{entryId} {
        allow read:  if isAdmin()
                     || (isAgencyCrmUser() && crmUserAgencyId() == agencyId)
                     || (request.auth != null
                         && get(/databases/$(database)/documents/agencies/$(agencyId)).data.ownerUid
                              == request.auth.uid);
        allow write: if false;
      }
    }

    match /hostApplications/{docId} {
      allow read:   if isStaff()
                    || (isAgencyCrmUser()
                        && resource.data.get('agencyId', '') == crmUserAgencyId())
                    || (request.auth != null
                        && resource.data.get('activatedByUid', '') == request.auth.uid);
      /*
       * CREATE — an agency INVITATION from the CRM, nothing else.
       *
       * It was `isCrmUser() || isAppUser()`: any signed-in app user could write
       * a host application naming themselves (`applicantUid`) and skip the
       * role table entirely — Host + Agency through the side door. A
       * SELF-application is filed by the API (`submit_host_application`, Admin
       * SDK), which checks eligibility; the app never writes this collection.
       *
       * What a client may still create is an agency's invitation for a person
       * who has not signed in: staff, or an agency login for its OWN agency,
       * pending, unredeemed, naming no applicant. Redemption (`activateHost`)
       * and approval (the API) are server-side and re-check the role table.
       */
      /*
       * Phase 1A (SECURITY-002): the server's decision fields. Only
       * `decide_host_application` (Admin SDK) writes them, and `activateHost`
       * refuses an application whose `decidedByUid` is empty — so no browser,
       * staff or applicant, can manufacture an approval by writing `status`.
       * `agencyId` and `referralCode` are here too: re-pointing an approved
       * invitation at another agency, or forging the code, is the same act.
       */
      function hostDecisionFields() {
        return ['status', 'kycStatus', 'decidedAt', 'decidedBy', 'decidedByUid',
                'decidedByRole', 'decisionReason', 'rejectionReason',
                'isActivated', 'activatedByUid', 'activatedAt', 'applicantUid',
                'agencyId', 'referralCode', 'source'];
      }
      function hostAppDecisionUntouched() {
        return !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(hostDecisionFields());
      }
      function hostAppCodeIsAgencys() {
        let agencyId = request.resource.data.get('agencyId', '');
        return agencyId is string && agencyId != ''
            && exists(/databases/$(database)/documents/agencies/$(agencyId))
            && request.resource.data.get('referralCode', '') ==
                 get(/databases/$(database)/documents/agencies/$(agencyId))
                   .data.get('referralCode', '').upper()
            && request.resource.data.get('referralCode', '') != '';
      }
      allow create: if (isStaff()
                        || (isAgencyCrmWriter()
                            && agencyRoleApproved()
                            && request.resource.data.get('agencyId', '') == crmUserAgencyId()))
                    && hostAppCodeIsAgencys()
                    && !request.resource.data.keys().hasAny([
                         'applicantUid', 'activatedByUid', 'activatedAt',
                         'decidedAt', 'decidedBy', 'decidedByUid', 'decidedByRole',
                         'decisionReason'])
                    && request.resource.data.get('isActivated', false) == false
                    && request.resource.data.get('status', 'pending') == 'pending'
                    && request.resource.data.get('kycStatus', 'submitted') in ['submitted', 'pending'];
      /*
       * Phase 1A (SECURITY-002): the applicant arm is GONE. It let the
       * applicant write `status: 'approved'`, a forged `referralCode`, a
       * different `agencyId` and a new `photoUrl` onto their own application
       * — self-approval. The app never writes this collection (see
       * HostFunctions.kt); a self-application is filed and edited by the API.
       *
       * The admin arms keep their edit rights for notes, call rate and so on,
       * but never the decision fields: deciding goes through
       * POST /users/host-applications/{id}/decision.
       */
      allow update: if (isAdmin() && hostAppDecisionUntouched()
                        && (touchesNoSensitiveField() || isSuperAdmin()))
                    || (isAdmin() && proposesChangeOnly())
                    || (isAgencyCrmWriter()
                        && resource.data.get('agencyId', '') == crmUserAgencyId()
                        && proposesChangeOnly());
                    /*
                     * ── REMOVED: the client-side activation clause ───────────
                     *
                     * It read:
                     *
                     *     || (isAppUser()
                     *         && request.resource.data.diff(resource.data)
                     *              .affectedKeys().hasOnly(['isActivated','activatedByUid']))
                     *
                     * with no binding to WHOSE invitation it was and no check on
                     * whether it had already been used. So any signed-in account
                     * could write `{isActivated: true, activatedByUid: <self>}`
                     * onto ANY host application — and the read clause above
                     * admits `activatedByUid == request.auth.uid`, so that one
                     * write also handed them the bank details, date of birth and
                     * KYC document URLs the comment at the top of this block
                     * exists to protect.
                     *
                     * It bypassed every check in `activateHost`: the referral
                     * code, the phone and email match against the agency's
                     * invitation, the approved-status gate, the already-used
                     * gate, the restriction check and the one-host-one-agency
                     * rule. They could not grant themselves `users.isHost` —
                     * that is on `ownerProtectedFields()` — so the gain was a
                     * stranger's KYC documents and a burnt invitation rather
                     * than host status. Both are enough.
                     *
                     * `activateHost` is the only writer now. It runs with the
                     * Admin SDK, which these rules do not apply to.
                     */
      allow delete: if isAdmin()
                    || (isAgencyCrmWriter()
                        && resource.data.get('agencyId', '') == crmUserAgencyId()
                        && resource.data.get('status', '') == 'pending'
                        && resource.data.get('isActivated', false) != true
                        && resource.data.get('activatedByUid', '') == ''
                        && resource.data.get('applicantUid', '') == ''
                        && resource.data.get('source', '') != 'self_app');
    }

    match /publicProfiles/{uid} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    match /users/{uid} {
      /*
       * ── GET IS OPEN, LIST IS NOT ───────────────────────────────────────────
       *
       * This was `allow read: if request.auth != null`, and `read` is `get` plus
       * `list`. The `list` half made the collection a directory: one throwaway
       * guest account could page the whole of `users` and walk away with every
       * address, phone number, device id, balance, ban reason and `crmRole` on
       * the platform. Nothing legitimate needed it — see below — so it was a
       * standing export of the user base with no attacker skill required.
       *
       * `get` stays open because the product is built on it. A chat header, a
       * call screen, a live room's participant strip and a party seat all fetch
       * one known uid to render a name and a photograph. Those are single-
       * document reads of somebody the reader is already interacting with.
       *
       * Field-level rules do not exist in Firestore, so `get` still returns the
       * whole document to whoever asks for a specific uid. The projection that
       * fixes that properly is `publicProfiles/{uid}`, which the feed, the
       * discover list and the other-user profile screen already read instead —
       * migrating the remaining single-document fetches to it is the next step
       * and does not belong in a rules change.
       *
       * What `list` cost, and why nothing broke:
       *   * The CRM's user list, search and analytics pages all query this
       *     collection — and they run as staff, which `isStaff()` admits.
       *   * The Android app never queries it. Every app read is
       *     `.document(uid)`; the feed uses `publicProfiles`. The one exception
       *     is the client-side "is this email already taken" pre-check in
       *     `AuthRepository.saveUserProfile`, which is already wrapped in a
       *     best-effort try/catch and whose authoritative answer is
       *     `bindVerifiedIdentity` refusing the bind. Losing it removes a
       *     duplicate of a server decision — and that pre-check was itself a
       *     small enumeration oracle.
       */
      allow get:    if request.auth != null;
      allow list:   if isStaff();
      /*
       * ── DELETE (Phase 1A, IDENTITY-002) ─────────────────────────────────────
       *
       * Was `isOwner(uid) || isAdmin()`. Every protection on this document is
       * an UPDATE rule, and delete-then-create walks around all of them: a
       * banned or suspended account deleted its own document and created a
       * clean one — no `isBanned`, no `accountState`, no `crmRole`, no
       * `credentialsValidAfter`. A staff browser could do the same to anyone.
       *
       * Now:
       *   * a real deletion goes through `requestAccountDeletion` and the purge
       *     (Admin SDK), which these rules do not govern;
       *   * the owner may delete only a HALF-MADE signup — the Back button on
       *     profile setup (`abandonSignup`) — and only while it carries no
       *     moderation, deletion, CRM or money state and no `crmUsers` row;
       *   * no browser, staff included, deletes a user document.
       */
      function abandonableSignup() {
        let d = resource.data;
        return d.get('isProfileComplete', false) != true
            && d.get('isBanned', false) != true
            && d.get('isSuspended', false) != true
            && d.get('accountState', 'active') in ['active', '']
            && d.get('crmRole', '') == ''
            && d.get('isHost', false) != true
            && d.get('isSeller', false) != true
            && d.get('diamonds', 0) == 0
            && d.get('beans', 0) == 0
            && d.get('coinBalance', 0) == 0
            && !exists(/databases/$(database)/documents/crmUsers/$(uid));
      }
      allow delete: if isOwner(uid) && abandonableSignup();

      /*
       * ── CREATE: AN ALLOWLIST (Phase 1A, IDENTITY-002 / CONTACT-001) ─────────
       *
       * This was a denylist of twenty money and role fields, so everything
       * not on it — `accountState`, `isSuspended`, `crmRole`, `isOfficial`,
       * `credentialsValidAfter`, `activeMobileSession`, `deviceId`, `phoneKey`
       * — could be set at birth, where no update rule ever looks.
       *
       * The list below is exactly what the app writes when a document does
       * not yet exist: `createUserDocument` and `saveUserProfile`'s
       * `set(merge)` (AuthRepository.kt). Server-maintained fields arrive
       * later through the Admin SDK.
       *
       * Contact fields are accepted only as the VERIFIED values on the
       * caller's own token, or empty. A typed address or number never lands
       * on a user document from a client.
       */
      function userCreateFields() {
        return ['uid', 'name', 'photoUrl', 'phoneNumber', 'email',
                'isProfileComplete', 'createdAt', 'lastSeen',
                'gender', 'dob', 'age', 'city', 'country', 'languages', 'bio',
                'isOnline', 'coverPhotoUrl', 'theme', 'appLanguage'];
      }
      function contactIsVerified(data) {
        return (data.get('email', '') == ''
                || (tokenEmailVerified()
                    && string(data.get('email', '')).lower() == request.auth.token.get('email', '').lower()))
            && (data.get('phoneNumber', '') == ''
                || data.get('phoneNumber', '') == request.auth.token.get('phone_number', ''));
      }
      allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(userCreateFields())
          && request.resource.data.get('uid', uid) == uid
          && contactIsVerified(request.resource.data);

      function ownerProtectedFields() {
        return [
          'diamonds', 'beans', 'beansAvailable', 'totalBeansEarned',
          'totalGemsSpent', 'coinBalance', 'videoCards',
          'totalXp', 'level', 'hostLevel', 'hostCallEarnings', 'hostGiftEarnings',
          'dailyStreak', 'lastDailyClaimDate',
          'isVerifiedHost', 'payoutHold', 'isBanned', 'isHost', 'isSeller',
          'agencyId', 'ownAgencyId', 'role',
          'callRateBeans',
          'totalGiftsReceived', 'totalGiftsSent', 'totalLikesReceived',
          'totalLikesGiven',
          'isOfficial', 'isAgent', 'crmRole', 'wealthLevel',
          'isLive', 'isInCall', 'isInParty',
          'topSupporters', 'topHosts', 'streamedTimeSeconds', 'hasRecharged',
          'banReason', 'referralCode',
          /*
           * Which cosmetic is worn. These are PAID GOODS.
           *
           * They were owner-writable, and nothing cross-checked `ownedItems`,
           * so the whole timed-cosmetic economy was optional: write
           * `equippedEntrance` to any item id and wear it without buying it.
           * `expireCosmetics` clears the pointer every hour when the term runs
           * out, and the client could simply write it back — a cosmetic that
           * flickered off and on, unpaid, forever.
           *
           * `equipBagItem` now owns these. It checks the item is owned and
           * unexpired, which is a question a rule cannot ask (it needs a lookup
           * in a sibling subcollection plus a time comparison).
           */
          'equippedFrame', 'equippedChatBubble', 'equippedProfileCard',
          'equippedIdFrame', 'equippedEntrance',
          /*
           * Which device holds the one active mobile session.
           *
           * This was client-written, and that made the one-device rule a
           * request rather than a rule: a patched app could decline to write it
           * and keep two phones signed in for ever, or write somebody else's
           * session id and take their place. `startMobileSession` owns it now.
           *
           * `sessionToken` is the old single-string form of the same thing,
           * still written for one release so phones on the previous build keep
           * getting kicked correctly.
           */
          'activeMobileSession', 'sessionToken',
          /*
           * The displacement cut-off `sessionCurrent()` compares `auth_time`
           * against. An account that could write this could set it to 0 and
           * re-admit every device it has ever been signed in on — which is the
           * entire control, handed to the one party it is aimed at.
           */
          'credentialsValidAfter',
          /*
           * Which state the account is in. Written by the deletion, recovery
           * and purge paths only — a client that could set
           * `accountState: 'active'` could undo its own deletion and, worse,
           * reclaim an identity the binding rules had already released.
           */
          'accountState', 'deletionRequestedAt', 'deletionDueAt', 'purgedAt',
          /** The normalised phone, maintained by the syncPhoneKey trigger. */
          'phoneKey',
          /*
           * Moderation state. ALL of this was self-writable, which made three
           * separate holes:
           *
           *   `isSuspended` / `suspendedUntil` — a suspended account could
           *   clear its own suspension flag. It stayed barred by `isBanned`,
           *   but it silently dropped out of `lift_expired_suspensions`'s
           *   query, so the sweep could never end the suspension and the CRM
           *   showed it as active.
           *
           *   `deviceId` — the WORST of the three. `ban_user` bans whatever
           *   device id is on the account, so somebody expecting a ban could
           *   write a fabricated id and have the cascade ban a handset that
           *   does not exist, leaving their real phone clean.
           *
           *   `accountState` — the state machine itself.
           */
          'isSuspended', 'suspendedUntil', 'suspensionDays', 'deviceId',
          'accountState',
          'bannedBy', 'bannedByName', 'bannedByRole', 'bannedAt',
          'unbannedBy', 'unbannedByName', 'unbannedByRole', 'unbannedAt',
          'suspendedBy', 'suspendedByName', 'suspendedByRole', 'suspendedAt',
          'resumedBy', 'resumedByName', 'resumedByRole', 'resumedAt',
          'previousBanReason', 'warningCount',
          /*
           * RC2 D4 (B1 moderation lifecycle). `ban_user` (services/users.py)
           * now writes the ban's scope, category and evidence onto the
           * account beside `banReason`, and the money freeze that travels
           * with it writes `payoutHoldReason` / `payoutHoldAt` beside
           * `payoutHold`. All of it is read as the decision (appeals.py reads
           * banScope/banCategory/banEvidence back). Admin SDK only — a subject
           * that could rewrite its own ban category or evidence would be
           * editing the case against itself.
           */
          'banScope', 'banCategory', 'banEvidence',
          'payoutHoldReason', 'payoutHoldAt',
          /*
           * Phase 1A (CONTACT-001 / IDENTITY-002). Contact identity is moved
           * only by `bindVerifiedIdentity` and the server-side bind paths.
           * `email` and `phoneNumber` are NOT in this list, because the
           * update rule below lets the owner write them when — and only when
           * — the new value is the verified one on their own token; see
           * `ownerContactWriteOk()`. `phone` is a legacy spelling with no
           * verified source, so it is simply closed.
           */
          'phone', 'isDeleted', 'uid',
          'activeSessionId', 'sessionStartedAt', 'credentialsRevokedAt',
          'isStaff', 'staffRole', 'roles', 'isVerified', 'verificationStatus',
          'isGuest', 'guestDeviceId', 'createdVia',
          /*
           * FX-02 (RF-06). The Host lifecycle stamps — written only by the
           * server (`grant_host`, `revoke_host`, `restore_host`, `_move_host`,
           * `activateHost`, all Admin SDK) and READ as the decision itself:
           * `hostEligibility.ts` (HOST_REVOKED_STAMPS / HOST_REINSTATED_STAMPS),
           * `partner_applications` (a revoked Host may not apply again),
           * `user_roles` and `role_appeals`. While they were writable a revoked
           * Host could delete `hostRevokedAt` (or write `hostRestoredAt`), apply
           * again and be approved — the Owner-only reinstatement, skipped. No
           * client writes any of them.
           */
          'hostAddedAt', 'hostGrantedAt', 'hostGrantedBy', 'hostGrantedByName',
          'hostGrantedByRole',
          'hostRemovedAt', 'hostRevokedAt', 'hostRevokedBy', 'hostRevokedByName',
          'hostRevokedByRole', 'hostRevokedReason',
          'hostRestoredAt', 'hostRestoredBy', 'hostRestoredByName', 'hostRestoredByRole',
          'hostActivatedAt',
          'agencyTransferredAt', 'agencyTransferredFrom',
          /*
           * §5 Host role suspension. Written only by `users.suspend_host` /
           * `resume_host` and the expiry sweep (Admin SDK), and READ as the
           * decision itself: `hostEligibility.hostRoleSuspension` refuses every
           * Host-only callable while `hostSuspended` is true, and `mayGoLive()`
           * below refuses the room. A Host who could write `hostSuspended:
           * false` would lift their own suspension with no Resume, no audit
           * entry and no notice — so no client writes any of them.
           */
          'hostSuspended', 'hostSuspendedUntil', 'hostSuspendedReason', 'hostSuspensionDays',
          'hostStatusBeforeSuspension',
          'hostSuspendedBy', 'hostSuspendedByName', 'hostSuspendedByRole', 'hostSuspendedAt',
          'hostResumedBy', 'hostResumedByName', 'hostResumedByRole', 'hostResumedAt',
        ];
      }

      /*
       * The owner may change `email` / `phoneNumber` only to the verified
       * value on their own ID token (or clear nothing — removal is not a
       * client action either). Typed contact details never reach this
       * document from a client. Contact CHANGE as a product feature is
       * CONTACT-003 and deliberately not implemented.
       *
       * P0-5: the email must be VERIFIED on the token (AUTHN-2), and a contact
       * already on the document is never REPLACED from a client (AUTHN-3,
       * interim, until D1/D2 decide the change workflow). Writing the same
       * value again is fine, and so is respelling the same phone number — a
       * legacy bare `9876543210` becoming the token's `+919876543210`.
       *
       * HOTFIX-1 A-1 (2026-11-01, old-client relief): an EMPTY value written
       * over a contact the document does not hold (key absent, null or '')
       * changes nothing, so it is accepted as "no change". App builds before
       * 19 write `email: ""` / `phoneNumber: ""` on profile setup for every
       * guest and phone user, and `changed()` reports the ADDED key, which
       * sent the whole owner arm into the `!= ''` branch and refused the
       * save. Only the empty-over-empty case is new: a NON-empty value still
       * has to be the verified token value, and an existing non-empty contact
       * is still never cleared or replaced — `'' over 'x'` falls through to
       * the original branch, which requires the new value to be non-empty.
       */
      function ownerContactWriteOk() {
        let ch = changed();
        let oldEmail = resource.data.get('email', '');
        let newEmail = string(request.resource.data.get('email', '')).lower();
        let oldPhone = resource.data.get('phoneNumber', '');
        let oldDigits = string(oldPhone).replace('[^0-9]', '');
        let newDigits = string(request.resource.data.get('phoneNumber', '')).replace('[^0-9]', '');
        return (!ch.hasAny(['email'])
                || (request.resource.data.get('email', '') == ''
                    && (oldEmail == null || oldEmail == ''))
                || (request.resource.data.get('email', '') != ''
                    && tokenEmailVerified()
                    && newEmail == request.auth.token.get('email', '').lower()
                    && (oldEmail == null || oldEmail == ''
                        || string(oldEmail).lower() == newEmail)))
            && (!ch.hasAny(['phoneNumber'])
                || (request.resource.data.get('phoneNumber', '') == ''
                    && (oldPhone == null || oldPhone == ''))
                || (request.resource.data.get('phoneNumber', '') != ''
                    && request.resource.data.get('phoneNumber', '')
                         == request.auth.token.get('phone_number', '')
                    && (oldPhone == null || oldDigits == '' || oldDigits == newDigits
                        || (oldDigits.size() >= 6
                            && !string(oldPhone).matches('[+].*')
                            && newDigits.matches('[0-9]{1,3}' + oldDigits)))));
      }

      /*
       * What a STAFF account may not write on somebody else's user document.
       *
       * ── THIS USED TO BE MONEY ONLY, AND THAT WAS A HOLE ────────────────────
       *
       * The list was the ten money fields and nothing else, on the reasoning
       * that only balances were worth protecting from the people who administer
       * the platform. Everything else on `ownerProtectedFields()` — sixty-odd
       * fields the SUBJECT cannot write — was writable by any account
       * `isStaff()` admits, which is every department role down to
       * `marketing_member` and `support_member`, plus the legacy strings
       * 'admin', 'ops', 'tech', 'finance' and 'support'.
       *
       * From a browser console, on any `users/{uid}` including their own, that
       * meant:
       *
       *   `isBanned` / `isSuspended` / `accountState` — clear a ban outright.
       *   Not "lift it": BYPASS it. `ban_user` in the API bars every device the
       *   account has used, preserves manual device bans, and writes an audit
       *   entry naming who did it. A direct write does none of that, so the
       *   account walks back in with its device bans still attached to nothing
       *   and no record that anyone intervened.
       *
       *   `crmRole` / `isOfficial` / `isAgent` — grant yourself the OWNER badge
       *   in the app. It confers no CRM or API authority (those read
       *   `crmUsers/{uid}` and Mongo `staff`), but it is the badge every user
       *   in the product is taught to trust.
       *
       *   `deviceId` — point somebody else's ban cascade at a handset that does
       *   not exist.
       *
       *   `activeMobileSession` / `sessionToken` — take over, or quietly keep,
       *   a session the one-device rule was supposed to end.
       *
       *   `phoneKey` / `email` / `phoneNumber` — move an identity between
       *   accounts, behind the back of the three-case binding rule.
       *
       *   the five `equipped*` pointers — wear paid cosmetics without buying
       *   them, which `equipBagItem` exists to prevent.
       *
       * ── WHY THE LIST IS SPELLED OUT RATHER THAN DERIVED ────────────────────
       *
       * `ownerProtectedFields()` and this one overlap heavily and the obvious
       * move is to concat one into the other. They are written out separately
       * on purpose: they answer different questions and they are NOT the same
       * set. Staff legitimately write several fields the subject may not —
       * `isHost`, `isSeller`, `agencyId`, `warnings`, `isOnline`, `level` —
       * because `lib/firestore.ts` writes exactly those from the CRM browser
       * (`makeHost`, `removeHost`, `setSeller`, `warnUser`). Deriving one list
       * from the other would either break those screens or quietly re-open a
       * hole the next time somebody adds a field.
       *
       * The rule for anything added here later: if a Cloud Function or the
       * Python API is the thing that writes it, it belongs on this list.
       */
      function staffProtectedFields() {
        return [
          'diamonds', 'beans', 'beansAvailable', 'totalBeansEarned',
          'totalGemsSpent', 'totalXp', 'coinBalance',
          'videoCards', 'hostCallEarnings', 'hostGiftEarnings',

          'crmRole', 'isOfficial', 'isAgent', 'ownAgencyId',

          'isBanned', 'banReason', 'previousBanReason',
          'isSuspended', 'suspendedUntil', 'suspensionDays',
          'bannedBy', 'bannedByName', 'bannedByRole', 'bannedAt',
          'unbannedBy', 'unbannedByName', 'unbannedByRole', 'unbannedAt',
          'suspendedBy', 'suspendedByName', 'suspendedByRole', 'suspendedAt',
          'resumedBy', 'resumedByName', 'resumedByRole', 'resumedAt',
          'banScope', 'banCategory', 'banEvidence',
          'payoutHoldReason', 'payoutHoldAt',

          'accountState', 'isDeleted',
          'deletionRequestedAt', 'deletionDueAt', 'purgedAt',

          'deviceId', 'activeMobileSession', 'sessionToken', 'credentialsValidAfter',

          'phoneKey', 'phoneNumber', 'email', 'phone', 'uid',

          /*
           * Phase 1A (SECURITY-004 / ROLE-001). Partner and level state.
           *
           * The comment above says staff legitimately write `isHost`,
           * `isSeller`, `agencyId` and `level` from the CRM browser. They no
           * longer do: `makeHost` / `removeHost` were removed from
           * lib/firestore.ts and the hosts page calls the API
           * (`grant_host` / `revoke_host`), which checks the eligibility
           * matrix, writes the agency roster and the audit entry. A direct
           * browser write did none of that and could make a staff member, a
           * guest or an Owner a host.
           */
          'isHost', 'isSeller', 'agencyId', 'callRateBeans', 'level',
          'hostLevel', 'role', 'wealthLevel', 'hostActivatedAt',
          'isStaff', 'staffRole', 'roles', 'isVerified', 'verificationStatus',
          'activeSessionId', 'sessionStartedAt', 'credentialsRevokedAt',
          'warningCount',

          'isVerifiedHost', 'payoutHold',

          'equippedFrame', 'equippedChatBubble', 'equippedProfileCard',
          'equippedIdFrame', 'equippedEntrance',

          'hostAddedAt', 'hostGrantedAt', 'hostGrantedBy', 'hostGrantedByName',
          'hostGrantedByRole',
          'hostRemovedAt', 'hostRevokedAt', 'hostRevokedBy', 'hostRevokedByName',
          'hostRevokedByRole', 'hostRevokedReason',
          'hostRestoredAt', 'hostRestoredBy', 'hostRestoredByName', 'hostRestoredByRole',
          'agencyTransferredAt', 'agencyTransferredFrom',

          'hostSuspended', 'hostSuspendedUntil', 'hostSuspendedReason', 'hostSuspensionDays',
          'hostStatusBeforeSuspension',
          'hostSuspendedBy', 'hostSuspendedByName', 'hostSuspendedByRole', 'hostSuspendedAt',
          'hostResumedBy', 'hostResumedByName', 'hostResumedByRole', 'hostResumedAt',
        ];
      }

      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function genderWriteOk() {
        return !changed().hasAny(['gender'])
            || resource.data.get('gender', '') == null
            || resource.data.get('gender', '') == '';
      }
      allow update: if
          (isStaff() && !changed().hasAny(staffProtectedFields()))
          || (isOwner(uid) && notBanned() && !changed().hasAny(ownerProtectedFields())
              && ownerContactWriteOk()
              && genderWriteOk())
          || (isOwner(uid)
              && changed().hasOnly(['fcmToken'])
              && resource.data.keys().hasAny(['fcmToken'])
              && !request.resource.data.keys().hasAny(['fcmToken']));

      match /giftShowcase/{giftId} {
        allow read:  if request.auth != null;
        allow write: if false;
      }

      match /topFans/{fanUid} {
        allow read:  if request.auth != null;
        allow write: if false;
      }

      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(uid);
      }

      match /blocked/{targetUid}      { allow read, write: if isOwner(uid) || isAdmin(); }
      match /liked/{targetUid}        { allow read, write: if isOwner(uid) || isAdmin(); }
      match /likedBy/{likerUid}       { allow read: if isOwner(uid) || isAdmin(); allow write: if false; }

      /*
       * What this account owns, and until when. SERVER-WRITTEN.
       *
       * The comment above is now history: `purchaseBagItem` moved server-side,
       * so the client no longer batches this with a diamond write and no longer
       * needs to write it at all. Leaving it owner-writable meant the ownership
       * record itself was forgeable — `{ expired: false, expiresAt: <year
       * 3000> }` on any item id, and every paid cosmetic was free. Worse, it
       * made `equipBagItem` pointless before it was written: a callable that
       * validates against a document the client controls validates nothing.
       *
       * Reads stay open to the owner, because the bag screen lists them.
       */
      /*
       * ── `allow write: if false` — NOT `isAdmin()` ───────────────────────────
       *
       * The comment above says SERVER-WRITTEN, and `purchaseBagItem` /
       * `equipBagItem` write it with the Admin SDK, which these rules do not
       * apply to. So `isAdmin()` granted nothing the server needed and
       * everything it did not: `isAdmin()` matches `.*_admin`, so
       * marketing_admin, support_admin — any of the six — could grant any user
       * any paid cosmetic from a browser, with no audit entry and no diamond
       * movement. "Server-written" and "writable by six department admins" were
       * the same line.
       *
       * `false` is the honest spelling of server-written.
       */
      match /ownedItems/{itemId} {
        allow read:  if isOwner(uid) || isStaff();
        allow write: if false;
      }
      match /followers/{followerUid} {
        allow read:  if request.auth != null;
        allow write: if isOwner(followerUid);
      }
      match /following/{followedUid} {
        allow read:  if request.auth != null;
        allow write: if isOwner(uid) || isAdmin();
      }
      match /warnings/{warningId} {
        allow read:   if isOwner(uid) || isStaff();
        allow create, update, delete: if isStaff();
      }
      match /gameHistory/{matchId} {
        allow read:  if isOwner(uid) || isFinance() || isAdmin();
        allow write: if false;
      }
      match /diamondTransactions/{txId} {
        allow read:  if isOwner(uid) || isFinance() || isAdmin();
        allow write: if false;
      }
      match /dailyStats/{dayKey} {
        allow read:  if isOwner(uid) || isStaff();
        allow write: if false;
      }
      match /dailyTasks/{dayKey} {
        allow read:  if isOwner(uid);
        allow write: if false;
      }
      match /dailyTaskSeen/{markerId} {
        allow read, write: if false;
      }
      match /weeklyEarnings/{weekKey} {
        allow read:  if isOwner(uid) || isStaff();
        allow write: if false;
      }
      match /weeklyStatements/{weekKey} {
        allow read:  if isOwner(uid) || isStaff();
        allow write: if false;
      }

      match /beanTransactions/{txId} {
        allow read:  if isOwner(uid) || isFinance() || isAdmin();
        allow write: if false;
      }
      match /giftsSent/{docId}     { allow read, write: if isOwner(uid) || isAdmin(); }
      match /giftsReceived/{docId} {
        allow read:           if request.auth != null;
        allow create:         if false;
        allow update, delete: if isOwner(uid) || isAdmin();
      }
    }

    match /kycSubmissions/{docId} {
      allow read:   if isAdmin() || isSupport()
                    || (isAppUser() && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.get('uid', '') == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /hostKyc/{hostUid} {
      allow read: if isAdmin() || isOwner(hostUid);
      allow write: if isAdmin();
    }

    match /gifts/{giftId} {
      allow read:  if true;            // public — app shows gifts before login; lottie-test.html needs unauthenticated access
      allow write: if isTech() || isApp() || isOps();
    }

    match /giftLottieData/{docId} {
      allow read:  if true;       // public — lottie-test.html is unauthenticated
      allow write: if isTech() || isApp() || isOps();
    }

    match /bagItems/{itemId} {
      allow read:  if true;   // public — app shows bag items before login; lottie-test.html needs unauthenticated access
      allow write: if isTech();
    }

    match /giftEvents/{docId} {
      allow read: if request.auth != null
                  && (resource.data.roomId != ''
                   || resource.data.senderUid   == request.auth.uid
                   || resource.data.receiverUid == request.auth.uid);
      allow write: if false;
    }

    match /giftTransactions/{txId} {
      allow read: if (request.auth != null
                      && (resource.data.senderUid   == request.auth.uid
                       || resource.data.receiverUid == request.auth.uid))
                     || isFinance() || isAdmin();
      allow write: if false;
    }

    match /contentConfig/{docId} {
      allow read:  if request.auth != null;
      allow write: if isTech();
      match /{subDoc=**} {
        allow read:  if request.auth != null;
        allow write: if isTech();
      }
    }

    match /levelConfig/{type} {
      allow read:  if request.auth != null;
      allow write: if isTech();
      match /levels/{docId} {
        allow read:  if request.auth != null;
        allow write: if isTech();
      }
    }

    match /techTickets/{ticketId} {
      allow read:   if isStaff();
      allow create, update: if false;
      allow delete: if isSuperAdmin();
    }

    match /opsTickets/{ticketId} {
      allow read:   if isOps() || isAdmin();
      allow create: if isCrmUser() || isAppUser();  // users can raise reports
      allow update: if isOps() || isAdmin();
      allow delete: if isAdmin();
    }

    match /platformRevenue/{docId} {
      allow create:         if false;
      allow read:           if isFinance() || isAdmin();
      allow update, delete: if false;
    }

    match /platformStats/{docId} {
      allow read:           if request.auth != null;
      allow create, update: if false;
      allow delete:         if isAdmin();
    }

    match /weeklyPayoutReports/{reportId} {
      allow read: if isFinance() || isAdmin()
                  || (request.auth != null
                      && resource.data.agencyOwnerUid == request.auth.uid);
      allow create: if isFinance() || isAdmin();  // Cloud Function uses Admin SDK (bypasses rules)
      allow update: if isFinance() || isAdmin()
                    || (request.auth != null
                        && resource.data.agencyOwnerUid == request.auth.uid
                        && resource.data.status == 'generated'
                        && request.resource.data.status == 'submitted');
      allow delete: if isSuperAdmin();

      /*
       * RC2 D1 (audit R-11, CRM M-13) — THE PER-HOST ROWS OF A REPORT.
       *
       * `weeklyPayoutReportGenerator` (functions/src/index.ts) writes one
       * document per eligible host at
       * `weeklyPayoutReports/{weekLabel}/hostPayouts/{agencyId}_{hostUid}`:
       * `{ agencyId, agencyName, hostUid, hostName, weekBeans, hostPayoutInr,
       *    weekLabel, weekStart, weekEnd, status, eligible, createdAt }`.
       * There was no rule for this path, so the catch-all denied it and the
       * Finance payouts page showed every report with "no per-host rows";
       * `lib/finance.ts` now reads this path first (falling back to the
       * legacy top-level collection, below, when refused).
       *
       * Readers: Finance and admins (the payouts page), and the report's
       * AGENCY OWNER for its own rows — bound through the CALLER's own login
       * (`isAgencyCrmUser() && crmUserAgencyId()`), not through a field on
       * the row, because the generator writes `agencyId`, never
       * `agencyOwnerUid`, and a report covers EVERY agency, so there is no
       * single owner uid on the report document either. An agency must query
       * with `where('agencyId', '==', <its agency>)` — an unconstrained list
       * over a report is refused for it. Nobody else: no app screen reads
       * this path (grep, 2026-11-01), so the host-self arm of the legacy path
       * below is deliberately not copied here.
       *
       * Writers: none. The generator writes with the Admin SDK; the CRM only
       * reads; a browser row here would be a payout line nobody computed.
       */
      match /hostPayouts/{payoutId} {
        allow read:  if isFinance() || isAdmin()
                     || (isAgencyCrmUser()
                         && resource.data.agencyId != ''
                         && resource.data.agencyId == crmUserAgencyId());
        allow write: if false;
      }
    }

    match /hostPayouts/{payoutId} {
      allow read: if isFinance() || isAdmin()
                  || (request.auth != null && resource.data.agencyOwnerUid == request.auth.uid)
                  || (request.auth != null && resource.data.hostUid == request.auth.uid);
      allow create: if isFinance() || isAdmin();
      allow update: if isFinance() || isAdmin();
      allow delete: if isSuperAdmin();
    }

    /*
     * ══════════════════════════════════════════════════════════════════════════
     * THE PUBLIC COIN-SELLER DIRECTORY
     * ══════════════════════════════════════════════════════════════════════════
     *
     * Six fields and a document id, projected from `sellers/{id}` by the
     * `syncPublicSeller` trigger: displayName, phone, qrCodeUrl, description,
     * photoUrl, isOnline. Nothing else is in the document, so nothing else can
     * be read out of it — which is the whole point of the collection existing.
     *
     * `sellers` was `allow read: if request.auth != null`, and `read` is `get`
     * AND `list`, so any signed-in account could page every seller's KYC
     * documents, coin balance, commission rate and email. Narrowing that list
     * could not fix it: Firestore returns a document whole or not at all, and
     * rules cannot filter fields. A second document with fewer fields in it is
     * the only thing that can.
     *
     * READ is open to any signed-in account, because that is what a directory
     * is for. WRITE is closed to everybody — the trigger uses the Admin SDK,
     * which these rules do not apply to, so there is no client path to argue
     * about and no "but staff need to edit it" exception to erode. Staff edit
     * the private record; the trigger republishes.
     *
     * A seller who is rejected, suspended or deactivated has their public
     * document DELETED rather than flagged, so there is no visibility query
     * anybody can forget to write.
     */
    match /publicSellers/{sellerId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    match /sellers/{sellerId} {
      /*
       * ── WHY THIS IS NOT SIMPLY `request.auth != null` ANY MORE ─────────────
       *
       * `read` is `get` AND `list`, so that one line let any signed-in account
       * page the entire collection: every seller's `coinBalance` and
       * `totalCoinsSold` (inventory — money), their `commissionRate`, their
       * `idDocUrls` (KYC documents), their phone, email and payout details.
       * The `users/{uid}` block two hundred lines up was narrowed to
       * `allow list: if isStaff()` for exactly this reason; the same reasoning
       * was never applied here.
       *
       * The app does need a directory: `ResellerListScreen` queries
       * `where('isApproved', == true).where('isActive', == true)` to show who a
       * user can buy diamonds from. A list rule is evaluated against every
       * document the query returns, so requiring those two fields makes that
       * query succeed and an unfiltered sweep fail — pending, rejected and
       * suspended sellers stop being enumerable at all.
       *
       * ── AND WHY THE APP NO LONGER READS THIS COLLECTION AT ALL ────────────
       *
       * Narrowing the list to approved-and-active stopped pending and rejected
       * records being enumerated and did nothing for the rest: Firestore returns
       * a document whole or not at all, so an approved seller's KYC was still
       * one directory query away. Rules cannot filter fields.
       *
       * `publicSellers/{id}` is the directory now — six fields, written by the
       * `syncPublicSeller` trigger from an explicit allowlist. The app reads
       * that; this collection is staff and self only.
       */
      allow get:    if isStaff()
                    || (request.auth != null
                        && (sellerId == request.auth.uid
                         || resource.data.get('crmUid', '') == request.auth.uid
                         || resource.data.get('ownerUid', '') == request.auth.uid
                         || resource.data.get('secondRoleOwnerUid', '') == request.auth.uid));
      allow list:   if isStaff();
      allow create: if partnerCreateSafe()
                    && !(request.resource.data.get('source', '') in ['self_app', 'reapply'])
                    && (
                         (
                           request.resource.data.get('coinBalance', 0) == 0
                        && request.resource.data.get('totalCoinsSold', 0) == 0
                        && (
                             isStaff()
                          || (hasContactIdentity()
                              && request.resource.data.ownerUid == request.auth.uid
                              && request.resource.data.get('source', '') == 'self_signup'
                              && request.resource.data.isApproved == false
                              && request.resource.data.isActive == false)
                          || (isCrmUser()
                              && crmLoginUnrestricted()
                              && request.resource.data.get('source', '') == 'second_role'
                              && request.resource.data.get('secondRoleOwnerUid', '') == request.auth.uid
                              && request.resource.data.get('crmUid', '') == request.auth.uid
                              && request.resource.data.isApproved == false
                              && request.resource.data.isActive == false)
                        )
                      )
                    );
      allow update: if (
                        (isSuperAdmin() || isFinance() || isAdmin())
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['coinBalance', 'totalCoinsSold'])
                        && adminPartnerEditSafe()
                        && staffPaymentEditAllowed())
                    || (request.auth != null
                        && resource.data.get('ownerUid', '') == request.auth.uid
                        && request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly(['isOnline', 'lastSeen'])
                        && sellerRecordNotWithdrawn(sellerId)
                        && sellerRecordApproved(sellerId)
                        && (!exists(/databases/$(database)/documents/crmUsers/$(request.auth.uid))
                            || (sellerRoleLive() && crmLoginUnrestricted())))
                    || (isCrmUser()
                        && resource.data.get('crmUid', '') == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['city', 'description', 'qrCodeUrl',
                                        'isOnline', 'lastSeen'])
                        && sellerRoleLive()
                        && crmLoginUnrestricted()
                        && sellerRecordNotWithdrawn(sellerId)
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isOnline'])
                            || request.resource.data.get('isOnline', false) == false
                            || (sellerRoleApproved() && sellerRecordApproved(sellerId))))
                    || (isCrmUser()
                        && resource.data.get('crmUid', '') == request.auth.uid
                        && resource.data.get('isApproved', false) != true
                        && resource.data.get('status', 'pending') == 'pending'
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['coinBalance', 'totalCoinsSold', 'isApproved',
                                       'isActive', 'status', 'ownerUid', 'crmUid',
                                       'commissionRate',
                                       'isOnline'])
                        && sellerRoleLive()
                        && crmLoginUnrestricted())
                    || (isCrmUser()
                        && resource.data.get('crmUid', '') == request.auth.uid
                        && proposesChangeOnly()
                        && sellerRoleLive()
                        && crmLoginUnrestricted()
                        && sellerRecordNotWithdrawn(sellerId))
                    || (tokenEmailVerified()
                        && resource.data.get('email', '') == request.auth.token.email
                        && resource.data.get('crmUid', '') == ''
                        && request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly(['crmUid']));
      allow delete: if isSuperAdmin();

      match /rechargeHistory/{entryId} {
        allow read:   if isStaff()
                      || (isCrmUser()
                          && get(/databases/$(database)/documents/sellers/$(sellerId))
                               .data.get('crmUid', '') == request.auth.uid);
        allow write:  if false;
      }

      match /diamondLending/{lendId} {
        allow read:   if isAdmin() || isSuperAdmin()
                      || (isCrmUser() && get(/databases/$(database)/documents/sellers/$(sellerId))
                              .data.get('crmUid', '') == request.auth.uid);
        allow create: if isSuperAdmin();
        allow update: if isSuperAdmin();
        allow delete: if isSuperAdmin();
      }
    }

    match /rechargeRequests/{reqId} {
      allow read: if isAdmin() || isFinance()
                  || (request.auth != null
                      && (resource.data.buyerUid == request.auth.uid
                          || resource.data.sellerUid == request.auth.uid))
                  || (isCrmUser()
                      && get(/databases/$(database)/documents/sellers/$(resource.data.sellerUid))
                           .data.get('crmUid', '') == request.auth.uid);
      allow create, update: if false;
      allow delete: if false;
    }

    match /callHistory/{callId} {
      allow read:   if isStaff()
                    || (request.auth != null
                        && (resource.data.get('callerUid', '') == request.auth.uid
                            || resource.data.get('receiverUid', '') == request.auth.uid));
      allow write: if false;
    }

    match /hostVerification/{uid} {
      allow read:  if isOwner(uid) || isStaff();
      allow write: if false;
    }

    match /paymentConfig/{countryCode} {
      allow read:  if request.auth != null;   // app reads to show payment options
      allow write: if isTech() || isSuperAdmin();
    }

    match /feedbackTickets/{ticketId} {
      allow create: if isAppUser() && request.resource.data.userId == request.auth.uid;
      allow read:   if (isAppUser() && resource.data.userId == request.auth.uid)
                    || isOps() || isAdmin() || isSupport();
      allow update, delete: if false;
    }

    match /supportTickets/{ticketId} {
      allow create: if isAppUser() && request.resource.data.userId == request.auth.uid;
      allow read:   if (isAppUser() && resource.data.userId == request.auth.uid)
                    || isOps() || isAdmin() || isSupport();
      allow update, delete: if false;
    }

    match /crmSupportTickets/{ticketId} {
      allow read:   if isCrmUser()
                    && (resource.data.raisedByUid == request.auth.uid
                        || isSupport() || isAdmin());
      allow create: if isCrmUser();
      allow update: if isSupport() || isAdmin();
      allow delete: if isAdmin();
    }

    match /pkInvites/{inviteId} {
      allow read:   if request.auth != null;
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /liveRooms/{roomId} {
      function liveHost() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }
      function mayGoLive() {
        return isAppUser()
            && liveHost().isHost == true
            && liveHost().isVerifiedHost == true
            && liveHost().get('isBanned', false) != true
            && liveHost().get('hostSuspended', false) != true
            && notBanned();
      }
      function isLiveHost() {
        return isAppUser() && resource.data.hostUid == request.auth.uid;
      }
      function liveChanged() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      allow read:   if request.auth != null;
      allow create: if mayGoLive() && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.isActive == true
                    && request.resource.data.get('viewerCount', 0) == 0
                    && request.resource.data.get('totalBeansEarned', 0) == 0
                    && request.resource.data.get('totalGiftsReceived', 0) == 0
                    && request.resource.data.get('pkActive', false) == false;

      /*
       * B12 (4 Nov 2026): what the HOST may change on their own room — and nothing the server owns. Money
       * totals (`totalGiftsReceived`, `totalBeansEarned`), the peak, the server's start mark and duration, the
       * end reason and every PK field but `pkWaiting` are written by Cloud Functions only (live.ts, gifts.ts,
       * profiles.ts). `isLiveHost()` used to allow any field, so a host's app could rewrite its own totals, its
       * PK score, or its `hostUid`. `viewerCount` moves only by one (the kick of an older build decrements it;
       * the server recounts from the presence rows anyway). The heartbeat and the pause mark are the server's
       * clock, so the sweep cannot be cheated by a date in the future.
       */
      function hostLiveFields() {
        return ['isActive', 'endedAt', 'durationSeconds', 'title', 'category', 'welcomeMessage',
                'pinnedMessage', 'isPaused', 'pausedAt', 'isCameraOff', 'mutedViewers', 'kickedViewers',
                'pkWaiting', 'hostHeartbeatAt', 'viewerCount', 'hostBlocksCalls'];
      }
      function liveCounterStep(field) {
        return (request.resource.data.get(field, 0) - resource.data.get(field, 0)) in [1, -1];
      }
      function hostLiveWriteOk() {
        return liveChanged().hasOnly(hostLiveFields())
            && !(resource.data.get('isActive', false) == false && request.resource.data.get('isActive', false) == true)
            && (!('pinnedMessage' in liveChanged())
                || (request.resource.data.pinnedMessage is string
                    && request.resource.data.pinnedMessage.size() <= 140))
            && (!('viewerCount' in liveChanged()) || liveCounterStep('viewerCount'))
            && (!('hostHeartbeatAt' in liveChanged()) || request.resource.data.hostHeartbeatAt == request.time)
            && (!('pausedAt' in liveChanged()) || request.resource.data.pausedAt == request.time);
      }

      allow update: if (isLiveHost() && hostLiveWriteOk())
                    || (isAppUser() && liveChanged().hasOnly(['viewerCount']) && liveCounterStep('viewerCount'))
                    || (isAppUser() && liveChanged().hasOnly(['likeCount'])
                        && request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1)
                    || isOps();
      allow delete: if isLiveHost() || isOps();

      function notKickedFromLive() {
        return !(request.auth.uid in
                 get(/databases/$(database)/documents/liveRooms/$(roomId))
                   .data.get('kickedViewers', []));
      }

      function liveRoomDoc() {
        return get(/databases/$(database)/documents/liveRooms/$(roomId)).data;
      }
      function notMutedInLive() {
        return !(request.auth.uid in liveRoomDoc().get('mutedViewers', []));
      }
      function notBlockedByLiveHost() {
        return !exists(/databases/$(database)/documents/users/$(liveRoomDoc().hostUid)/blocked/$(request.auth.uid));
      }
      match /comments/{commentId} {
        allow read:           if request.auth != null;
        allow create:         if isActiveAppUser() && notKickedFromLive() && notMutedInLive() && notBlockedByLiveHost()
                              && request.resource.data.uid == request.auth.uid
                              && request.resource.data.message is string
                              && request.resource.data.message.size() > 0
                              && request.resource.data.message.size() <= 300;
        allow update:         if isOps() || isAdmin();
        allow delete:         if isOps() || isAdmin()
                              || (isAppUser() && liveRoomDoc().hostUid == request.auth.uid);
      }
      match /gifts/{giftId} {
        allow read:           if request.auth != null;
        allow create:         if false;
        allow update, delete: if isAdmin();
      }
      match /viewers/{uid} {
        allow read:           if request.auth != null;
        allow create, update: if isActiveAppUser()
                              && request.auth.uid == uid
                              && notKickedFromLive()
                              && notBlockedByLiveHost();
        allow delete: if (isAppUser()
                          && (request.auth.uid == uid
                              || request.auth.uid == get(
                                   /databases/$(database)/documents/liveRooms/$(roomId)
                                 ).data.hostUid))
                         || isOps();
      }
    }

    match /partyRooms/{roomId} {
      function room() {
        return get(/databases/$(database)/documents/partyRooms/$(roomId)).data;
      }
      function isRoomHost() {
        return request.auth != null && room().hostUid == request.auth.uid;
      }
      function notKicked() {
        return !(request.auth.uid in room().get('kickedUsers', []));
      }
      /**
       * Present in this room, as the server recorded it.
       *
       * `joinPartyRoom` writes the listener row — after checking the password,
       * which is the point. Requiring it here is what stops a private room from
       * being private in the UI only: without it, anyone who could read the
       * collection and learn a room id could post into that room's chat.
       */
      function inRoom() {
        return request.auth != null
               && exists(/databases/$(database)/documents/partyRooms/$(roomId)/listeners/$(request.auth.uid));
      }
      function onOwnSeat() {
        return request.auth != null && resource.data.uid == request.auth.uid;
      }

      /**
       * Anyone signed in may READ a room document, private ones included.
       *
       * That is not a leak, because there is nothing secret left in it: the
       * password is stored as a salted hash (`passwordHash`), never in the
       * clear, precisely so this rule can stay open. What a private room hides
       * is its CONTENTS — the chat, the listeners, and the Agora token — and
       * each of those is gated separately below and in `generateAgoraToken`.
       *
       * It has to stay open because the room list needs the title, the mode and
       * the seat counts of every room to draw a row, including the private ones
       * a person may want to knock on.
       */
      allow read: if request.auth != null;
      allow create, update, delete: if isOps();

      match /seats/{seatIndex} {
        allow read: if request.auth != null;
        allow create, delete: if false;
        allow update: if
          /*
           * The occupant, over their own mic and camera. Nothing else.
           *
           * `selfMuted` and `cameraOff` are deliberately separate fields from
           * `isMuted`, which a moderator writes. One boolean for both would
           * mean a guest the owner had muted could unmute themselves, and the
           * mute hierarchy would not exist.
           */
          (onOwnSeat()
           && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['selfMuted', 'cameraOff']))
          /*
           * A moderator's mute goes through `setPartySeatMute`, not here.
           *
           * The old rule let the room host write `isMuted` directly. That could
           * not express the hierarchy the product asked for — "the owner may
           * unmute anyone, an admin may only unmute what that same admin
           * muted" depends on WHO PLACED the mute, which means reading
           * `mutedBy` and reasoning about it against a role that lives in an
           * array on the parent document. A rule cannot do that.
           */
          || isOps();
      }

      /**
       * Presence. SERVER-WRITTEN, which is new.
       *
       * It used to be a client write, and two things followed. `listenerCount`
       * on the room had no writer at all, so the room list ran an aggregate
       * count query per row to show "12 listening" — a round trip per row of a
       * scrolling list. And a private room was impossible: a password check is
       * only a check if the thing it guards cannot be written without passing
       * it, and a client writing its own presence row simply skipped the
       * question.
       *
       * `joinPartyRoom` and `leavePartyRoom` own these now. Delete stays open
       * to the person themselves so a client tearing down can still get out if
       * the callable is unreachable — being unable to LEAVE a room is the one
       * failure here with no recovery.
       */
      match /listeners/{uid} {
        allow read:          if request.auth != null;
        allow create, update: if isOps();
        allow delete:        if (isAppUser() && request.auth.uid == uid) || isOps();
      }

      match /messages/{messageId} {
        allow read:   if request.auth != null;
        /*
         * Posting requires a listener row, not just an account.
         *
         * `inRoom()` costs one document read per message sent, and buys the
         * thing `notKicked()` alone could not: a private room whose chat cannot
         * be written by someone who never entered it. A kicked person loses
         * their listener row when they are removed, so this subsumes the old
         * check — `notKicked()` stays anyway, because a room can be re-entered
         * and the two answers are not the same question.
         */
        allow create: if isActiveAppUser()
                      && request.resource.data.senderUid == request.auth.uid
                      && inRoom()
                      && notKicked()
                      && !(request.auth.uid in room().get('chatMutedUsers', []));
        allow update, delete: if isOps() || isAdmin();
      }

      /**
       * Seat requests, for a room where sitting down needs consent.
       *
       * Read is open to everyone in the room rather than to moderators only:
       * the asker has to be able to see their own request is still pending, and
       * a rule cannot say "your own document or you are a moderator" without a
       * `get()` on the parent for the admin array. One shared read is cheaper
       * and reveals only who is waiting for a seat, in a room they are all
       * sitting in together.
       */
      match /seatRequests/{uid} {
        allow read:  if request.auth != null;
        allow write: if isOps();
      }

      /** Invitations to a seat. Written by `invitePartySeat`, answered by a callable. */
      match /seatInvites/{uid} {
        allow read:  if request.auth != null && (request.auth.uid == uid || isRoomHost());
        allow write: if isOps();
      }

      /**
       * The gift ticker and the per-seat leaderboard.
       *
       * `create: if request.auth != null` was wrong and is now closed. The
       * client used to write these rows itself, which meant `diamondCost` on
       * the leaderboard was whatever the client claimed — a patched app could
       * top the board for free. `settleGift` writes them now, inside the same
       * transaction that moves the money, so the board reflects diamonds that
       * actually changed hands.
       *
       * (For most of this feature's life `settleGift` wrote them to
       * `liveRooms/{partyRoomId}` — a document that does not exist — so nothing
       * landed here at all and every party gift appeared to vanish.)
       */
      match /gifts/{giftId} {
        allow read:  if request.auth != null;
        allow write: if isOps();
      }

      match /private/{docId} {
        allow read, write: if false;
      }
      match /accessLog/{logId} {
        allow read: if isRoomHost() || isStaff();
        allow write: if false;
      }
      match /pinMisses/{uid} {
        allow read, write: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if isAppUser() && request.resource.data.reporterUid == request.auth.uid;
      allow read:   if (isAppUser()
                        && (resource.data.reporterUid == request.auth.uid
                         || resource.data.targetUid   == request.auth.uid))
                    || isOps() || isAdmin();
      allow update, delete: if isOps() || isAdmin();
    }

    match /appeals/{appealId} {
      function appealFields() {
        return ['subjectUid','subjectName','raisedByUid','raisedByName','raisedByRole',
                'agencyId','kind','reportId','statement','evidenceUrls','status',
                'createdAt','originalDecidedBy'];
      }
      function wellFormedAppeal() {
        return request.resource.data.keys().hasOnly(appealFields())
            && request.resource.data.status == 'pending'
            && request.resource.data.raisedByUid == request.auth.uid
            && request.resource.data.statement is string
            && request.resource.data.statement.size() >= 20
            && request.resource.data.statement.size() <= 2000
            && request.resource.data.kind in ['ban', 'report'];
      }

      function agencyLinkSet() {
        return crmUserAgencyId() is string && crmUserAgencyId() != '';
      }

      function selfAppealIdOk() {
        return appealId.matches('^self_' + request.auth.uid + '_[A-Za-z0-9-]+(_([2-9]|[1-9][0-9]+))?$');
      }
      function contestIdOk() {
        return appealId.matches('^contest_' + request.resource.data.agencyId + '_'
                                + request.resource.data.reportId + '(_([2-9]|[1-9][0-9]+))?$');
      }
      function slotted() {
        return appealId.matches('^(self|contest)_.+_([2-9]|[1-9][0-9]+)$');
      }
      function previousSlotId() {
        let parts = appealId.split('_');
        let n = int(parts[parts.size() - 1]);
        let base = appealId.replace('_[0-9]+$', '');
        return n <= 2 ? base : base + '_' + string(n - 1);
      }
      function reappealOk() {
        return !slotted()
            || (exists(/databases/$(database)/documents/appeals/$(previousSlotId()))
                && get(/databases/$(database)/documents/appeals/$(previousSlotId())).data
                     .get('status', 'pending') != 'pending'
                && (request.resource.data.get('evidenceUrls', []).size() > 0
                    || request.resource.data.statement.trim().lower()
                         != get(/databases/$(database)/documents/appeals/$(previousSlotId())).data
                              .get('statement', '').trim().lower()));
      }

      allow create: if wellFormedAppeal()
                    && reappealOk()
                    && (
                      (isAppUser() && request.resource.data.subjectUid == request.auth.uid
                       && selfAppealIdOk())
                      || (isAgencyCrmWriter()
                          && agencyRoleApproved()
                          && agencyLinkSet()
                          && request.resource.data.agencyId == crmUserAgencyId()
                          && (request.resource.data.kind != 'report' || contestIdOk()))
                    );

      allow read:   if isStaff()
                    || (request.auth != null
                        && resource.data.subjectUid == request.auth.uid)
                    || (request.auth != null
                        && resource.data.raisedByUid == request.auth.uid)
                    || (isAgencyCrmUser()
                        && agencyLinkSet()
                        && resource.data.get('agencyId', '') == crmUserAgencyId());

      allow update, delete: if false;
    }

    match /conversations/{convoId} {
      function isParticipant() {
        return request.auth != null && request.auth.uid in resource.data.participants;
      }
      allow read:   if isParticipant() || isOps();
      allow create: if isActiveAppUser()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;
      allow update: if (isActiveAppUser()
                        && request.auth.uid in request.resource.data.participants)
                    || isOps();
      allow delete: if isOps();

      match /messages/{msgId} {
        function inThisConversation() {
          return request.auth != null
                 && convoId.matches('.*' + request.auth.uid + '.*');
        }
        function peerUid() {
          return convoId.replace('_' + request.auth.uid, '')
                        .replace(request.auth.uid + '_', '');
        }
        function notBlockedByPeer() {
          return !exists(/databases/$(database)/documents/users/$(peerUid())/blocked/$(request.auth.uid));
        }

        allow read:   if inThisConversation() || isOps();
        allow create: if (inThisConversation() && notBanned() && sessionCurrent()
                          && notBlockedByPeer()
                          && request.resource.data.get('senderUid', '') == request.auth.uid
                          && request.resource.data.get('type', 'text') in ['text', 'image', 'voice', 'invite'])
                      || isOps();
        allow update: if (inThisConversation() && notBanned() && sessionCurrent()
                          && notBlockedByPeer()
                          && resource.data.get('senderUid', '') == request.auth.uid
                          && resource.data.get('type', 'text') != 'gift'
                          && request.resource.data.get('senderUid', '') == request.auth.uid
                          && request.resource.data.get('type', 'text') == resource.data.get('type', 'text'))
                      || isOps();
        allow delete: if (inThisConversation()
                          && resource.data.get('senderUid', '') == request.auth.uid
                          && resource.data.get('type', 'text') != 'gift')
                      || isOps();
      }
    }

    match /calls/{callId} {
      allow read:   if (request.auth != null
                        && (resource.data.callerId   == request.auth.uid
                         || resource.data.receiverId == request.auth.uid))
                    || isAdmin();
      allow write:  if false;

      match /messages/{msgId} {
        function isParty() {
          let call = get(/databases/$(database)/documents/calls/$(callId)).data;
          return request.auth != null
                 && (call.callerId == request.auth.uid || call.receiverId == request.auth.uid);
        }
        allow read:   if isParty() || isAdmin();
        allow create: if isParty() && isActiveAppUser()   // Phase 1A (SESSION-001/003)
                      && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    match /broadcasts/{broadcastId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin() || isMarketing();
    }

    /*
     * RC2 D6 — IN-APP NOTICES. One shape, one writer.
     *
     *   { userId, type, title, body, relatedId?, createdAt, read | isRead,
     *     reason?, meta? }
     *
     * Written by the backend (`services/notices.py`, every ticket reply, ban,
     * payout and partner decision) and by the Functions (the payout approval
     * notice in index.ts) through the Admin SDK. The app (APK 20,
     * `ChatRepository.myNotificationsFlow`) listens with
     * `where('userId', '==', me) orderBy('createdAt', 'desc')` and accepts
     * both spellings of the read flag and of the related id. No client
     * writes one — not the app (nothing marks a notice read from the phone),
     * not the CRM (its own notification writer is gone; every reply goes
     * through the API). `allow write: if isAdmin()` therefore granted the
     * server nothing and gave every `.*_admin` a browser write that could
     * put any text in front of any user as "ZIPPER". The admin READ arm goes
     * with it: no CRM screen lists another person's notices, and the backend
     * reads them with the Admin SDK when it needs to.
     */
    match /notifications/{notifId} {
      allow read:  if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /appConfig/{docId} {
      /*
       * `androidUpdate` is readable BEFORE sign-in. Everything else is not.
       *
       * The in-app updater checks this document on the login screen, and on the
       * login screen there is usually no session — a fresh install has none, and
       * so does anybody who has signed out. `request.auth != null` therefore
       * denied the read, `UpdateRepository` caught the denial and answered "up
       * to date" (it fails open by design, so a broken check can never lock
       * someone out), and the update dialog silently never appeared.
       *
       * That is the wrong way round for the case that matters most: a person
       * stuck on a build too old to get past Login is exactly who needs the
       * update, and gating the fix behind the thing that is broken guarantees
       * they never receive it.
       *
       * Nothing is disclosed. The document holds a version code, a version
       * name, release notes, a size, a SHA-256, and a URL to an APK that is
       * already public-read in Storage — it is the binary handed to anybody who
       * installs the app. The hash is what protects the download, not the ACL.
       *
       * Scoped to the one document id rather than opening the collection.
       * `appConfig` also holds `paymentCredentials`: the company bank account
       * and Binance UID that every coin seller in the country pays into.
       *
       * ── RC2 D7 (audit R-6): `paymentCredentials` IS NOT FOR EVERY TOKEN ──
       *
       * `request.auth != null` is also true for an anonymous guest, so the
       * company's bank account number, IFSC, holder and Binance UID were
       * readable with the public web config — phishing material ("pay your
       * recharge here") handed to anyone who could sign in anonymously.
       *
       * Who actually reads it: the CRM's own config page (Owner / Tech, via
       * lib/appConfig.getPaymentCredentials), the CRM seller dashboard's
       * BuyInventoryDialog (a CRM seller login buying inventory), and the
       * app's BuyCoinScreen (an APP seller buying coins — it writes the
       * purchase as `sellerUid = auth.uid`). So: staff; a CRM login whose
       * seller role has STARTED (`sellerRoleApproved()`, the same test the
       * coinPurchaseRequests create arm applies); and an app account with a
       * verified contact on its token AND a started seller record
       * (`hasContactIdentity() && appSellerRecordStarted()`, again the
       * create arm's own binding). A guest, an ordinary user and a pending
       * applicant get nothing — they cannot file a purchase either, so they
       * have nothing to pay for. `luckyGifts`, `economy`, `control` and the
       * rest read as before: any signed-in account.
       */
      allow read:  if docId == 'androidUpdate'
                   || (docId != 'paymentCredentials' && request.auth != null)
                   || (docId == 'paymentCredentials'
                       && (isStaff()
                           || (isCrmUser() && sellerRoleApproved() && crmLoginUnrestricted())
                           || (hasContactIdentity() && appSellerRecordStarted())));

      function ownerOnlyConfig() {
        return docId in ['games', 'leaderboards', 'partySubscription', 'safety', 'dailyTasks'];
      }
      function appConfigWriter() {
        return docId != 'androidUpdate'
            && ((docId == 'paymentCredentials' && isSuperAdmin())
                || (ownerOnlyConfig() && isSuperAdmin())
                || (docId != 'paymentCredentials' && !ownerOnlyConfig() && (isTech() || isSuperAdmin())));
      }
      allow create: if appConfigWriter()
                    && (docId != 'luckyGifts' || isSuperAdmin()
                        || !request.resource.data.keys().hasAny(['enabled']));
      allow update: if appConfigWriter()
                    && (docId != 'luckyGifts' || isSuperAdmin()
                        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['enabled']));
      allow delete: if appConfigWriter()
                    && (docId != 'luckyGifts' || isSuperAdmin());
    }

    match /announcements/{docId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    match /policies/{docType} {
      allow read:  if request.auth != null;
      allow write: if isSuperAdmin() || isApp();
    }

    match /withdrawalRequests/{reqId} {
      allow read:   if isFinance() || isAdmin()
                    || (request.auth != null
                        && resource.data.get('hostUid', '') == request.auth.uid);
      function callerIsLiveHost() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid))
                 .data.get('isHost', false) == true
            && notBanned();
      }
      allow create: if request.resource.data.get('status', '') == 'pending'
                    && ((isFinance() || isSuperAdmin())
                        || (request.auth != null
                            && request.resource.data.get('hostUid', '') == request.auth.uid
                            && callerIsLiveHost()));
      allow update: if (isFinance() || isSuperAdmin())
                    && ((resource.data.get('status', '') == 'pending'
                         && request.resource.data.get('status', '') == 'approved')
                        || (resource.data.get('status', '') in ['pending', 'approved']
                            && request.resource.data.get('status', '') == 'rejected'))
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'processedAt', 'processedBy', 'notes', 'rejectionReason']);
      allow delete: if isSuperAdmin();
    }

    /*
     * HOST PAY, REQUESTED BY THE AGENCY THAT EMPLOYS THEM.
     *
     * Despite the name this is not staff salary — that is `staff.salary_minor`
     * in Mongo and never appears in Firestore. This queue is an agency asking
     * the business to pay one of its hosts, and a human reads `amountInr` off
     * the row and sends real money against it.
     *
     * ── WHAT `create: if request.auth != null` MEANT ─────────────────────────
     *
     * Every signed-in account on the platform — every app user, every throwaway
     * made against the public web API key — could file one, naming any agency,
     * any host and any amount. And because `update` keyed on
     * `agencyOwnerUid == request.auth.uid` with no field allowlist, the same
     * account could name itself in that field on create and then approve its own
     * request. An injected payout, self-approved, with no backend involvement
     * and nothing in the audit log.
     *
     * Now: only the agency the request is FOR may raise one, and only as
     * `pending`. Staff may raise one on an agency's behalf for the cases that
     * arrive by email.
     */
    match /salaryRequests/{reqId} {
      allow read: if isFinance() || isAdmin()
                  || (isAgencyCrmUser() && crmUserAgencyId() == resource.data.agencyId)
                  || (request.auth != null
                      && (resource.data.hostUid        == request.auth.uid
                       || resource.data.agencyOwnerUid == request.auth.uid));

      allow create: if request.resource.data.get('status', '') == 'pending'
                    && (
                         isFinance() || isAdmin()
                      || (isAgencyCrmWriter()
                          && agencyRoleApproved()
                          && crmUserAgencyId() == request.resource.data.get('agencyId', ''))
                    );

      /*
       * Deciding it is staff work. The agency's own update is the last step of
       * the flow — marking that they have passed the money on — and is pinned
       * to that one field, because the clause it replaces allowed the requester
       * to write `status: 'approved'` and `amountInr` on their own record.
       */
      function salaryActorOk() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approvedBy'])
            || request.resource.data.get('approvedBy', '') == request.auth.uid;
      }
      allow update: if ((isFinance() || isSuperAdmin())
                        && ((resource.data.get('status', '') == 'pending'
                             && request.resource.data.get('status', '') == 'approved')
                            || (resource.data.get('status', '') in ['pending', 'approved']
                                && request.resource.data.get('status', '') == 'rejected'))
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'approvedAt', 'rejectedAt', 'notes', 'rejectionReason',
                                       'approvedBy'])
                        && salaryActorOk())
                    || (isAgencyCrmWriter()
                        && crmUserAgencyId() == resource.data.agencyId
                        && resource.data.get('status', '') == 'paid'
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status', 'distributedAt'])
                        && request.resource.data.get('status', '') == 'distributed');

      allow delete: if isAdmin();
    }

    match /approvalRequests/{requestId} {
      allow read: if isSuperAdmin()
                  || (isCrmUser() && resource.data.requestedBy.uid == request.auth.uid);
      function approvalShapeAllowed() {
        let d = request.resource.data;
        return (d.type == 'update_config' && d.operation == 'update'
                && d.targetCollection == 'appConfig' && d.targetDocId in ['control', 'economy'])
            || (d.type == 'create_agency' && d.operation == 'create'
                && d.targetCollection == 'agencies' && d.targetDocId == '')
            || (d.type == 'create_seller' && d.operation == 'create'
                && d.targetCollection == 'sellers' && d.targetDocId == '');
      }
      function approvalPayloadSafe() {
        let d = request.resource.data;
        return d.payload is map
            && (d.operation != 'create'
                || (d.payload.get('status', 'pending') == 'pending'
                    && d.payload.get('isActive', false) == false
                    && d.payload.get('isApproved', false) == false
                    && d.payload.get('coinBalance', 0) == 0
                    && d.payload.get('totalCoinsSold', 0) == 0
                    && d.payload.get('ownerUid', '') in ['', null]
                    && d.payload.get('secondRoleOwnerUid', '') in ['', null]
                    && !d.payload.keys().hasAny(['approvedBy', 'approvedAt'])));
      }

      allow create: if isStaff()
                    && request.resource.data.keys().hasOnly([
                         'type', 'description', 'targetLabel', 'targetCollection', 'targetDocId',
                         'operation', 'payload', 'requestedBy', 'status', 'requestedAt'])
                    && request.resource.data.requestedBy.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && approvalShapeAllowed()
                    && approvalPayloadSafe();
      allow update: if isSuperAdmin()
                    && resource.data.status == 'pending'
                    && request.resource.data.status in ['approved', 'rejected']
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'reviewedBy', 'reviewedAt', 'reviewNotes'])
                    && request.resource.data.reviewedBy.uid == request.auth.uid
                    && (request.resource.data.status == 'rejected'
                        || resource.data.requestedBy.uid != request.auth.uid);
      allow delete: if false;
    }

    match /coinPurchases/{purchaseId} {
      allow read: if isStaff()
                  || (isCrmUser()
                      && get(/databases/$(database)/documents/sellers/$(resource.data.sellerUid))
                           .data.get('crmUid', '') == request.auth.uid);
      allow write: if false;
    }

    match /coinPurchaseRequests/{purchaseId} {
      allow get: if isAdmin() || isFinance()
                 || (isCrmUser()
                     && get(/databases/$(database)/documents/sellers/$(resource.data.sellerUid))
                          .data.get('crmUid', '') == request.auth.uid);
      allow list: if isAdmin() || isFinance()
                  || (isCrmUser()
                      && (resource.data.sellerUid == request.auth.uid
                          || resource.data.sellerUid
                               == get(/databases/$(database)/documents/crmUsers/$(request.auth.uid)).data.get('sellerId', '-')));

      allow create: if request.resource.data.get('status', '') == 'pending'
                    && sellerRecordNotWithdrawn(request.resource.data.get('sellerUid', ''))
                    && (
                      (isCrmUser() && sellerRoleApproved() && crmLoginUnrestricted()
                       && sellerRecordApproved(request.resource.data.get('sellerUid', ''))
                       && get(/databases/$(database)/documents/sellers/$(request.resource.data.sellerUid))
                            .data.get('crmUid', '') == request.auth.uid)
                      || (hasContactIdentity()
                          && request.resource.data.get('sellerUid', '') == request.auth.uid
                          && appSellerRecordStarted())
                    );

      allow update: if canDecideCoinOps()
                    && request.resource.data.get('status', '') == 'rejected';
      allow delete: if isSuperAdmin();
    }

    match /rechargePackages/{docId} {
      allow read:  if request.auth != null;
      allow write: if isSuperAdmin();
    }

    match /diamondPacks/{docId} {
      allow read:  if request.auth != null;
      allow write: if isSuperAdmin();
    }

    match /coinPackages/{docId} {
      allow read:  if request.auth != null;
      allow write: if isSuperAdmin();
    }

    match /{path=**}/diamondTransactions/{txId} {
      allow read: if isFinance() || isAdmin();
    }

    match /{path=**}/beanTransactions/{txId} {
      allow read: if isFinance() || isAdmin();
    }

    match /safetyFlags/{flagId} {
      allow read:   if isStaff();
      allow update: if (isOps() || isSuperAdmin())
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'note']);
      allow create, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /giftPairs/{pairId}/gifts/{giftId} {
      allow read: if request.auth != null
                  && pairId.split('_').hasAny([request.auth.uid]);
      allow write: if false;
    }

    match /giftIdempotency/{claimId} {
      allow read, write: if false;
    }

    match /gameMatches/{matchId} {
      allow read:  if request.auth != null;
      allow write: if false;
      match /private/{docId} {
        allow read, write: if false;
      }
    }
    match /gameLedger/{rowId} {
      allow read, write: if false;
    }
    match /gameIdempotency/{claimId} {
      allow read, write: if false;
    }
    match /promoCredits/{rowId} {
      allow read, write: if false;
    }

    match /leaderboards/{boardId} {
      allow read: if request.auth != null;
      allow write: if false;
      match /entries/{uid} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }
    match /leaderboardSettlements/{settlementId} {
      allow read: if isSuperAdmin() || isFinance();
      allow write: if false;
    }

    match /musicTracks/{trackId} {
      allow read: if request.auth != null && (resource.data.get('enabled', true) == true || isTech() || isSuperAdmin());
      allow write: if isTech() || isSuperAdmin();
    }

    match /partySubscriptions/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isStaff();
      allow write: if false;
    }
    match /subscriptionPayments/{paymentId} {
      allow read, write: if false;
    }
    match /subscriptionIdempotency/{claimId} {
      allow read, write: if false;
    }

    match /sellerTrades/{tradeId} {
      allow read: if isStaff()
                  || (request.auth != null
                      && (resource.data.buyerSellerId == get(/databases/$(database)/documents/crmUsers/$(request.auth.uid)).data.get('sellerId', '-')
                          || resource.data.sellerSellerId == get(/databases/$(database)/documents/crmUsers/$(request.auth.uid)).data.get('sellerId', '-')));
      allow write: if false;
    }

  }
}

