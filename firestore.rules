rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════════════════════
    // HELPER FUNCTIONS
    // ══════════════════════════════════════════════════════════════════════════

    // Any CRM team member — identified by having a document in crmUsers collection.
    // CRM users log in with their real personal email (gmail, etc.) via email+password.
    // App users (phone/Google/anonymous) will never have a crmUsers document.
    /*
     * ── A DEACTIVATED ACCOUNT IS NOT A CRM USER ──────────────────────────────
     *
     * `isActive` is checked HERE rather than at each call site, because every
     * other role helper in this file is built on this one — `isStaff`,
     * `isAdmin`, `isOps`, `isFinance`, `isTech`, `isAgencyCrmUser`,
     * `isSellerCrmUser` all begin with `isCrmUser()`. One place to say it, and
     * no clause anywhere can forget.
     *
     * Before this, nothing in these rules read `isActive` at all. Revoking
     * somebody set `staff.is_active = false` in Mongo, `crmUsers.isActive =
     * false` in Firestore and disabled their Firebase login — and the first two
     * were only ever checked by the API and by `resolveCrmUser` in the browser.
     * A revoked person driving the Firebase SDK directly kept full staff rights
     * in Firestore for as long as their ID token lived, and indefinitely if the
     * Firebase disable had failed — which is an outcome the code reports and
     * audits rather than prevents (`staff.firebase_revoke_failed`).
     *
     * Absent reads as ACTIVE, deliberately. Documents written before this field
     * existed have no `isActive`, and defaulting those to inactive would lock
     * out every long-standing account at once.
     */
    function isCrmUser() {
      return request.auth != null
          && exists(/databases/$(database)/documents/crmUsers/$(request.auth.uid))
          && get(/databases/$(database)/documents/crmUsers/$(request.auth.uid))
               .data.get('isActive', true) != false;
    }

    // Read the role field from crmUsers (called only when isCrmUser() is already true)
    function crmRole() {
      return get(/databases/$(database)/documents/crmUsers/$(request.auth.uid)).data.get('role', '');
    }

    // CRM user holding the AGENCY capability — the agency portal login.
    //
    // ONE LOGIN CAN NOW HOLD BOTH CAPABILITIES — agency AND coin seller. So the
    // question this answers changed from "is this account an agency" to "does
    // this account hold the agency capability", which is the same answer for
    // every account that holds one and the right answer for one that holds two.
    //
    // `role` is unchanged and is still the capability the account was created
    // with; it is what isStaff(), isAdmin(), isSuperAdmin() and every other
    // predicate in this file read, and none of them reads `roles`. `roles` is
    // the full set and is ABSENT on every account that predates this — hence
    // the cheap equality first: a single-capability agency short-circuits on it
    // and performs exactly the document reads it performed before. Only a
    // dual-capability login pays for the second read, and it is the same
    // document, so it is one distinct document either way.
    //
    // Note what this does NOT check: approval. It never did — a pending agency
    // has always been able to read and edit its own pending agency record — and
    // every caller below pairs it with crmUserAgencyId() == <this agency>, so
    // the capability alone grants sight of nothing.
    function isAgencyCrmUser() {
      return isCrmUser()
          && (crmRole() == 'agency'
              || 'agency' in get(/databases/$(database)/documents/crmUsers/$(request.auth.uid))
                               .data.get('roles', []));
    }

    // NOTE — THERE IS DELIBERATELY NO isSellerCrmUser().
    //   The coin-seller side of this file never asked what role the caller had.
    //   Every seller clause — sellers/{id} update, rechargeHistory,
    //   diamondLending, rechargeRequests, coinPurchases, coinPurchaseRequests —
    //   binds on `sellers/{id}.crmUid == request.auth.uid`, i.e. on the record
    //   naming the caller. That is already exactly right for a login that is
    //   also an agency: it holds the seller record, so it matches. Adding a role
    //   predicate there would narrow access that is currently correct, not widen
    //   it. The agency side is the one that was exclusive, and it is the one
    //   above that changed.

    // The agencyId linked to the calling CRM agency user
    function crmUserAgencyId() {
      return get(/databases/$(database)/documents/crmUsers/$(request.auth.uid)).data.get('agencyId', '');
    }

    // Superadmin only
    function isSuperAdmin() {
      return isCrmUser() && crmRole() == 'superadmin';
    }

    // Admin or superadmin
    // NOTE: 'admin' is the legacy pre-department role string; the CRM now uses
    // per-department '{dept}_admin' roles (app_admin, ops_admin, finance_admin,
    // tech_admin, support_admin). Both forms are matched so existing staff
    // accounts keep working regardless of which role string they were created with.
    function isAdmin() {
      return isCrmUser() && (crmRole() in ['superadmin', 'admin'] || crmRole().matches('.*_admin'));
    }

    // App team
    function isApp() {
      return isCrmUser() && crmRole() in ['superadmin', 'admin', 'app', 'app_admin', 'app_member'];
    }

    // Operations team
    function isOps() {
      return isCrmUser() && crmRole() in ['superadmin', 'admin', 'ops', 'ops_admin', 'ops_member'];
    }

    // Tech team
    function isTech() {
      return isCrmUser() && crmRole() in ['superadmin', 'admin', 'tech', 'tech_admin', 'tech_member'];
    }

    // Finance team
    function isFinance() {
      return isCrmUser() && crmRole() in ['superadmin', 'admin', 'finance', 'finance_admin', 'finance_member'];
    }

    // Support team (internal CRM support only)
    function isSupport() {
      return isCrmUser() && crmRole() in ['superadmin', 'admin', 'support', 'support_admin', 'support_member'];
    }

    // Marketing team (broadcasts, promotions, external comms)
    function isMarketing() {
      return isCrmUser() && crmRole() in ['superadmin', 'marketing_admin', 'marketing_member'];
    }

    // INTERNAL staff only.
    //
    // isCrmUser() is TRUE for agency owners and coin sellers as well — they hold
    // crmUsers documents with role 'agency' / 'seller'. Using isCrmUser() to gate
    // privileged writes therefore hands those external partners the same power as
    // internal staff. Anywhere the intent is "our team", use isStaff().
    // Allow-list, deliberately NOT a deny-list. A crmUsers doc with a missing or
    // misspelled role yields '' from crmRole(), and '' is not in ['agency','seller'],
    // so a deny-list would hand staff powers to a malformed document. A future role
    // must also be added here consciously rather than inheriting staff access.
    function isStaff() {
      return isCrmUser() && crmRole() in [
        'superadmin', 'admin',
        'app_admin',     'app_member',
        'ops_admin',     'ops_member',
        'finance_admin', 'finance_member',
        'tech_admin',    'tech_member',
        'support_admin', 'support_member',
        'marketing_admin', 'marketing_member',
        // legacy pre-department role strings
        'ops', 'tech', 'finance', 'support'
      ];
    }

    // ══════════════════════════════════════════════════════════════════════════
    // CAPABILITY — the authority model this system already keeps, read back
    // ══════════════════════════════════════════════════════════════════════════
    //
    // `isAdmin()` above matches `.*_admin`, so it answers "does this role name
    // end in _admin" — a question about SPELLING. On a money collection that is
    // the wrong question: marketing_admin and support_admin satisfy it, and
    // neither department has anything to do with coins. The API does not make
    // that mistake, because the API asks for a named capability.
    //
    // Those capabilities are already on the document. `app/core/roles.PERMISSIONS`
    // is the single source, `crm_directory.DEFAULT_PERMISSIONS` projects it, and
    // `crm_directory.write()` writes the result into `crmUsers.permissions` on
    // every staff record. Until now this file never read it: the comments on
    // `appConfig` and `salaryRequests` both NAME the governing capability and
    // then gate on a role string instead. These two functions close that gap, so
    // a role widened in `roles.py` is widened here by the same edit — and one
    // narrowed there is narrowed here, which is the direction that matters.
    //
    // No extra cost. Every predicate in this file already reads
    // `crmUsers/{uid}`, Firestore bills DISTINCT documents, and this is the same
    // document.
    function crmPermissions() {
      return get(/databases/$(database)/documents/crmUsers/$(request.auth.uid))
               .data.get('permissions', []);
    }

    // Does the caller hold this capability?
    //
    // The owner short-circuits on role rather than on the array. They do hold
    // every capability — `PERMISSIONS[Role.OWNER]` is `ALL_PERMISSIONS` — but an
    // owner document written before that table existed may carry an empty
    // `permissions`, and "the owner is locked out of the money screens" is not a
    // failure this file should be able to cause. Owner authority is positional.
    function hasPerm(p) {
      return isCrmUser() && (crmRole() == 'superadmin' || p in crmPermissions());
    }

    // ── Deciding, as distinct from doing ────────────────────────────────────
    //
    // `can_coin_operations` is held by finance_admin AND finance_member (and the
    // owner). That is right for the work — a member verifies a payment reference,
    // reconciles a float, reads the queue. It is not right for the MOMENT MONEY
    // MOVES: approving a recharge fires `onRechargeApproved`, which mints
    // diamonds into a buyer's balance and debits a seller's inventory.
    //
    // So a decision needs both halves: the capability, and the admin tier. This
    // mirrors what the API already does one layer up — `POST /coin-purchases`
    // carries `_COIN_OPS`, while `POST /coin-purchases/{id}/execute`, the call
    // that actually moves the coins, carries `require_owner` as well.
    //
    // Note what this CANNOT be satisfied by: a role name ending in _admin.
    // app_admin, ops_admin, support_admin and marketing_admin hold no
    // `can_coin_operations` in `roles.PERMISSIONS`, so they fail the first half;
    // finance_member holds it and fails the second.
    function canDecideCoinOps() {
      return isSuperAdmin()
          || (hasPerm('can_coin_operations') && crmRole() == 'finance_admin');
    }

    // ── Re-approval: fields a partner may not quietly change ─────────────────
    //
    // An approved partner used to be able to open "update your KYC and payment
    // details" and replace their bank account. The write set `kycStatus` to
    // 'submitted' and left `status` at 'approved' — and the review queue reads
    // `status`, so the row went on showing approved and nobody ever looked. The
    // new account number was live immediately, and a payout is a human reading
    // that number off the record and paying it. Approve once with clean
    // documents, then swap the destination: that is the hole.
    //
    // These fields therefore stop being directly writable by the partner. A
    // change is proposed into `pendingChanges` and the LIVE FIELD DOES NOT
    // MOVE, so money keeps going to the account somebody already verified while
    // the new one waits for review. Nobody is blocked from trading or earning
    // meanwhile, which matters because the honest case — replacing an expired
    // document — is the common one.
    //
    // Applying a pending change is a reviewer's act and runs server-side, where
    // it is audited. Nothing in this file lets a browser move these.
    function payoutFields() {
      return [
        'accountHolderName', 'accountNumber', 'bankAccount', 'ifscCode',
        'bankName', 'branch', 'upiId', 'binanceUid', 'paymentType', 'currency',
      ];
    }
    function identityFields() {
      // The documents, and the facts they are supposed to corroborate.
      return [
        // Agencies and hosts call them kycDocUrls; sellers call them idDocUrls.
        'kycDocUrls', 'idDocUrls', 'dob', 'country', 'address',
        'agencyName', 'displayName', 'hostName', 'ownerName',
        // Contact details are identity too: `activateHost` matches a referral
        // code against exactly this pair, so changing them changes who may
        // redeem an invitation. `ownerPhone` is how an agency document spells
        // its contact number, and it was missed on the first pass — an approved
        // agency could still rewrite it while `ownerName` beside it was locked.
        'phone', 'applicantPhone', 'ownerPhone',
        'email', 'applicantEmail', 'ownerEmail',
      ];
    }
    function reapprovalFields() {
      return payoutFields().concat(identityFields());
    }
    /** True when this write touches nothing that needs re-approval. */
    function touchesNoSensitiveField() {
      return !request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(reapprovalFields());
    }
    /**
     * A partner proposing a change: the pending block moves, live fields do
     * not. `kycStatus` moves with it so the dashboard can say "with a
     * reviewer", but it is not what the queue keys off.
     */
    function proposesChangeOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['pendingChanges', 'kycStatus', 'kycSubmittedAt'])
          && request.resource.data.get('kycStatus', '') == 'submitted'
          && proposalIsWellFormed();
    }

    /**
     * What may be INSIDE a proposal.
     *
     * Constraining the key and not the contents would have been a hole rather
     * than a control: `pendingChanges` was writable by the partner, so a seller
     * could park `{coinBalance: 999999}` or `{status: 'approved'}` in it, and a
     * reviewer clicking "apply" on what looked like a bank-account change would
     * have minted coin inventory. The applying services keep their own
     * allow-list — they are the authority, and they refuse anything outside it
     * — but a proposal that cannot be written is better than one that is merely
     * refused later, because nothing misleading ever reaches a reviewer's
     * screen.
     *
     * A proposal with no `fields` map at all is also refused: it would render
     * as an empty review with nothing to decide.
     */
    function proposalIsWellFormed() {
      return request.resource.data.pendingChanges.keys()
               .hasOnly(['fields', 'submittedAt', 'submittedBy', 'note', 'previousKycStatus'])
          && request.resource.data.pendingChanges.keys().hasAll(['fields'])
          && request.resource.data.pendingChanges.fields.keys()
               .hasOnly(reapprovalFields());
    }

    // Somebody using the Android app. Anyone signed in.
    //
    // This used to mean "signed in and holds no crmUsers document", on the
    // assumption that a CRM account and an app account are different people.
    // They are not. An agency owner and a coin seller each hold a crmUsers
    // document — with role 'agency' or 'seller', as isStaff() notes above —
    // AND each signs into the app, where AgencyDashboardScreen and
    // SellerDashboardScreen exist precisely for them. Under the old definition
    // every one of the 26 rules that gate on this refused them, so a partner
    // logging into the app got permission-denied on their own profile. Staff
    // were refused for the same reason, which made the app untestable from the
    // account that owns it.
    //
    // So this is now simply "signed in", and the interesting question moves to
    // where it belongs — the individual rule. Being an app user has never been
    // what authorises anything on its own: going live needs isVerifiedHost,
    // moving money needs a Cloud Function, and every ownership rule still
    // compares request.auth.uid to the document. Those are the checks doing the
    // work, and none of them care whether the caller also has a CRM login.
    //
    // WORTH KNOWING: a staff account acting in the app is an ordinary customer
    // as far as the ledger is concerned. It can hold a diamond balance, send
    // gifts and appear in revenue figures, so staff activity is real activity
    // and shows up in the reports. If that starts muddying the numbers, the
    // answer is a flag on the user document that the reports exclude, not a
    // rule that locks the owner out of the product.
    function isAppUser() {
      return request.auth != null;
    }

    // ── A ban that actually bans ─────────────────────────────────────────────
    //
    // `isBanned` was consulted in exactly ONE clause in this whole file —
    // `mayGoLive()`. Everywhere else a banned account was stopped only by the
    // app choosing to show it the banned screen, which is navigation, not
    // enforcement: anybody with the account's own credentials could hold a
    // valid token and keep writing comments, chat messages and presence rows.
    //
    // That became load-bearing when the app stopped signing banned users out.
    // It has to: the banned screen is where an appeal is written, and an appeal
    // is a write about the signed-in account — with no session there is no
    // appeal. Signing out never stopped anybody determined anyway, since they
    // re-authenticate at will. So the session stays and the SERVER stops them.
    //
    // ── The cost, stated ─────────────────────────────────────────────────────
    //
    // This is a `get()` — one document read per write it guards. That is why it
    // is applied to the writes that carry abuse (comments, chat, room presence)
    // and NOT to reads, to the appeal itself, or to anything on the user's own
    // document. A banned person must still be able to appeal, and must still be
    // able to read what was decided about them.
    function notBanned() {
      return request.auth != null
             && get(/databases/$(database)/documents/users/$(request.auth.uid))
                  .data.get('isBanned', false) != true;
    }

    // ── The displaced device ─────────────────────────────────────────────────
    //
    // ONE ACTIVE MOBILE SESSION PER ACCOUNT, enforced here rather than trusted.
    //
    // `users/{uid}.activeMobileSession.sessionId` was written by the server and
    // compared only by the Android client — its own splash screen and its own
    // listener. A patched client that ignored the listener kept writing from the
    // displaced handset indefinitely, because nothing on this side ever asked.
    //
    // A callable can be handed the session id and check it (see
    // `functions/src/mobileSession.ts`). A direct Firestore write cannot: there
    // is no field a client could present that it could not equally well forge.
    //
    // So the comparison is made against something the client does NOT choose.
    // `request.auth.token.auth_time` is stamped by Firebase at sign-in and does
    // not move when an ID token is refreshed. `startMobileSession` records
    // `credentialsValidAfter` a few seconds before the moment it ran. A token
    // minted by an EARLIER sign-in therefore carries an earlier `auth_time` and
    // fails this test; the device that just displaced it carries a later one and
    // passes.
    //
    // Firebase token revocation cannot do this job: `revokeRefreshTokens` is
    // scoped to the account, so it would kill the displacing device too. It is
    // the right tool for a ban, and it is used there.
    //
    // ── ABSENT MEANS ALLOWED, AND THAT IS THE MIGRATION ─────────────────────
    //
    // Every account that existed before this field did has no
    // `credentialsValidAfter`, and `get(..., 0)` returns 0, which every real
    // `auth_time` exceeds. Those accounts are unaffected until their next
    // sign-in stamps the field. The control therefore arrives per account as
    // people sign in, with no flag day and no possibility of locking out the
    // estate with one bad write.
    function sessionCurrent() {
      return request.auth != null
             && request.auth.token.auth_time >=
                get(/databases/$(database)/documents/users/$(request.auth.uid))
                  .data.get('credentialsValidAfter', 0);
    }

    /**
     * A signed-in app user who is not banned and holds the current session.
     *
     * The ordinary write gate. Both halves read the SAME document, so this is
     * one distinct document access, not two — Firestore bills distinct paths.
     */
    function isActiveAppUser() {
      return isAppUser() && notBanned() && sessionCurrent();
    }

    // Document owned by calling user
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ── Partner self-registration ────────────────────────────────────────────
    //
    // An agency or coin seller signing up creates their OWN crmUsers document,
    // because at that moment nobody else exists to create it for them. That is
    // the same shape as the superadmin bootstrap hole that was removed from this
    // file — so it is bound, hard, to a partner record that already names the
    // caller's verified email address. A stranger cannot satisfy it without a
    // real application having been filed under their address first.
    //
    // The common half: you may only write your own document, it must be
    // 'pending' so the account is inert until someone approves it, and you must
    // not already have one.
    function partnerSelfRegistration(uid) {
      return request.auth != null
          && request.auth.uid == uid
          && request.resource.data.get('status', '') == 'pending'
          && !exists(/databases/$(database)/documents/crmUsers/$(request.auth.uid));
    }

    // The binding half, for an agency. `source` covers both real origins: a
    // public application ('self_signup') and a sub-agency a parent agency
    // created from its dashboard ('agency_created'). Anything else — including
    // an agency record a stranger fabricated with some other source string —
    // does not qualify.
    function agencyNamesCaller(agencyId) {
      return exists(/databases/$(database)/documents/agencies/$(agencyId))
          && get(/databases/$(database)/documents/agencies/$(agencyId))
               .data.get('ownerEmail', '') == request.auth.token.email
          && get(/databases/$(database)/documents/agencies/$(agencyId))
               .data.get('source', '') in ['self_signup', 'agency_created'];
    }

    // The binding half, for a coin seller.
    function sellerNamesCaller(sellerId) {
      return exists(/databases/$(database)/documents/sellers/$(sellerId))
          && get(/databases/$(database)/documents/sellers/$(sellerId))
               .data.get('email', '') == request.auth.token.email;
    }

    // ── The second capability ────────────────────────────────────────────────
    //
    // An approved agency applying to also sell coins, or an approved coin
    // seller applying to also run an agency. One login, two businesses — and
    // underneath, two entirely separate partner records with their own
    // balances and their own ledgers. Nothing here merges anything.
    //
    // The application is a NEW partner document the applicant creates, carrying
    // `secondRoleOwnerUid: <their own uid>`. That single field is what the
    // capability claim on their crmUsers document is bound to, and it is only
    // ever writable at creation: no update clause on /agencies or /sellers
    // permits touching it, so it cannot be stamped onto a partner that already
    // exists and belongs to somebody else. A fabricated application therefore
    // names a record the fabricator created, which holds nothing — exactly the
    // footing a self-signup is already on.

    function agencySecondRoleNamesCaller(agencyId) {
      return agencyId is string
          && agencyId != ''
          && exists(/databases/$(database)/documents/agencies/$(agencyId))
          && get(/databases/$(database)/documents/agencies/$(agencyId))
               .data.get('secondRoleOwnerUid', '') == request.auth.uid;
    }

    function sellerSecondRoleNamesCaller(sellerId) {
      return sellerId is string
          && sellerId != ''
          && exists(/databases/$(database)/documents/sellers/$(sellerId))
          && get(/databases/$(database)/documents/sellers/$(sellerId))
               .data.get('secondRoleOwnerUid', '') == request.auth.uid;
    }

    // "This login is not linked to a partner record of that kind yet."
    // A field that was never written and one written as an explicit null mean
    // the same thing here, and both occur: the self-signup helpers omit the
    // other kind's id entirely, while createCrmUser writes nulls. Both are
    // spelled out so a staff-created partner account can still apply.
    function unlinked(value) {
      return value == '' || value == null;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // DEVICE BANS — checked before login (no auth required)
    // ══════════════════════════════════════════════════════════════════════════
    match /bannedDevices/{deviceId} {
      /*
       * Readable by one document id at a time, not as a list.
       *
       * This was `allow read: if true` — unauthenticated, and `get` and `list`
       * are the same permission in Firestore, so the entire ban list was
       * enumerable by anybody who could reach the project. That is a register
       * of who has been thrown off the platform.
       *
       * The app still has to ask "is THIS device banned?" before anybody signs
       * in, and at that moment there is no auth token to check — so the single
       * document read stays open. `request.auth == null || request.auth != null`
       * cannot express "get but not list", so the list is closed by requiring
       * staff for any query, below.
       */
      allow get:   if true;
      allow list:  if isOps();
      allow write: if isOps();
    }

    /*
     * QUICK-LOGIN TOKENS — server-only, in both directions.
     *
     * Each document id is `sha256(secret)` and the document names a uid. That
     * makes the collection a list of keys to accounts, so:
     *
     *   * READ is closed to everyone including the owner. A client that could
     *     read it could enumerate uids, and a client that could read its own
     *     row learns nothing it does not already hold.
     *   * WRITE is closed because a client that could write one could issue
     *     itself a key to any account by naming any uid.
     *
     * `mintQuickLoginToken`, `redeemQuickLogin` and `revokeQuickLogin` use the
     * Admin SDK, which is not subject to these rules. Not even ops gets a hand
     * here — there is nothing an operator could usefully do with a credential
     * store, and plenty they could do by accident.
     */
    match /quickLoginTokens/{tokenHash} {
      allow read, write: if false;
    }

    // ── The rest of the quick-login machinery, equally closed ────────────────
    //
    // Three collections written only by `functions/src/quickLogin.ts` through
    // the Admin SDK, which bypasses this file. A client has no business reading
    // or writing any of them, and saying so costs the server nothing.
    //
    //   quickLoginChallenges  the nonce a device signs to prove it is the one
    //                         the credential was minted on. A client that could
    //                         read these could pre-sign; one that could write
    //                         them could choose its own challenge, and the
    //                         signature would prove nothing at all.
    //
    //   quickLoginRate        failure counts and cool-offs. Writable by the
    //                         caller, it would be a rate limit anyone could
    //                         reset between guesses.
    //
    //   authEvents            the authentication audit trail. The append-only
    //                         business log is MongoDB and a Cloud Function
    //                         cannot reach it, so these land here instead —
    //                         and a trail the subject can edit is not a trail.
    match /quickLoginChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /quickLoginRate/{bindingHash} {
      allow read, write: if false;
    }

    match /authEvents/{eventId} {
      allow read:  if isStaff();
      allow write: if false;
    }

    /*
     * WHICH GUEST ACCOUNT BELONGS TO WHICH DEVICE.
     *
     * Closed to everybody, and this one has to be. The document holds the uid
     * of a guest account keyed by a device id, so `list` access would be a
     * ready-made map from device to account; and `write` access would let a
     * client point its own device id at somebody else's guest uid, or replace
     * the secret hash guarding its own. `claimGuestIdentity` is the only thing
     * that touches this, through the Admin SDK, which these rules do not apply
     * to.
     *
     * Not readable by staff either. A device id is not a support tool — nobody
     * in the CRM has a reason to resolve one to an account, and the ban list
     * already shows the device side of it.
     */
    match /guestDeviceBindings/{deviceId} {
      allow read, write: if false;
    }

    /*
     * The record of "these two accounts were the same person, this one was
     * kept". Written by `resolveIdentityConflict`; read by staff when somebody
     * asks why their old account vanished.
     */
    match /identityResolutions/{id} {
      allow read:  if isStaff();
      allow write: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // VERIFIED IDENTITIES — role cross-check on Android login
    // ══════════════════════════════════════════════════════════════════════════
    match /verifiedIdentities/{docId} {
      // Was readable by every signed-in app user, because AuthRepository
      // queried it on each login to work out its own roles. That made the list
      // of who is staff, an agency owner or a coin seller — joined to their
      // phone numbers and email addresses — a two-line query for any account.
      //
      // `syncMyRoles` does that lookup server-side now, against the phone and
      // email on the caller's own auth token.
      allow read:  if isStaff();
      // isStaff(), not isCrmUser(): identity verification is an internal decision.
      // isCrmUser() included every agency and coin seller, who could then vouch
      // for whoever they liked.
      allow write: if isStaff();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // CRM TEAM ACCOUNTS
    // ══════════════════════════════════════════════════════════════════════════
    match /crmUsers/{uid} {
      // Staff read the team list. Agencies and sellers hold crmUsers documents too
      // (role 'agency' / 'seller'), so isCrmUser() here would have handed every
      // external partner the name, email and phone of every member of staff. They
      // get their own record and nothing else.
      allow read:   if isStaff() || isOwner(uid);

      // NOTE — nothing in the browser creates a staff account any more.
      //   /team used to, through `createCrmUser` in zipper-crm/lib/auth.ts, and
      //   that wrote this document and nothing else. A staff account is two
      //   records: this one, and a Mongo `staff` row the API authorises against.
      //   An account with only this half opens the CRM shell and then fails on
      //   every API-backed screen. Both halves are now written by
      //   `POST /staff` through the Admin SDK, which bypasses these rules —
      //   see backend/app/services/crm_directory.py.
      //
      //   The `isSuperAdmin()` clause below is deliberately left in place as a
      //   backstop rather than removed. It grants nothing that was not already
      //   granted, and with no caller it is now dead weight in the safe
      //   direction: if something in the browser ever reaches for this write
      //   again, only a superadmin gets it, and the API's own rule — a team
      //   admin may create members of their own team, and only those — is the
      //   one that actually decides who may create staff.
      //
      // Normal path: superadmin creates team members.
      //
      // THE BOOTSTRAP CLAUSE HAS BEEN REMOVED — DO NOT PUT IT BACK.
      //   It allowed any authenticated user to create their own crmUsers document
      //   with role 'superadmin' as long as they did not already have one. Since
      //   /agency-signup and /seller-signup call createUserWithEmailAndPassword
      //   against this project, and the web API key ships in the browser bundle,
      //   ANY stranger could self-issue superadmin — which in these rules means
      //   bank credentials, seller balances, approvals and staff deletion.
      //   Staff accounts are provisioned by backend/scripts/seed_accounts.py using
      //   the Admin SDK, which bypasses these rules entirely, so no in-browser
      //   bootstrap path is needed and none should ever exist.
      //
      // Partner self-registration: an agency or coin seller signing up, and a
      //   sub-agency login created from a parent agency's dashboard. All three
      //   write the document with the NEW user's own token — the sub-agency case
      //   uses a secondary Firebase app — so the creator cannot be checked
      //   directly. Each is bound instead to a partner record that already names
      //   this caller's verified email. See partnerSelfRegistration(),
      //   agencyNamesCaller() and sellerNamesCaller() at the top of this file.
      //
      //   Role is pinned to 'agency' or 'seller' and status to 'pending'. Neither
      //   path can mint staff, and neither account does anything until it is
      //   approved.
      allow create: if isSuperAdmin()
                    || (partnerSelfRegistration(uid)
                        && request.resource.data.role == 'agency'
                        && request.resource.data.get('createdBy', '')
                             in ['self_signup', 'agency_created']
                        && agencyNamesCaller(request.resource.data.agencyId))
                    || (partnerSelfRegistration(uid)
                        && request.resource.data.role == 'seller'
                        && request.resource.data.get('createdBy', '') == 'self_signup'
                        && sellerNamesCaller(request.resource.data.sellerId));

      allow update: if isSuperAdmin()
                    || (isCrmUser() && request.auth.uid == uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['lastLoginAt']))
                    // ── Your own contact details, and nothing else ────────────
                    //
                    // /profile lets every person in the CRM — staff, agency and
                    // coin seller — keep their own contact details current
                    // without filing a ticket. These five fields are personal
                    // preference, not business fact: they say how to reach the
                    // person, and nothing anywhere in this file, in the API or
                    // in the Android app reads any of them to decide what
                    // somebody may do.
                    //
                    // ALLOW-LIST, NOT A DENY-LIST, and it must stay one. A
                    // deny-list would silently admit every field added to this
                    // collection in future, and the fields on a crmUsers
                    // document are the ones that decide access to money:
                    // `role`, `roles` and `roleStatus` are what crmRole(),
                    // isStaff(), isAdmin(), isSuperAdmin() and
                    // isAgencyCrmUser() read; `agencyId` and `sellerId` are
                    // what bind a login to a partner record and its balance;
                    // `status`, `isActive` and `permissions` are the approval
                    // and the capability set. NONE of them appears below, so
                    // this clause cannot change what its caller may reach — it
                    // can only change how to phone them.
                    //
                    // Also deliberately absent:
                    //   name         the roster name. Authoritative in the Mongo
                    //                `staff` row and in every audit entry that
                    //                names the person; a self-edit here would
                    //                put the two out of step. `displayName` is
                    //                the one they own.
                    //   email        the sign-in address, and the binding that
                    //                agencyNamesCaller()/sellerNamesCaller()
                    //                match a partner application against.
                    //   crmId        written once, by the API, and printed as
                    //                the person's identifier.
                    //   dept, fieldCharge, reportsTo, gateAnswers
                    //                business facts and security answers, set by
                    //                an owner or a department admin through the
                    //                API, never by their holder.
                    //
                    // A superadmin still reaches all of this through the first
                    // clause above; this adds one narrow self-service path and
                    // widens nothing else.
                    || (isOwner(uid)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['displayName', 'phone', 'personalEmail',
                                       'address', 'photoUrl']))
                    // Admin can approve/reject agency or seller accounts (status field only)
                    || (isAdmin()
                        && resource.data.role in ['agency', 'seller']
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status']))
                    // ── Applying for the second capability ──────────────────
                    //
                    // An approved agency asking to also sell coins, or a coin
                    // seller asking to also run an agency. This is the ONE
                    // thing a partner may ever write about their own roles, and
                    // it is bound as hard as the self-registration clause above:
                    //
                    //   * `roles` may contain NOTHING but 'agency' and 'seller'.
                    //     No staff role can be minted here, and in any case
                    //     nothing in this file reads `roles` except
                    //     isAgencyCrmUser() — which is paired with
                    //     crmUserAgencyId() everywhere it is used.
                    //   * `role` and `status` are not in affectedKeys, so the
                    //     capability the account was created with cannot be
                    //     changed and neither can its approval.
                    //   * the new capability must be recorded 'pending'. Only
                    //     the backend, through the Admin SDK, ever writes
                    //     'approved' — after a staff member approves the partner
                    //     record with a mandatory reason, in the audit log.
                    //     There is no path from here to an approved capability.
                    //   * the link field must have been EMPTY, so this works
                    //     once and cannot later be repointed at somebody else's
                    //     agency or seller.
                    //   * the record it points at must name this caller in
                    //     `secondRoleOwnerUid` — see the two binding functions
                    //     at the top of this file.
                    || (isOwner(uid)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['roles', 'roleStatus', 'sellerId'])
                        && request.resource.data.get('roles', []).hasOnly(['agency', 'seller'])
                        && request.resource.data.get('roleStatus', {}).get('seller', '') == 'pending'
                        && unlinked(resource.data.get('sellerId', ''))
                        && sellerSecondRoleNamesCaller(request.resource.data.get('sellerId', '')))
                    || (isOwner(uid)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['roles', 'roleStatus', 'agencyId'])
                        && request.resource.data.get('roles', []).hasOnly(['agency', 'seller'])
                        && request.resource.data.get('roleStatus', {}).get('agency', '') == 'pending'
                        && unlinked(resource.data.get('agencyId', ''))
                        && agencySecondRoleNamesCaller(request.resource.data.get('agencyId', '')));
      allow delete: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // AGENCIES (main and sub)
    // ══════════════════════════════════════════════════════════════════════════
    // type: "main" | "sub"
    // parentAgencyId: null for main, agencyId for sub
    // status: "pending" | "approved" | "rejected"
    match /agencies/{agencyId} {
      // Approved main agencies can read their own doc + sub-agency docs
      // Sub-agencies can read their own doc only
      // CRM agency role users can read their own linked agency doc + its sub-agencies
      //
      // .get(field, default) everywhere, not bare field access. Reading a field
      // that is absent RAISES in the rules language, which denies the whole
      // request rather than evaluating false — and agencies filed through the
      // public signup form carry no `ownerUid` and no `parentAgencyId` at all.
      // Bare access here would have made a main agency unable to read its own
      // record.
      //
      // The two agency-portal clauses used to be written separately, as
      // `(isAgencyCrmUser() && ownAgency) || (isAgencyCrmUser() && itsParent)`.
      // They are folded into one `A && (B || C)` here — identical in meaning,
      // and it halves the document reads this clause makes. That matters now:
      // isAgencyCrmUser() reads one extra field for a login that holds two
      // capabilities, and this rule was the heaviest caller of it. Folded, the
      // worst case is seven accesses against a single document.
      allow read: if isAdmin()
                  || (isAgencyCrmUser()
                      && (crmUserAgencyId() == agencyId
                          || crmUserAgencyId() == resource.data.get('parentAgencyId', '')))
                  || (request.auth != null
                      && (resource.data.get('ownerUid', '') == request.auth.uid
                          || resource.data.get('parentAgencyId', '') == request.auth.uid))
                  // The applicant, matched on their verified email. A public
                  // signup has no uid on the record — it is written before the
                  // account exists — so without this the applicant could not
                  // read back the application they just filed.
                  || (request.auth != null
                      && resource.data.get('ownerEmail', '') == request.auth.token.email);

      // CRM admin registers on behalf, OR authenticated app user self-registers,
      // OR CRM agency user creates a sub-agency,
      // OR unauthenticated user submits via the public signup form
      allow create: if isCrmUser()
                    || (isAppUser()
                        && request.resource.data.kycStatus == 'pending'
                        && request.resource.data.isActive == false)
                    || (request.auth == null
                        && request.resource.data.kycStatus == 'pending'
                        && request.resource.data.isActive == false
                        && request.resource.data.source == 'self_signup');

      // Owner can update their own doc (KYC, bank details) — both app user and CRM agency role
      // Admin approves/rejects
      // An agency edits its own record, but a bank account or a KYC document is
      // PROPOSED rather than written — see reapprovalFields() above. The
      // ordinary-edit clause keeps working for everything else (description,
      // city, and so on); the second clause is the proposal.
      //
      // A record still awaiting its first decision is exempt: there is no
      // approved bank account to protect yet, and forcing a proposal flow
      // before anyone has ever looked would just add a step.
      allow update: if isAdmin()
                    || (isAgencyCrmUser() && crmUserAgencyId() == agencyId
                        && !request.resource.data.diff(resource.data)
                              .affectedKeys().hasAny(['status', 'approvedBy', 'approvedAt', 'isActive'])
                        && (touchesNoSensitiveField()
                            || resource.data.get('status', '') == 'pending'))
                    || (isAgencyCrmUser() && crmUserAgencyId() == agencyId
                        && proposesChangeOnly())
                    || (isAppUser()
                        && resource.data.get('ownerUid', '') == request.auth.uid
                        && resource.data.get('status', '') == 'pending'
                        && !request.resource.data.diff(resource.data)
                              .affectedKeys().hasAny(['status', 'approvedBy', 'approvedAt']))
                    // The applicant writing the `crmUid` back-link immediately
                    // after their account is created. Matched on the verified
                    // email because the record predates the account, and pinned
                    // to that one field so it cannot become an edit of anything
                    // else.
                    || (request.auth != null
                        && resource.data.get('ownerEmail', '') == request.auth.token.email
                        && resource.data.get('status', '') == 'pending'
                        && request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly(['crmUid']));

      allow delete: if isSuperAdmin();

      // ── Agency hosts (list of host uids under this agency) ────────────────
      match /agencyHosts/{hostUid} {
        // Agency owner + CRM agency role user + sub-agency owners can read
        allow read: if isAdmin()
                    || (isAgencyCrmUser() && crmUserAgencyId() == agencyId)
                    || (request.auth != null
                        && (get(/databases/$(database)/documents/agencies/$(agencyId)).data.ownerUid
                              == request.auth.uid));
        // Server-written: `hosts.ts`, `index.ts` and `services/users.py` maintain
        // this roster through the Admin SDK, which bypasses this file. Every
        // other reference is a read — `AgencyDashboardScreen` lists it.
        //
        // It decides WHICH AGENCY EARNS ON WHICH HOST. Adding a row moves a
        // host's commission to a different agency, and `isAdmin()` let any
        // `.*_admin` do it from a browser. The server loses nothing by this
        // being closed, because it never needed the clause.
        allow write: if false;
      }

      // ── Commission ledger (payment history for this agency) ───────────────
      //
      // The record of what an agency has been paid. No writer anywhere in the
      // four codebases — not a function, not a route, not the CRM, not the app —
      // so the write clause described no behaviour and granted a forgery
      // surface over a payment history. Reads unchanged.
      match /commissionLedger/{entryId} {
        allow read:  if isAdmin()
                     || (isAgencyCrmUser() && crmUserAgencyId() == agencyId)
                     || (request.auth != null
                         && get(/databases/$(database)/documents/agencies/$(agencyId)).data.ownerUid
                              == request.auth.uid);
        allow write: if false;
      }
    }

    // ══════════════════════════════════════════════════════════════════════════
    // HOST APPLICATIONS (referral-code based host registration)
    // ══════════════════════════════════════════════════════════════════════════
    match /hostApplications/{docId} {
      // Was readable by every signed-in account. These documents carry the
      // host's bank details, date of birth and KYC document URLs — one query
      // from any app user returned all of it for every host on the platform.
      //
      // The app needs exactly one thing from here: whether a referral code is
      // valid. `activateHost` answers that server-side now, so the app does not
      // read this collection at all.
      // An agency reads its OWN invitations — and nothing stopped that being
      // true except an oversight. The agency dashboard queries
      // `where('agencyId', '==', myAgencyId)` to show who is pending, approved
      // or rejected, and an agency is not isStaff() and has no
      // `activatedByUid`, so every one of those reads was refused. The panel
      // was not empty because there was nothing to show; it was empty because
      // it was never allowed to look.
      //
      // Matched on document DATA, not on a path wildcard, which is what makes
      // it work for a list query: the rule has to be satisfiable by every
      // document the query returns, and `agencyId` is exactly what the query
      // filters on.
      //
      // The sensitive fields here — bank account, date of birth, KYC document
      // URLs — belong to a host this agency recruited and itself entered. This
      // returns their own records to them, not anybody else's.
      allow read:   if isStaff()
                    || (isAgencyCrmUser()
                        && resource.data.get('agencyId', '') == crmUserAgencyId())
                    || (request.auth != null
                        && resource.data.get('activatedByUid', '') == request.auth.uid);
      // CRM (admin/agency) creates invitations; app users activate them
      allow create: if isCrmUser() || isAppUser();
      // A host's bank account is changed by STAFF here, not by the host — they
      // have no CRM dashboard of their own — so the control that fits is
      // four-eyes rather than a partner-facing proposal flow. An admin may
      // propose a change to payout or identity details; only a superadmin may
      // write one straight onto the record. Proposer and approver are then two
      // different people, which is the point: a single ops_admin should not be
      // able to redirect a host's earnings on their own authority.
      //
      // Everything that is not a re-approval field — call rate, notes, the
      // status fields — is unchanged and still admin-writable.
      allow update: if (isAdmin() && (touchesNoSensitiveField() || isSuperAdmin()))
                    || (isAdmin() && proposesChangeOnly())
                    || (isAgencyCrmUser()
                        && resource.data.get('agencyId', '') == crmUserAgencyId()
                        && proposesChangeOnly())
                    || (isAppUser()
                        && resource.data.applicantUid == request.auth.uid
                        && !request.resource.data.diff(resource.data)
                              .affectedKeys().hasAny(['isActivated', 'activatedByUid'])
                        && touchesNoSensitiveField());
                    /*
                     * ── REMOVED: the client-side activation clause ───────────
                     *
                     * It read:
                     *
                     *     || (isAppUser()
                     *         && request.resource.data.diff(resource.data)
                     *              .affectedKeys().hasOnly(['isActivated','activatedByUid']))
                     *
                     * with no binding to WHOSE invitation it was and no check on
                     * whether it had already been used. So any signed-in account
                     * could write `{isActivated: true, activatedByUid: <self>}`
                     * onto ANY host application — and the read clause above
                     * admits `activatedByUid == request.auth.uid`, so that one
                     * write also handed them the bank details, date of birth and
                     * KYC document URLs the comment at the top of this block
                     * exists to protect.
                     *
                     * It bypassed every check in `activateHost`: the referral
                     * code, the phone and email match against the agency's
                     * invitation, the approved-status gate, the already-used
                     * gate, the restriction check and the one-host-one-agency
                     * rule. They could not grant themselves `users.isHost` —
                     * that is on `ownerProtectedFields()` — so the gain was a
                     * stranger's KYC documents and a burnt invitation rather
                     * than host status. Both are enough.
                     *
                     * `activateHost` is the only writer now. It runs with the
                     * Admin SDK, which these rules do not apply to.
                     */
      // An agency may withdraw its OWN invitation while it is still pending and
      // the host has not yet used the code.
      //
      // Needed because the invitation is written before the approval request
      // that accompanies it, and the two cannot be one atomic batch — the
      // approval rule reads the invitation back with get(), which inside a
      // batch would not yet exist. So when the second write fails the dashboard
      // deletes the first, and without this rule that cleanup was itself
      // refused and the orphan stayed for ever.
      //
      // Bounded to their own agency, still pending, and never activated: an
      // invitation the host has already redeemed is a record of something that
      // happened and is not the agency's to erase.
      allow delete: if isAdmin()
                    || (isAgencyCrmUser()
                        && resource.data.get('agencyId', '') == crmUserAgencyId()
                        && resource.data.get('status', '') == 'pending'
                        && resource.data.get('isActivated', false) != true);
    }

    // ══════════════════════════════════════════════════════════════════════════
    // USERS (app user profiles)
    // ══════════════════════════════════════════════════════════════════════════
    // ── publicProfiles ──────────────────────────────────────────────────────
    //
    // What one user may see about another: name, photo, bio, age, country,
    // presence, level, badges, and the facets the feed filters on. Nothing
    // else.
    //
    // `users/{uid}` is still readable below, because the profile screen, chat
    // and the live room all still read it. That is the next thing to close:
    // every one of them should read this instead, and then the user document
    // becomes owner-and-staff only. Until then this collection is the safe
    // surface, not the only one.
    //
    // Write-only by the syncPublicProfile trigger. A user who could write their
    // own projection could set `presenceRank` to 40 and sit at the top of
    // everybody's feed permanently, or flip `isVerifiedHost` for the badge.
    //
    // The paragraph above said exactly that and then wrote `allow write: if
    // isAdmin()`, which does not follow from it. `syncPublicProfile`,
    // `hostStats.ts` and `accounts.ts` write this through the Admin SDK, and the
    // Admin SDK BYPASSES this file — so the clause granted nothing to the server
    // and everything to a browser held by any `.*_admin`, marketing included.
    // Every other reference to this collection, in the app and the CRM, is a
    // read. Closing it costs the server nothing and removes the attack the
    // comment describes.
    match /publicProfiles/{uid} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    match /users/{uid} {
      /*
       * ── GET IS OPEN, LIST IS NOT ───────────────────────────────────────────
       *
       * This was `allow read: if request.auth != null`, and `read` is `get` plus
       * `list`. The `list` half made the collection a directory: one throwaway
       * guest account could page the whole of `users` and walk away with every
       * address, phone number, device id, balance, ban reason and `crmRole` on
       * the platform. Nothing legitimate needed it — see below — so it was a
       * standing export of the user base with no attacker skill required.
       *
       * `get` stays open because the product is built on it. A chat header, a
       * call screen, a live room's participant strip and a party seat all fetch
       * one known uid to render a name and a photograph. Those are single-
       * document reads of somebody the reader is already interacting with.
       *
       * Field-level rules do not exist in Firestore, so `get` still returns the
       * whole document to whoever asks for a specific uid. The projection that
       * fixes that properly is `publicProfiles/{uid}`, which the feed, the
       * discover list and the other-user profile screen already read instead —
       * migrating the remaining single-document fetches to it is the next step
       * and does not belong in a rules change.
       *
       * What `list` cost, and why nothing broke:
       *   * The CRM's user list, search and analytics pages all query this
       *     collection — and they run as staff, which `isStaff()` admits.
       *   * The Android app never queries it. Every app read is
       *     `.document(uid)`; the feed uses `publicProfiles`. The one exception
       *     is the client-side "is this email already taken" pre-check in
       *     `AuthRepository.saveUserProfile`, which is already wrapped in a
       *     best-effort try/catch and whose authoritative answer is
       *     `bindVerifiedIdentity` refusing the bind. Losing it removes a
       *     duplicate of a server decision — and that pre-check was itself a
       *     small enumeration oracle.
       */
      allow get:    if request.auth != null;
      allow list:   if isStaff();
      allow delete: if isOwner(uid) || isAdmin();

      // Registration writes the profile, not a balance. Without this a new
      // account could be created holding any number of diamonds — the update
      // rule below would then be irrelevant, because the money is already
      // there before the first update ever happens.
      allow create: if isAdmin()
          || (isOwner(uid)
              && !request.resource.data.keys().hasAny([
                   'diamonds', 'beans', 'beansAvailable', 'totalBeansEarned',
                   'totalGemsSpent', 'coinBalance', 'videoCards', 'totalXp',
                   'level', 'hostLevel', 'isVerifiedHost', 'payoutHold',
                   'isBanned', 'isHost', 'isSeller', 'agencyId', 'role',
                 ]));

      // ── Balance writes: nobody writes money from a client ───────────────────
      //
      // Every balance change now happens in a Cloud Function, which uses the
      // Admin SDK and bypasses these rules entirely. So the rules can say the
      // true thing: no client, owner or otherwise, may move money.
      //
      // What this replaces:
      //
      //   `isOwner(uid)` used to be an unconditional allow. A user could set
      //   their own `diamonds` to any number from a console, because the app
      //   credited daily rewards, bean conversion, bag refunds and gaming wins
      //   client-side and the rule had to permit it.
      //
      //   The cross-user clause let ANY signed-in account increment ANY other
      //   account's `beans`. It existed because the sender's device credited
      //   the receiver when a gift was sent. Now settleGift does, so this is
      //   gone — it was, in effect, a public endpoint for minting host
      //   earnings, and therefore payouts.
      //
      // Staff still cannot touch balances from a browser: balance changes go
      // through POST /api/users/{uid}/balance-request, which raises a card, and
      // the backend moves the money with the Admin SDK. Everything else about a
      // user (bans, warnings, host flag, agency link) stays staff-editable.
      //
      // The owner list is a DENYLIST rather than an allowlist on purpose. An
      // allowlist silently breaks a profile field the day someone adds one; a
      // denylist fails loudly in exactly the case that matters, and the case
      // that matters is enumerable.
      function ownerProtectedFields() {
        return [
          // Money.
          'diamonds', 'beans', 'beansAvailable', 'totalBeansEarned',
          'totalGemsSpent', 'coinBalance', 'videoCards',
          // Progression — derived from spend and earnings, never declared.
          'totalXp', 'level', 'hostLevel', 'hostCallEarnings', 'hostGiftEarnings',
          // Daily reward state. Owned by claimDailyReward, in IST, server-side.
          'dailyStreak', 'lastDailyClaimDate',
          // Trust and status. A user must not be able to verify themselves,
          // lift their own payout hold, unban themselves, or become a host.
          'isVerifiedHost', 'payoutHold', 'isBanned', 'isHost', 'isSeller',
          'agencyId', 'role',
          // The price of a minute of this host's time. See the note below the
          // list: the ceiling depends on the host's level, a rule cannot read
          // the level ladder, and setCallRate can.
          'callRateBeans',
          // Counters other people's actions produce.
          'totalGiftsReceived', 'totalGiftsSent', 'totalLikesReceived',
          'totalLikesGiven',
          // Badges and roles. syncMyRoles grants these; a user does not.
          'isOfficial', 'isAgent', 'crmRole', 'wealthLevel',
          // Presence that ranks the feed. isLive is derived from the live room
          // by syncLivePresence; a self-declared isLive was a free top slot.
          'isLive', 'isInCall', 'isInParty',
          // Leaderboards and statistics the server derives.
          'topSupporters', 'topHosts', 'streamedTimeSeconds', 'hasRecharged',
          // Moderation and identity. banReason is written by staff; referralCode
          // belongs to partners, not users.
          'banReason', 'referralCode',
          /*
           * Which cosmetic is worn. These are PAID GOODS.
           *
           * They were owner-writable, and nothing cross-checked `ownedItems`,
           * so the whole timed-cosmetic economy was optional: write
           * `equippedEntrance` to any item id and wear it without buying it.
           * `expireCosmetics` clears the pointer every hour when the term runs
           * out, and the client could simply write it back — a cosmetic that
           * flickered off and on, unpaid, forever.
           *
           * `equipBagItem` now owns these. It checks the item is owned and
           * unexpired, which is a question a rule cannot ask (it needs a lookup
           * in a sibling subcollection plus a time comparison).
           */
          'equippedFrame', 'equippedChatBubble', 'equippedProfileCard',
          'equippedIdFrame', 'equippedEntrance',
          /*
           * Which device holds the one active mobile session.
           *
           * This was client-written, and that made the one-device rule a
           * request rather than a rule: a patched app could decline to write it
           * and keep two phones signed in for ever, or write somebody else's
           * session id and take their place. `startMobileSession` owns it now.
           *
           * `sessionToken` is the old single-string form of the same thing,
           * still written for one release so phones on the previous build keep
           * getting kicked correctly.
           */
          'activeMobileSession', 'sessionToken',
          /*
           * The displacement cut-off `sessionCurrent()` compares `auth_time`
           * against. An account that could write this could set it to 0 and
           * re-admit every device it has ever been signed in on — which is the
           * entire control, handed to the one party it is aimed at.
           */
          'credentialsValidAfter',
          /*
           * Which state the account is in. Written by the deletion, recovery
           * and purge paths only — a client that could set
           * `accountState: 'active'` could undo its own deletion and, worse,
           * reclaim an identity the binding rules had already released.
           */
          'accountState', 'deletionRequestedAt', 'deletionDueAt', 'purgedAt',
          /** The normalised phone, maintained by the syncPhoneKey trigger. */
          'phoneKey',
          /*
           * Moderation state. ALL of this was self-writable, which made three
           * separate holes:
           *
           *   `isSuspended` / `suspendedUntil` — a suspended account could
           *   clear its own suspension flag. It stayed barred by `isBanned`,
           *   but it silently dropped out of `lift_expired_suspensions`'s
           *   query, so the sweep could never end the suspension and the CRM
           *   showed it as active.
           *
           *   `deviceId` — the WORST of the three. `ban_user` bans whatever
           *   device id is on the account, so somebody expecting a ban could
           *   write a fabricated id and have the cascade ban a handset that
           *   does not exist, leaving their real phone clean.
           *
           *   `accountState` — the state machine itself.
           */
          'isSuspended', 'suspendedUntil', 'suspensionDays', 'deviceId',
          'accountState',
          'bannedBy', 'bannedByName', 'bannedByRole', 'bannedAt',
          'unbannedBy', 'unbannedByName', 'unbannedByRole', 'unbannedAt',
          // Suspend and resume stamp their own actor fields rather than
          // reusing the ban ones, so a suspension is distinguishable from a
          // ban in the record. They need protecting for the same reason.
          'suspendedBy', 'suspendedByName', 'suspendedByRole', 'suspendedAt',
          'resumedBy', 'resumedByName', 'resumedByRole', 'resumedAt',
          'previousBanReason', 'warningCount',
        ];
      }

      /*
       * What a STAFF account may not write on somebody else's user document.
       *
       * ── THIS USED TO BE MONEY ONLY, AND THAT WAS A HOLE ────────────────────
       *
       * The list was the ten money fields and nothing else, on the reasoning
       * that only balances were worth protecting from the people who administer
       * the platform. Everything else on `ownerProtectedFields()` — sixty-odd
       * fields the SUBJECT cannot write — was writable by any account
       * `isStaff()` admits, which is every department role down to
       * `marketing_member` and `support_member`, plus the legacy strings
       * 'admin', 'ops', 'tech', 'finance' and 'support'.
       *
       * From a browser console, on any `users/{uid}` including their own, that
       * meant:
       *
       *   `isBanned` / `isSuspended` / `accountState` — clear a ban outright.
       *   Not "lift it": BYPASS it. `ban_user` in the API bars every device the
       *   account has used, preserves manual device bans, and writes an audit
       *   entry naming who did it. A direct write does none of that, so the
       *   account walks back in with its device bans still attached to nothing
       *   and no record that anyone intervened.
       *
       *   `crmRole` / `isOfficial` / `isAgent` — grant yourself the OWNER badge
       *   in the app. It confers no CRM or API authority (those read
       *   `crmUsers/{uid}` and Mongo `staff`), but it is the badge every user
       *   in the product is taught to trust.
       *
       *   `deviceId` — point somebody else's ban cascade at a handset that does
       *   not exist.
       *
       *   `activeMobileSession` / `sessionToken` — take over, or quietly keep,
       *   a session the one-device rule was supposed to end.
       *
       *   `phoneKey` / `email` / `phoneNumber` — move an identity between
       *   accounts, behind the back of the three-case binding rule.
       *
       *   the five `equipped*` pointers — wear paid cosmetics without buying
       *   them, which `equipBagItem` exists to prevent.
       *
       * ── WHY THE LIST IS SPELLED OUT RATHER THAN DERIVED ────────────────────
       *
       * `ownerProtectedFields()` and this one overlap heavily and the obvious
       * move is to concat one into the other. They are written out separately
       * on purpose: they answer different questions and they are NOT the same
       * set. Staff legitimately write several fields the subject may not —
       * `isHost`, `isSeller`, `agencyId`, `warnings`, `isOnline`, `level` —
       * because `lib/firestore.ts` writes exactly those from the CRM browser
       * (`makeHost`, `removeHost`, `setSeller`, `warnUser`). Deriving one list
       * from the other would either break those screens or quietly re-open a
       * hole the next time somebody adds a field.
       *
       * The rule for anything added here later: if a Cloud Function or the
       * Python API is the thing that writes it, it belongs on this list.
       */
      function staffProtectedFields() {
        return [
          // Money. The original list, unchanged.
          'diamonds', 'beans', 'beansAvailable', 'totalBeansEarned',
          'totalGemsSpent', 'totalXp', 'coinBalance',
          'videoCards', 'hostCallEarnings', 'hostGiftEarnings',

          // Role and badge. Written by `syncMyRoles` and `_attach_app_identity`,
          // both Admin SDK. No client has ever needed to write these.
          'crmRole', 'isOfficial', 'isAgent',

          // Moderation state and its audit trail. The ONLY path is
          // POST /users/{uid}/{ban,suspend,resume,unban}, which authorises the
          // actor, cascades device bans, preserves manual bans and writes the
          // audit entry. A direct write is that path with every safeguard
          // removed.
          'isBanned', 'banReason', 'previousBanReason',
          'isSuspended', 'suspendedUntil', 'suspensionDays',
          'bannedBy', 'bannedByName', 'bannedByRole', 'bannedAt',
          'unbannedBy', 'unbannedByName', 'unbannedByRole', 'unbannedAt',
          'suspendedBy', 'suspendedByName', 'suspendedByRole', 'suspendedAt',
          'resumedBy', 'resumedByName', 'resumedByRole', 'resumedAt',

          // The deletion state machine. `accountState` decides whether an
          // identity has been RELEASED, so a hand-written one can reclaim a
          // phone number the binding rules had already given away.
          'accountState', 'isDeleted',
          'deletionRequestedAt', 'deletionDueAt', 'purgedAt',

          // Device and session. These are what the one-device rule and the
          // device-ban cascade are made of.
          'deviceId', 'activeMobileSession', 'sessionToken', 'credentialsValidAfter',

          // Identity keys. Moving one of these between accounts is the takeover
          // that `bindVerifiedIdentity`'s three-case rule exists to refuse.
          'phoneKey', 'phoneNumber', 'email',

          // Trust and payout gates.
          'isVerifiedHost', 'payoutHold',

          // Paid goods — `equipBagItem` checks ownership and expiry, which a
          // rule cannot.
          'equippedFrame', 'equippedChatBubble', 'equippedProfileCard',
          'equippedIdFrame', 'equippedEntrance',
        ];
      }

      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // ── callRateBeans: moved out of the rules entirely ──────────────────────
      //
      // There was a `callRateWithinBand()` predicate here, and an extra clause
      // on the update below that let an owner write `callRateBeans` as long as
      // it satisfied it. Both are gone, and the field is on
      // ownerProtectedFields() instead. The `setCallRate` callable is now the
      // only way a rate is set.
      //
      // The predicate compared the requested rate against
      // `appConfig/economy.maxHostCallRate`, a single platform-wide number that
      // is 700. What a host may actually charge depends on their level: the
      // ladder in `levelConfig/host/levels` runs from 700 at level 0 to 2,400 at
      // level 10. A security rule cannot compute that — it would have to read
      // the host's lifetime earnings, walk the ladder collection and find the
      // rung — so the rule enforced a ceiling that had nothing to do with the
      // host it was applied to.
      //
      // The result was wrong both ways. Hosts who had earned their way up the
      // ladder were pinned at the level-0 ceiling with no explanation, and the
      // ceiling that was enforced was not theirs. `functions/src/hosts.ts`
      // reads the same ladder `getHostHome` draws the slider from, clamps to the
      // host's own rung, and writes with the Admin SDK — which is why this can
      // now say the true thing: no client sets its own price.
      allow update: if
          (isStaff() && !changed().hasAny(staffProtectedFields()))
          || (isOwner(uid) && !changed().hasAny(ownerProtectedFields()));

      // PUBLIC, anonymous — gift and count only. No uid, no timestamp, nothing
      // that could identify who sent or received it.
      match /giftShowcase/{giftId} {
        allow read:  if request.auth != null;
        allow write: if false;
      }

      // PUBLIC, named — how much someone has spent on this host, never which
      // gift or when. This is the Top Fans list.
      match /topFans/{fanUid} {
        allow read:  if request.auth != null;
        allow write: if false;
      }

      // ── Device push tokens ──────────────────────────────────────────────────
      //
      // One document per device, id = the FCM token. Replaces the single
      // `fcmToken` string on the user document, which meant a second phone
      // silently unregistered the first.
      //
      // OWNER ONLY, deliberately not `request.auth != null` like the parent
      // `users/{uid}` read above: an FCM token is enough to ring somebody's
      // phone and to push arbitrary content at it, so it must not be part of the
      // world-readable profile surface. The push functions use the Admin SDK and
      // bypass these rules, so nothing server-side needs read access here.
      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(uid);
      }

      match /blocked/{targetUid}      { allow read, write: if isOwner(uid) || isAdmin(); }
      match /liked/{targetUid}        { allow read, write: if isOwner(uid) || isAdmin(); }
      match /likedBy/{likerUid}       { allow read: if isOwner(uid) || isAdmin(); allow write: if request.auth != null; }

      // ── Subcollections that previously had NO rule ──────────────────────────
      // Without a match block these fell through to the catch-all `if false`.
      // Because the Android client batches them together with the diamond write,
      // the DENY took the whole batch down: bag purchases (BagRepository writes
      // ownedItems + diamonds in one batch) and following/followers were failing
      // outright, not partially.
      /*
       * What this account owns, and until when. SERVER-WRITTEN.
       *
       * The comment above is now history: `purchaseBagItem` moved server-side,
       * so the client no longer batches this with a diamond write and no longer
       * needs to write it at all. Leaving it owner-writable meant the ownership
       * record itself was forgeable — `{ expired: false, expiresAt: <year
       * 3000> }` on any item id, and every paid cosmetic was free. Worse, it
       * made `equipBagItem` pointless before it was written: a callable that
       * validates against a document the client controls validates nothing.
       *
       * Reads stay open to the owner, because the bag screen lists them.
       */
      /*
       * ── `allow write: if false` — NOT `isAdmin()` ───────────────────────────
       *
       * The comment above says SERVER-WRITTEN, and `purchaseBagItem` /
       * `equipBagItem` write it with the Admin SDK, which these rules do not
       * apply to. So `isAdmin()` granted nothing the server needed and
       * everything it did not: `isAdmin()` matches `.*_admin`, so
       * marketing_admin, support_admin — any of the six — could grant any user
       * any paid cosmetic from a browser, with no audit entry and no diamond
       * movement. "Server-written" and "writable by six department admins" were
       * the same line.
       *
       * `false` is the honest spelling of server-written.
       */
      match /ownedItems/{itemId} {
        allow read:  if isOwner(uid) || isStaff();
        allow write: if false;
      }
      // Following someone writes to THEIR followers list, so cross-user writes
      // are required here by design.
      match /followers/{followerUid} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null;
      }
      match /following/{followedUid} {
        allow read:  if request.auth != null;
        allow write: if isOwner(uid) || isAdmin();
      }
      // Moderation warnings issued by CRM staff — the user may read their own.
      match /warnings/{warningId} {
        allow read:   if isOwner(uid) || isStaff();
        allow create, update, delete: if isStaff();
      }
      match /diamondTransactions/{txId} {
        // This is the dispute record — the row a payment gateway is shown when
        // a user claims they never spent a recharge. It was client-creatable
        // by ANY signed-in account, in ANY user's subcollection, and the owner
        // could edit or delete their own rows. A ledger the subject can rewrite
        // is not evidence of anything. Every writer is now a Cloud Function.
        //
        // `allow write: if false` — a Cloud Function uses the Admin SDK, which
        // these rules do not apply to, so `isAdmin()` gave the server nothing
        // and gave all six department admins a browser write on the ledger the
        // line above calls evidence. A row a department admin can forge is not
        // evidence either.
        allow read:  if isOwner(uid) || isFinance() || isAdmin();
        allow write: if false;
      }
      // ── Host figures ────────────────────────────────────────────────────
      //
      // All three are derived from money that has already moved, and all three
      // are written only by Cloud Functions. A host who could write these
      // could show themselves a level they had not earned and a statement for
      // a week they had not worked — and the statement is what they would
      // quote at support.
      //
      // `weeklyStatements` is distinct from the top-level `hostPayouts`, which
      // is the CRM's payout report. Same subject, different documents, and
      // deliberately not the same name.
      match /dailyStats/{dayKey} {
        // Server-written, like the ledgers above. See the note there on why
        // `isAdmin()` was the wrong spelling of that.
        allow read:  if isOwner(uid) || isStaff();
        allow write: if false;
      }
      match /weeklyEarnings/{weekKey} {
        // Server-written, like the ledgers above. See the note there on why
        // `isAdmin()` was the wrong spelling of that.
        allow read:  if isOwner(uid) || isStaff();
        allow write: if false;
      }
      match /weeklyStatements/{weekKey} {
        // Server-written, like the ledgers above. See the note there on why
        // `isAdmin()` was the wrong spelling of that.
        allow read:  if isOwner(uid) || isStaff();
        allow write: if false;
      }

      match /beanTransactions/{txId} {
        // This is the dispute record — the row a payment gateway is shown when
        // a user claims they never spent a recharge. It was client-creatable
        // by ANY signed-in account, in ANY user's subcollection, and the owner
        // could edit or delete their own rows. A ledger the subject can rewrite
        // is not evidence of anything. Every writer is now a Cloud Function.
        // `allow write: if false` — the line above says every writer is a Cloud
        // Function, and a Cloud Function uses the Admin SDK, which these rules
        // do not apply to. `isAdmin()` therefore gave the server nothing and
        // gave all six department admins a browser write on the ledger this
        // comment calls evidence. A row a department admin can forge is not
        // evidence either.
        allow read:  if isOwner(uid) || isFinance() || isAdmin();
        allow write: if false;
      }
      match /giftsSent/{docId}     { allow read, write: if isOwner(uid) || isAdmin(); }
      match /giftsReceived/{docId} {
        allow read:           if request.auth != null;
        allow create:         if request.auth != null;
        allow update, delete: if isOwner(uid) || isAdmin();
      }
    }

    // ══════════════════════════════════════════════════════════════════════════
    // KYC SUBMISSIONS (hosts submit identity docs for verification)
    // ══════════════════════════════════════════════════════════════════════════
    match /kycSubmissions/{docId} {
      allow read:   if isAdmin() || isSupport()
                    || (isAppUser() && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // HOST KYC + BANK DETAILS (managed by agency on behalf of hosts)
    // ══════════════════════════════════════════════════════════════════════════
    match /hostKyc/{hostUid} {
      // Host sees own; agency (ownerUid matches agencyId of host) + admin can read
      allow read: if isAdmin()
                  || isOwner(hostUid)
                  || (request.auth != null
                      && get(/databases/$(database)/documents/users/$(hostUid)).data.agencyId
                         != null);
      allow write: if isAdmin()
                   || (request.auth != null
                       && get(/databases/$(database)/documents/users/$(hostUid)).data.agencyId
                          != null);
    }

    // ══════════════════════════════════════════════════════════════════════════
    // GIFTS CATALOGUE
    // ══════════════════════════════════════════════════════════════════════════
    // A gift is business content — its price, its earning rate, its category —
    // not tech infrastructure. Two screens edit it: /gifts (app_admin,
    // ops_admin) and /tech/content (tech). The rule said `isTech()` only, so
    // the catalogue loaded perfectly for app and ops (it is world-readable) and
    // every add, edit, delete and toggle failed. A page that renders fully and
    // then refuses every button is the worst version of this.
    //
    // Widened to the three teams that own a screen for it. Still not
    // `isStaff()`: marketing and support have no gift screen and no reason to
    // reprice the catalogue.
    match /gifts/{giftId} {
      allow read:  if true;            // public — app shows gifts before login; lottie-test.html needs unauthenticated access
      allow write: if isTech() || isApp() || isOps();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // GIFT LOTTIE DATA — Lottie JSON cached in Firestore to bypass Storage CORS
    // lottie-test.html fetches from here (unauthenticated REST API); no CORS issue.
    // CRM writes here when admin uploads a Lottie JSON in the gift form.
    // Android app is unaffected — it still fetches from the Storage URL directly.
    // ══════════════════════════════════════════════════════════════════════════
    match /giftLottieData/{docId} {
      allow read:  if true;       // public — lottie-test.html is unauthenticated
      // Written by the same gift form as /gifts above, so it needs the same
      // three teams — otherwise saving a gift succeeds and its animation
      // silently does not.
      allow write: if isTech() || isApp() || isOps();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // BAG ITEMS CATALOGUE (avatar frames, profile cards, entrances, chat styles)
    // Tech team manages via CRM /tech/content → Bag Items tab
    // Android app reads to populate MyBag screen dynamically
    // ══════════════════════════════════════════════════════════════════════════
    match /bagItems/{itemId} {
      allow read:  if true;   // public — app shows bag items before login; lottie-test.html needs unauthenticated access
      allow write: if isTech();
    }

    // Gift events. A gift sent INSIDE a room is a public announcement in that
    // room — the ticker and the animation are the point of it. A gift sent
    // anywhere else is private between the two people.
    //
    // Until 10 Sep 2026 this was `allow read: if request.auth != null`, so any
    // signed-in client could query the whole collection and reconstruct who had
    // gifted whom, across the entire platform. The room-scoped read keeps the
    // ticker working and closes that.
    //
    // Writes are closed: settlement is the settleGift Cloud Function, which uses
    // the Admin SDK and bypasses these rules.
    match /giftEvents/{docId} {
      allow read: if request.auth != null
                  && (resource.data.roomId != ''
                   || resource.data.senderUid   == request.auth.uid
                   || resource.data.receiverUid == request.auth.uid);
      allow write: if false;
    }

    // PRIVATE — the two parties, plus finance and admin.
    //
    // Two bugs fixed here on 10 Sep 2026:
    //
    //   * It checked `senderId` / `receiverId`. The data has never had those
    //     fields — GiftRepository writes `senderUid` / `receiverUid`, as
    //     backend/app/services/reports.py:3402 documents. So the owner clause
    //     was ALWAYS FALSE and a user could not read their own gift history at
    //     all; only finance and admin could.
    //
    //   * `allow create: if request.auth != null` let any signed-in client
    //     write its own gift record, with any amounts it liked. Settlement is
    //     now the `settleGift` Cloud Function, which uses the Admin SDK and
    //     bypasses these rules, so the client never needs write access.
    match /giftTransactions/{txId} {
      allow read: if (request.auth != null
                      && (resource.data.senderUid   == request.auth.uid
                       || resource.data.receiverUid == request.auth.uid))
                     || isFinance() || isAdmin();
      allow write: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // DYNAMIC CONTENT CONFIG (tech team manages — app reads)
    // ══════════════════════════════════════════════════════════════════════════
    match /contentConfig/{docId} {
      allow read:  if request.auth != null;
      allow write: if isTech();
      match /{subDoc=**} {
        allow read:  if request.auth != null;
        allow write: if isTech();
      }
    }

    // Level rewards, entry effects, profile cards (subcollections of contentConfig)
    match /levelConfig/{type} {
      allow read:  if request.auth != null;
      allow write: if isTech();
      // Subcollection: levelConfig/user/levels/{n}  and  levelConfig/host/levels/{n}
      match /levels/{docId} {
        allow read:  if request.auth != null;
        allow write: if isTech();
      }
    }

    // ══════════════════════════════════════════════════════════════════════════
    // TEAM TICKETS (internal — any CRM department can file, assign to any team)
    // Cross-department board, so any CRM staff member can read/create/update.
    // Also written by Support routing an app-user ticket (routeSupportTicketToTeam).
    // ══════════════════════════════════════════════════════════════════════════
    match /techTickets/{ticketId} {
      allow read:   if isCrmUser();
      allow create: if isCrmUser();
      allow update: if isCrmUser();
      allow delete: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // OPERATIONS TICKETS (device bans, report reviews, feedback escalations)
    // ══════════════════════════════════════════════════════════════════════════
    match /opsTickets/{ticketId} {
      allow read:   if isOps() || isAdmin();
      allow create: if isCrmUser() || isAppUser();  // users can raise reports
      allow update: if isOps() || isAdmin();
      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // FINANCE — PLATFORM REVENUE + STATS
    // ══════════════════════════════════════════════════════════════════════════
    match /platformRevenue/{docId} {
      allow create:         if request.auth != null;
      allow read:           if isFinance() || isAdmin();
      allow update, delete: if false;
    }

    match /platformStats/{docId} {
      allow read, create, update: if request.auth != null;
      allow delete:               if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // WEEKLY PAYOUT REPORTS (auto-generated Sunday 23:59 by Cloud Function)
    // ══════════════════════════════════════════════════════════════════════════
    match /weeklyPayoutReports/{reportId} {
      // Finance + admin: full access
      // Agency owner: read their own report, submit it
      allow read: if isFinance() || isAdmin()
                  || (request.auth != null
                      && resource.data.agencyOwnerUid == request.auth.uid);
      allow create: if isFinance() || isAdmin();  // Cloud Function uses Admin SDK (bypasses rules)
      allow update: if isFinance() || isAdmin()
                    || (request.auth != null
                        && resource.data.agencyOwnerUid == request.auth.uid
                        && resource.data.status == 'generated'
                        && request.resource.data.status == 'submitted');
      allow delete: if isSuperAdmin();
    }

    // Individual host payout records within a weekly report
    match /hostPayouts/{payoutId} {
      allow read: if isFinance() || isAdmin()
                  || (request.auth != null && resource.data.agencyOwnerUid == request.auth.uid)
                  || (request.auth != null && resource.data.hostUid == request.auth.uid);
      allow create: if isFinance() || isAdmin();
      allow update: if isFinance() || isAdmin()
                    || (request.auth != null
                        && resource.data.agencyOwnerUid == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // COIN SELLERS
    // ══════════════════════════════════════════════════════════════════════════
    /*
     * ══════════════════════════════════════════════════════════════════════════
     * THE PUBLIC COIN-SELLER DIRECTORY
     * ══════════════════════════════════════════════════════════════════════════
     *
     * Six fields and a document id, projected from `sellers/{id}` by the
     * `syncPublicSeller` trigger: displayName, phone, qrCodeUrl, description,
     * photoUrl, isOnline. Nothing else is in the document, so nothing else can
     * be read out of it — which is the whole point of the collection existing.
     *
     * `sellers` was `allow read: if request.auth != null`, and `read` is `get`
     * AND `list`, so any signed-in account could page every seller's KYC
     * documents, coin balance, commission rate and email. Narrowing that list
     * could not fix it: Firestore returns a document whole or not at all, and
     * rules cannot filter fields. A second document with fewer fields in it is
     * the only thing that can.
     *
     * READ is open to any signed-in account, because that is what a directory
     * is for. WRITE is closed to everybody — the trigger uses the Admin SDK,
     * which these rules do not apply to, so there is no client path to argue
     * about and no "but staff need to edit it" exception to erode. Staff edit
     * the private record; the trigger republishes.
     *
     * A seller who is rejected, suspended or deactivated has their public
     * document DELETED rather than flagged, so there is no visibility query
     * anybody can forget to write.
     */
    match /publicSellers/{sellerId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    match /sellers/{sellerId} {
      /*
       * ── WHY THIS IS NOT SIMPLY `request.auth != null` ANY MORE ─────────────
       *
       * `read` is `get` AND `list`, so that one line let any signed-in account
       * page the entire collection: every seller's `coinBalance` and
       * `totalCoinsSold` (inventory — money), their `commissionRate`, their
       * `idDocUrls` (KYC documents), their phone, email and payout details.
       * The `users/{uid}` block two hundred lines up was narrowed to
       * `allow list: if isStaff()` for exactly this reason; the same reasoning
       * was never applied here.
       *
       * The app does need a directory: `ResellerListScreen` queries
       * `where('isApproved', == true).where('isActive', == true)` to show who a
       * user can buy diamonds from. A list rule is evaluated against every
       * document the query returns, so requiring those two fields makes that
       * query succeed and an unfiltered sweep fail — pending, rejected and
       * suspended sellers stop being enumerable at all.
       *
       * ── AND WHY THE APP NO LONGER READS THIS COLLECTION AT ALL ────────────
       *
       * Narrowing the list to approved-and-active stopped pending and rejected
       * records being enumerated and did nothing for the rest: Firestore returns
       * a document whole or not at all, so an approved seller's KYC was still
       * one directory query away. Rules cannot filter fields.
       *
       * `publicSellers/{id}` is the directory now — six fields, written by the
       * `syncPublicSeller` trigger from an explicit allowlist. The app reads
       * that; this collection is staff and self only.
       */
      allow get:    if isStaff()
                    // The seller reading their own record. The document id is
                    // the uid on records the app creates, and a field on the
                    // ones the CRM creates, so both spellings are honoured —
                    // `SellerDashboardScreen` reads `sellers/{currentUid}`
                    // while `/seller-signup` uses `addDoc` and links by field.
                    || (request.auth != null
                        && (sellerId == request.auth.uid
                         || resource.data.get('crmUid', '') == request.auth.uid
                         || resource.data.get('ownerUid', '') == request.auth.uid
                         || resource.data.get('secondRoleOwnerUid', '') == request.auth.uid));
      // Staff only. The app reads `publicSellers` now — see the note above and
      // the block at the end of this file.
      allow list:   if isStaff();
      // CRM staff adds directly, OR app user self-registers (links to their uid),
      // OR unauthenticated user submits via the public /seller-signup page.
      //
      // CRITICAL: every clause must pin coinBalance and totalCoinsSold to 0.
      // Without that, an ordinary app user could create sellers/{ownUid} with
      // coinBalance: 1000000000, then file a rechargeRequests doc naming
      // themselves as BOTH buyer and seller, approve it themselves, and let the
      // onRechargeApproved Cloud Function mint real diamonds — no CRM account, no
      // money paid. Hardening `update` alone did not close this; `create` was the
      // way in. Opening balances are loaded afterwards via the approved coin
      // purchase flow, which is finance-gated.
      // The superadmin/finance exemption that used to sit at the top of this
      // clause has been removed. It let those two roles set any opening balance
      // they liked, which flatly contradicted the paragraph above — "every clause
      // must pin coinBalance and totalCoinsSold to 0" — and meant one person could
      // register a seller and fund them in the same click, with no second person
      // and no owner signature.
      //
      // app/sellers/register now creates the seller at zero and raises a coin
      // purchase card for the opening load, which is verified, signed and then
      // executed by the backend through the Admin SDK. NOBODY opens a balance
      // from a browser.
      allow create: if (
                         (
                           request.resource.data.get('coinBalance', 0) == 0
                        && request.resource.data.get('totalCoinsSold', 0) == 0
                        && (
                             isStaff()
                          || (isAppUser()
                              && request.resource.data.ownerUid == request.auth.uid
                              && request.resource.data.isApproved == false
                              && request.resource.data.isActive == false)
                          || (request.auth == null
                              && request.resource.data.isApproved == false
                              && request.resource.data.isActive == false
                              && request.resource.data.source == 'self_signup')
                          // An existing partner applying for the coin-seller
                          // capability on the login they already have. Note
                          // where this sits: INSIDE the zero-balance wrapper, so
                          // the paragraph above still holds without exception —
                          // this record opens at zero like every other, and its
                          // opening load is a verified, signed coin purchase
                          // card executed by the backend.
                          //
                          // `secondRoleOwnerUid` is the field the capability
                          // claim on crmUsers is bound to, so it must name the
                          // creator here and nobody else. It is written once,
                          // at creation, and no update clause below can touch it.
                          || (isCrmUser()
                              && request.resource.data.get('source', '') == 'second_role'
                              && request.resource.data.get('secondRoleOwnerUid', '') == request.auth.uid
                              && request.resource.data.get('crmUid', '') == request.auth.uid
                              && request.resource.data.isApproved == false
                              && request.resource.data.isActive == false)
                        )
                      )
                    );
      // coinBalance / totalCoinsSold are INVENTORY — they are money.
      // Staff keep their operational access to everything else (approving
      // sellers, editing details), and the seller themself may not write their
      // own balance — previously `isCrmUser() && crmUid == uid` had no field
      // restriction, so any coin seller could mint their own inventory to any
      // value.
      // Field access uses .get(field, default): reading an ABSENT field in rules
      // raises an error, which denies the whole request rather than evaluating
      // false. Legacy seller docs without ownerUid/crmUid would hard-deny.
      //
      // NOBODY writes coinBalance or totalCoinsSold from a browser any more —
      // not finance, not a superadmin. Seller inventory is money, and money moves
      // through the card board: coin purchases, lending, recovery and write-offs
      // are raised, verified by a second person, signed by an owner and executed
      // by the backend with the Admin SDK, which bypasses these rules. Leaving
      // finance a direct write meant the entire approval chain was optional.
      allow update: if (
                        (isSuperAdmin() || isFinance() || isAdmin())
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['coinBalance', 'totalCoinsSold']))
                    || (request.auth != null
                        && resource.data.get('ownerUid', '') == request.auth.uid
                        && request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly(['isOnline', 'lastSeen']))
                    // CRM seller updating their own seller doc. Allow-list, not a
                    // deny-list: a deny-list still permits writing ownerUid,
                    // crmUid, commissionRate or any newly added field.
                    //
                    // `displayName`, `phone`, `email` and `idDocUrls` have come
                    // OUT of this list. They are the identity a reviewer signed
                    // off on, and an approved seller could rewrite all four
                    // without anyone looking again. They are proposed through
                    // the clause below instead.
                    || (isCrmUser()
                        && resource.data.get('crmUid', '') == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['city', 'description', 'qrCodeUrl',
                                        'isOnline', 'lastSeen']))
                    // A seller nobody has decided on yet edits directly, the
                    // same exemption agencies get. There is no verified account
                    // to protect before the first decision, and without this a
                    // brand-new seller filling in their own details would be
                    // proposing changes to a record no reviewer has ever seen.
                    || (isCrmUser()
                        && resource.data.get('crmUid', '') == request.auth.uid
                        && resource.data.get('isApproved', false) != true
                        && resource.data.get('status', 'pending') == 'pending'
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['coinBalance', 'totalCoinsSold', 'isApproved',
                                       'isActive', 'status', 'ownerUid', 'crmUid',
                                       'commissionRate']))
                    // A seller proposing a change to identity or payout details.
                    // The live fields do not move until a reviewer applies them.
                    || (isCrmUser()
                        && resource.data.get('crmUid', '') == request.auth.uid
                        && proposesChangeOnly())
                    // The applicant writing the `crmUid` back-link straight after
                    // signup. The seller record is created before the account
                    // exists, so it carries no uid to match on — the verified
                    // email is the binding, and the write is pinned to that one
                    // field. Without this, seller signup completes the account
                    // and then fails on the link, leaving a login that no rule
                    // can associate with its seller.
                    || (request.auth != null
                        && resource.data.get('email', '') == request.auth.token.email
                        && resource.data.get('crmUid', '') == ''
                        && request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly(['crmUid']));
      allow delete: if isAdmin();

      // Recharge history — coin load records for this seller.
      //
      // ── `allow create: if isAdmin() || isCrmUser()` WAS THE WORST CLAUSE HERE ─
      //
      // `isCrmUser()` is UNSCOPED. It asks "do you hold a crmUsers document",
      // and every coin seller and every agency owner holds one — so any seller
      // could write a coin-load record into ANY OTHER seller's ledger. Nothing
      // in the clause mentioned `sellerId`. The `isAdmin()` half added every
      // department admin on top of that, marketing included.
      //
      // ── AND NOTHING WRITES IT ────────────────────────────────────────────────
      //
      // Searched all four codebases: no Cloud Function, no backend route, no CRM
      // call, no Android call writes this subcollection. The one CRM reference is
      // a comment in `app/sellers/register/page.tsx` describing the behaviour
      // that was REMOVED — the register page used to mint a history entry for
      // whatever number was typed in the box. A ledger with no writer and a
      // write rule open to every partner on the platform is a place to forge
      // evidence, not a feature.
      //
      // Writes are therefore closed outright. If coin-load history is wanted
      // again it belongs with the server code that moves the coins, through the
      // Admin SDK, which bypasses these rules and needs no clause here. Reads are
      // left intact so any legacy entries stay visible to Finance and to the
      // seller whose ledger it is.
      match /rechargeHistory/{entryId} {
        allow read:   if isStaff()
                      || (isCrmUser()
                          && get(/databases/$(database)/documents/sellers/$(sellerId))
                               .data.get('crmUid', '') == request.auth.uid);
        allow write:  if false;
      }

      // Diamond lending ledger — superadmin lends diamonds to seller
      match /diamondLending/{lendId} {
        allow read:   if isAdmin() || isSuperAdmin()
                      || (isCrmUser() && get(/databases/$(database)/documents/sellers/$(sellerId))
                              .data.get('crmUid', '') == request.auth.uid);
        allow create: if isSuperAdmin();
        allow update: if isSuperAdmin();
        allow delete: if isSuperAdmin();
      }
    }

    // Recharge requests (user pays seller → seller approves → coins transfer)
    // Also used when CRM seller initiates a diamond send to a host or agency
    match /rechargeRequests/{reqId} {
      allow read: if isAdmin() || isFinance()
                  || (request.auth != null
                      && (resource.data.buyerUid == request.auth.uid
                          || resource.data.sellerUid == request.auth.uid))
                  // CRM seller reads their own recharge requests
                  || (isCrmUser()
                      && get(/databases/$(database)/documents/sellers/$(resource.data.sellerUid))
                           .data.get('crmUid', '') == request.auth.uid);
      // App user buys from seller (buyer = themselves), OR
      // CRM seller initiates a diamond send to a host/agency (sellerUid = their seller doc)
      allow create: if (isAppUser() && request.resource.data.buyerUid == request.auth.uid)
                    || (isCrmUser()
                        && get(/databases/$(database)/documents/sellers/$(request.resource.data.sellerUid))
                             .data.get('crmUid', '') == request.auth.uid);
      // Self-dealing guard: approving a request where buyer and seller are the
      // same identity mints diamonds for free via onRechargeApproved. A genuine
      // sale always has a distinct buyer.
      //
      // ── THE STAFF CLAUSE WAS `isAdmin()`, AND THIS IS THE LIVE MONEY PATH ───
      //
      // Flipping `status` to 'approved' here fires `onRechargeApproved`, which
      // runs a transaction that debits the seller's `coinBalance` and credits the
      // buyer's diamonds. It is the one write in this file that mints currency as
      // a side effect. `isAdmin()` matches `.*_admin`, so marketing_admin,
      // support_admin, app_admin and ops_admin could all fire it — none of whom
      // holds `can_coin_operations` in `roles.PERMISSIONS`, which is the system's
      // own statement that coins are not theirs to move.
      //
      // Finance at admin tier, or the owner. `lib/sellers.ts` still exports
      // `approveRecharge`/`rejectRecharge` but nothing in the CRM calls them, so
      // this is a break-glass path rather than a screen — which is a reason to
      // narrow it, not a reason to leave it wide.
      //
      // The seller clauses below are untouched: the seller approving their own
      // sale is the normal path, and the buyer-is-not-seller test beside each one
      // is the self-dealing guard that stops a single identity minting for free.
      allow update: if canDecideCoinOps()
                    || (request.auth != null
                        && resource.data.get('sellerUid', '') == request.auth.uid
                        && resource.data.get('buyerUid', '') != request.auth.uid)
                    // CRM seller approves/rejects recharge
                    || (isCrmUser()
                        && resource.data.get('buyerUid', '') != request.auth.uid
                        && get(/databases/$(database)/documents/sellers/$(resource.data.sellerUid))
                             .data.get('crmUid', '') == request.auth.uid);
      // Owner only. Deleting a settled recharge destroys the record of a payment
      // a buyer made in cash, and it is the document `onRechargeApproved` read to
      // decide what to mint. No department needs this; Finance rejects instead.
      allow delete: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // PAYMENT CONFIG (per-country payment methods — tech/admin manages)
    // ══════════════════════════════════════════════════════════════════════════
    // ══════════════════════════════════════════════════════════════════════════
    // CALL HISTORY — written by the caller's client at call settlement
    // ══════════════════════════════════════════════════════════════════════════
    // This collection had NO match block, so the catch-all `if false` denied it.
    // CallEconomyRepository batches this record together with the diamond debit
    // and bean credit, so the deny was failing the ENTIRE call settlement — calls
    // were not being charged or paid out at all. Composite indexes on
    // callerUid+timestamp and receiverUid+timestamp already exist for it.
    match /callHistory/{callId} {
      allow read:   if isStaff()
                    || (request.auth != null
                        && (resource.data.get('callerUid', '') == request.auth.uid
                            || resource.data.get('receiverUid', '') == request.auth.uid));
      // Written by endCall and the stale-call watchdog, never by a client.
      // This is the record a payment gateway is shown when a user disputes a
      // recharge — "the diamonds were spent on this call, of this length, with
      // this account". A row either party could create or edit proves nothing.
      allow write: if isAdmin();
    }

    // ── Host identity verification ──────────────────────────────────────────
    //
    // Holds two photographs of a person's face and a decision about whether
    // they are the same person. Face images are biometric data under India's
    // DPDP Act, which is why this is the tightest read rule in the file: the
    // host themselves, and staff who review. Not the agency — an agency that
    // can read the verdict on its own hosts can work out how to get past it.
    //
    // Written only by Cloud Functions (activateHost, submitHostCapture,
    // reviewHostVerification) through the Admin SDK. A host who could write
    // `status: 'verified'` here would be writing their own payout approval.
    // The clause below used to be `isAdmin()`, directly contradicting the
    // paragraph above it. `activateHost`, `submitHostCapture` and
    // `reviewHostVerification` write this through the Admin SDK, which bypasses
    // this file entirely — so the only thing `isAdmin()` granted was a browser
    // write, to every `.*_admin` including marketing and support.
    //
    // What that is worth: this document holds the decision gating a host's
    // payouts. `status: 'verified'` written here is a payout approval, and the
    // comment above explains that a host writing their own would be signing it
    // themselves. A marketing admin writing it is the same act by a different
    // hand. Closed, because nothing that legitimately writes it is affected.
    match /hostVerification/{uid} {
      allow read:  if isOwner(uid) || isStaff();
      allow write: if false;
    }

    // Which payment methods are live in a country — bank transfer, UPI, Binance.
    // The Android app reads it to decide what to show a buyer; `lib/tech.ts`
    // writes it from `/tech/payments`.
    //
    // `isTech() || isAdmin()` was the same pattern already removed from
    // `appConfig` in the previous phase, and it is wrong for the same reason: the
    // `isAdmin()` half admitted marketing_admin and support_admin to the table
    // that decides how money reaches the platform in each country. Turn a method
    // off and every seller in that country stops being able to pay in; turn one on
    // and payments start flowing down a rail nobody has reconciled.
    //
    // Tech and the owner, matching `appConfig/economy` exactly.
    //
    // Tech MEMBERS are kept deliberately, and it is the one place in this patch
    // where a member is not excluded. `can_economy_config` is held by tech_member
    // in `roles.PERMISSIONS`, `appConfig` already resolved this the same way in a
    // change that has been reviewed, and this document is configuration: it moves
    // no money by itself and names no account. The account numbers live in
    // `appConfig/paymentCredentials`, which is superadmin alone.
    match /paymentConfig/{countryCode} {
      allow read:  if request.auth != null;   // app reads to show payment options
      allow write: if isTech() || isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // FEEDBACK / SUPPORT TICKETS (from app users)
    // Two collection names are used interchangeably in the codebase:
    //   - feedbackTickets  (Android app creates these)
    //   - supportTickets   (CRM /tickets/ page reads these)
    // Both point at the same logical data; Android writes to feedbackTickets,
    // CRM reads from supportTickets. Give identical rules to both.
    // ══════════════════════════════════════════════════════════════════════════
    match /feedbackTickets/{ticketId} {
      allow create: if isAppUser() && request.resource.data.userId == request.auth.uid;
      allow read:   if (isAppUser() && resource.data.userId == request.auth.uid)
                    || isOps() || isAdmin() || isSupport();
      allow update, delete: if isOps() || isAdmin() || isSupport();
    }

    match /supportTickets/{ticketId} {
      allow create: if isAppUser() && request.resource.data.userId == request.auth.uid;
      allow read:   if (isAppUser() && resource.data.userId == request.auth.uid)
                    || isOps() || isAdmin() || isSupport();
      allow update, delete: if isOps() || isAdmin() || isSupport();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // INTERNAL CRM SUPPORT TICKETS (agency/seller/team issues raised to support team)
    // ══════════════════════════════════════════════════════════════════════════
    match /crmSupportTickets/{ticketId} {
      allow read:   if isCrmUser()
                    && (resource.data.raisedByUid == request.auth.uid
                        || isSupport() || isAdmin());
      allow create: if isCrmUser();
      allow update: if isSupport() || isAdmin();
      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // PK INVITES / LIVE ROOMS
    // ══════════════════════════════════════════════════════════════════════════
    match /pkInvites/{inviteId} {
      allow read:   if request.auth != null;
      allow create: if isAppUser() && request.auth.uid in request.resource.data.participants;
      allow update: if (isAppUser() && request.auth.uid in resource.data.participants) || isAdmin();
      allow delete: if isAdmin();
    }

    match /liveRooms/{roomId} {
      // Who may OPEN a live room.
      //
      // This used to be "any signed-in user who names themselves as host",
      // which is not a gate at all — every account on the platform could
      // broadcast, verified or not, and nothing on the server disagreed
      // because `startLive` is a direct client write with no callable in the
      // path. Going live has to mean the same thing everywhere else in the
      // product assumes it means: a verified host, with an agency behind them
      // and a payout trail.
      //
      // The `get()` costs one document read per attempt. Opening a room is a
      // rare act — once per stream, not once per viewer — so that is the right
      // place to spend a read.
      function liveHost() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }
      function mayGoLive() {
        return isAppUser()
            && liveHost().isHost == true
            && liveHost().isVerifiedHost == true
            && liveHost().get('isBanned', false) != true;
      }
      function isLiveHost() {
        return isAppUser() && resource.data.hostUid == request.auth.uid;
      }
      function liveChanged() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      allow read:   if request.auth != null;
      allow create: if mayGoLive() && request.resource.data.hostUid == request.auth.uid;

      // Who may CHANGE a live room.
      //
      // This was `request.auth != null` — any signed-in user could edit ANY
      // room. A viewer could rewrite `hostUid`, flip `isActive` to kill
      // somebody's stream, zero `totalBeansEarned`, or empty `kickedViewers`
      // to un-kick themselves, which quietly undid the whole kick mechanism.
      //
      // A viewer legitimately writes exactly two counters, and nothing else.
      // Everything that decides money, identity or moderation belongs to the
      // host or to the server.
      allow update: if isLiveHost()
                    || (isAppUser() && liveChanged().hasOnly(['viewerCount', 'likeCount']))
                    || isOps();
      allow delete: if isLiveHost() || isOps();

      // A kicked viewer is OFF this stream, not merely muted on the video.
      //
      // `generateAgoraToken` refuses them the media, so an honest client tears
      // itself down — but the comment stream and the presence row were
      // `request.auth != null`, and neither consulted `kickedViewers`. So the
      // host's "Remove" cut the picture and left the person typing in the chat
      // and re-adding themselves to the viewer list. The party rules already
      // got this right; live did not.
      function notKickedFromLive() {
        return !(request.auth.uid in
                 get(/databases/$(database)/documents/liveRooms/$(roomId))
                   .data.get('kickedViewers', []));
      }

      match /comments/{commentId} {
        allow read:           if request.auth != null;
        allow create:         if isActiveAppUser() && notKickedFromLive();
        allow update, delete: if isOps() || isAdmin();
      }
      match /gifts/{giftId} {
        allow read:           if request.auth != null;
        // Written by settleGift on the server. A client create here would be a
        // gift nobody paid for.
        allow create:         if request.auth != null;
        allow update, delete: if isAdmin();
      }
      match /viewers/{uid} {
        allow read:           if request.auth != null;
        allow create, update: if isActiveAppUser()
                              && request.auth.uid == uid
                              && notKickedFromLive();
        allow delete: if (isAppUser()
                          && (request.auth.uid == uid
                              || request.auth.uid == get(
                                   /databases/$(database)/documents/liveRooms/$(roomId)
                                 ).data.hostUid))
                         || isOps();
      }
    }

    // ══════════════════════════════════════════════════════════════════════════
    // PARTY ROOMS
    //
    // Several people on seats, talking to a room of listeners. Audio rooms seat
    // ten or fifteen, video rooms six or ten — `mode` and `seatCount` decide,
    // and the server is what enforces both.
    //
    // ── WHAT THIS BLOCK LOOKED LIKE BEFORE, AND WHY IT CHANGED ────────────────
    //
    // The room document had `allow update: if isRoomHost()` with NO FIELD
    // RESTRICTION. That is the whole document: the owner's client could rewrite
    // `seatCount`, `kickedUsers`, `admins`, `passwordHash`, and
    // `totalBeansEarned` — the earnings figure the room's own leaderboard is
    // drawn from. It was written that way because seat locking needed one field
    // (`lockedSeats`) and nothing smaller was available.
    //
    // Now every one of those has a callable: `updatePartyRoom`,
    // `setPartySeatLock`, `setPartyAdmin`, `leavePartySeat`. So the room
    // document is server-only, and this block says so.
    //
    // ── WHAT A CLIENT MAY STILL WRITE, AND WHY ────────────────────────────────
    //
    // Exactly two things: its own mic and camera state on its own seat, and a
    // chat message. Both are genuinely the client's own business, both are
    // cheap to verify from the request alone, and both happen often enough that
    // a round trip through a callable would be felt.
    //
    // Everything else is a contention question (who is on a seat), a money
    // question (what the seat has earned), a permission question (who may
    // unmute whom), or a secret (the password) — and not one of those is
    // answerable from a rule. See functions/src/party.ts.
    // ══════════════════════════════════════════════════════════════════════════
    match /partyRooms/{roomId} {
      function room() {
        return get(/databases/$(database)/documents/partyRooms/$(roomId)).data;
      }
      function isRoomHost() {
        return request.auth != null && room().hostUid == request.auth.uid;
      }
      function notKicked() {
        return !(request.auth.uid in room().get('kickedUsers', []));
      }
      /**
       * Present in this room, as the server recorded it.
       *
       * `joinPartyRoom` writes the listener row — after checking the password,
       * which is the point. Requiring it here is what stops a private room from
       * being private in the UI only: without it, anyone who could read the
       * collection and learn a room id could post into that room's chat.
       */
      function inRoom() {
        return request.auth != null
               && exists(/databases/$(database)/documents/partyRooms/$(roomId)/listeners/$(request.auth.uid));
      }
      function onOwnSeat() {
        return request.auth != null && resource.data.uid == request.auth.uid;
      }

      /**
       * Anyone signed in may READ a room document, private ones included.
       *
       * That is not a leak, because there is nothing secret left in it: the
       * password is stored as a salted hash (`passwordHash`), never in the
       * clear, precisely so this rule can stay open. What a private room hides
       * is its CONTENTS — the chat, the listeners, and the Agora token — and
       * each of those is gated separately below and in `generateAgoraToken`.
       *
       * It has to stay open because the room list needs the title, the mode and
       * the seat counts of every room to draw a row, including the private ones
       * a person may want to knock on.
       */
      allow read: if request.auth != null;
      allow create, update, delete: if isOps();

      match /seats/{seatIndex} {
        allow read: if request.auth != null;
        // Taking and leaving a seat both go through callables: a seat is a
        // contended resource and a publisher slot on an Agora channel, and
        // neither of those is a thing a client gets to assert for itself.
        allow create, delete: if false;
        allow update: if
          /*
           * The occupant, over their own mic and camera. Nothing else.
           *
           * `selfMuted` and `cameraOff` are deliberately separate fields from
           * `isMuted`, which a moderator writes. One boolean for both would
           * mean a guest the owner had muted could unmute themselves, and the
           * mute hierarchy would not exist.
           */
          (onOwnSeat()
           && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['selfMuted', 'cameraOff']))
          /*
           * A moderator's mute goes through `setPartySeatMute`, not here.
           *
           * The old rule let the room host write `isMuted` directly. That could
           * not express the hierarchy the product asked for — "the owner may
           * unmute anyone, an admin may only unmute what that same admin
           * muted" depends on WHO PLACED the mute, which means reading
           * `mutedBy` and reasoning about it against a role that lives in an
           * array on the parent document. A rule cannot do that.
           */
          || isOps();
      }

      /**
       * Presence. SERVER-WRITTEN, which is new.
       *
       * It used to be a client write, and two things followed. `listenerCount`
       * on the room had no writer at all, so the room list ran an aggregate
       * count query per row to show "12 listening" — a round trip per row of a
       * scrolling list. And a private room was impossible: a password check is
       * only a check if the thing it guards cannot be written without passing
       * it, and a client writing its own presence row simply skipped the
       * question.
       *
       * `joinPartyRoom` and `leavePartyRoom` own these now. Delete stays open
       * to the person themselves so a client tearing down can still get out if
       * the callable is unreachable — being unable to LEAVE a room is the one
       * failure here with no recovery.
       */
      match /listeners/{uid} {
        allow read:          if request.auth != null;
        allow create, update: if isOps();
        allow delete:        if (isAppUser() && request.auth.uid == uid) || isOps();
      }

      match /messages/{messageId} {
        allow read:   if request.auth != null;
        /*
         * Posting requires a listener row, not just an account.
         *
         * `inRoom()` costs one document read per message sent, and buys the
         * thing `notKicked()` alone could not: a private room whose chat cannot
         * be written by someone who never entered it. A kicked person loses
         * their listener row when they are removed, so this subsumes the old
         * check — `notKicked()` stays anyway, because a room can be re-entered
         * and the two answers are not the same question.
         */
        allow create: if isActiveAppUser()
                      && request.resource.data.senderUid == request.auth.uid
                      && inRoom()
                      && notKicked();
        allow update, delete: if isOps() || isAdmin();
      }

      /**
       * Seat requests, for a room where sitting down needs consent.
       *
       * Read is open to everyone in the room rather than to moderators only:
       * the asker has to be able to see their own request is still pending, and
       * a rule cannot say "your own document or you are a moderator" without a
       * `get()` on the parent for the admin array. One shared read is cheaper
       * and reveals only who is waiting for a seat, in a room they are all
       * sitting in together.
       */
      match /seatRequests/{uid} {
        allow read:  if request.auth != null;
        allow write: if isOps();
      }

      /** Invitations to a seat. Written by `invitePartySeat`, answered by a callable. */
      match /seatInvites/{uid} {
        allow read:  if request.auth != null && (request.auth.uid == uid || isRoomHost());
        allow write: if isOps();
      }

      /**
       * The gift ticker and the per-seat leaderboard.
       *
       * `create: if request.auth != null` was wrong and is now closed. The
       * client used to write these rows itself, which meant `diamondCost` on
       * the leaderboard was whatever the client claimed — a patched app could
       * top the board for free. `settleGift` writes them now, inside the same
       * transaction that moves the money, so the board reflects diamonds that
       * actually changed hands.
       *
       * (For most of this feature's life `settleGift` wrote them to
       * `liveRooms/{partyRoomId}` — a document that does not exist — so nothing
       * landed here at all and every party gift appeared to vanish.)
       */
      match /gifts/{giftId} {
        allow read:  if request.auth != null;
        allow write: if isOps();
      }
    }

    // ══════════════════════════════════════════════════════════════════════════
    // REPORTS (user-to-user reports)
    // ══════════════════════════════════════════════════════════════════════════
    match /reports/{reportId} {
      allow create: if isAppUser() && request.resource.data.reporterUid == request.auth.uid;
      allow read:   if (isAppUser()
                        && (resource.data.reporterUid == request.auth.uid
                         || resource.data.targetUid   == request.auth.uid))
                    || isOps() || isAdmin();
      allow update, delete: if isOps() || isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // APPEALS — contesting a ban, a suspension or a report decision
    // ══════════════════════════════════════════════════════════════════════════
    //
    // The return path. Every other moderation flow runs one way — somebody with
    // authority decides and the person it happened to finds out — and until
    // this existed the honest description of a wrongful ban was "email support
    // and hope".
    //
    // ── WHO MAY RAISE ONE ────────────────────────────────────────────────────
    //
    // Two kinds of raiser, and each is pinned to themselves:
    //
    //   the account itself   `subjectUid == uid`. A banned account is still
    //                        SIGNED IN — `isBanned` gates the product, not the
    //                        session — so the banned screen can write this and
    //                        nothing else. Without that clause the one person
    //                        with the strongest reason to write here is the one
    //                        person who cannot.
    //   their agency         an agency CRM user, for a host of theirs. The
    //                        `agencyId` on the document must be their own, so
    //                        an agency cannot file appeals about other
    //                        agencies' hosts. That the SUBJECT is really their
    //                        host is checked on the server when the appeal is
    //                        decided — a rule cannot look at another document
    //                        in a way a list query can evaluate.
    //
    // ── AND WHO MAY DECIDE ───────────────────────────────────────────────────
    //
    // Nobody, from here. `status`, `decisionReason` and everything an overturn
    // reverses are written by `POST /users/appeals/{id}/decide` on the server,
    // audited, with a four-eyes check that the reviewer is not the person who
    // made the decision being appealed. No clause below lets a browser write a
    // verdict, which is deliberate: an appeal a partner can mark "overturned"
    // is not an appeal.
    match /appeals/{appealId} {
      function appealFields() {
        return ['subjectUid','subjectName','raisedByUid','raisedByName','raisedByRole',
                'agencyId','kind','reportId','statement','evidenceUrls','status',
                'createdAt','originalDecidedBy'];
      }
      function wellFormedAppeal() {
        return request.resource.data.keys().hasOnly(appealFields())
            && request.resource.data.status == 'pending'
            && request.resource.data.raisedByUid == request.auth.uid
            && request.resource.data.statement is string
            && request.resource.data.statement.size() >= 20
            && request.resource.data.statement.size() <= 2000
            && request.resource.data.kind in ['ban', 'report'];
      }

      allow create: if wellFormedAppeal()
                    && (
                      // The account speaking for itself.
                      (isAppUser() && request.resource.data.subjectUid == request.auth.uid)
                      // Or its agency, on its own agencyId.
                      || (isAgencyCrmUser()
                          && request.resource.data.agencyId == crmUserAgencyId())
                    );

      allow read:   if isStaff()
                    || (request.auth != null
                        && resource.data.subjectUid == request.auth.uid)
                    || (request.auth != null
                        && resource.data.raisedByUid == request.auth.uid)
                    || (isAgencyCrmUser()
                        && resource.data.get('agencyId', '') == crmUserAgencyId());

      // Decided on the server, through the API, or not at all.
      allow update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // CONVERSATIONS + MESSAGES
    // ══════════════════════════════════════════════════════════════════════════
    // A conversation belongs to the two uids in `participants`.
    //
    // This used to match on the DOCUMENT ID (`convoId.matches(...uid...)`). That
    // works for a get-by-id, and fails for a list: evaluating a query, Firestore
    // has no document id to bind the wildcard to, so `whereArrayContains
    // ('participants', me)` was denied outright. The Messages tab was therefore
    // always empty — the listener error was swallowed and rendered as "no chats"
    // — while opening the same thread from a profile (a get) worked. Matching on
    // the participants array is what a list rule can actually evaluate.
    match /conversations/{convoId} {
      function isParticipant() {
        return request.auth != null && request.auth.uid in resource.data.participants;
      }
      allow read:   if isParticipant() || isOps();
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;
      allow update: if (request.auth != null
                        && request.auth.uid in request.resource.data.participants)
                    || isOps();
      allow delete: if isOps();

      // Subcollection rules cannot see the parent's data, so these still key on
      // the id — which is fine, because messages are only ever read as a
      // subcollection of one known conversation, never queried across parents.
      //
      // ── BLOCKING NOW STOPS MESSAGES ───────────────────────────────────────
      //
      // It did not. `startCall` checked `users/{peer}/blocked/{caller}` and the
      // push function suppressed the notification, but `sendMessage` wrote
      // straight to Firestore and this clause asked only whether the sender was
      // named in the conversation id. So a blocked person's messages arrived
      // silently in the recipient's inbox — while the unblock dialog in the app
      // says, in as many words, "they'll be able to message you again".
      //
      // ── AND A BANNED ACCOUNT CANNOT SEND ONE ──────────────────────────────
      //
      // Reading is deliberately left alone in both cases. Someone who has been
      // blocked, or banned, must still be able to open their own history: the
      // messages are as much theirs as the other party's, and hiding them
      // retroactively would be rewriting what happened.
      match /messages/{msgId} {
        function inThisConversation() {
          return request.auth != null
                 && convoId.matches('.*' + request.auth.uid + '.*');
        }
        // The other uid in `a_b`, worked out by removing our own.
        function peerUid() {
          return convoId.replace('_' + request.auth.uid, '')
                        .replace(request.auth.uid + '_', '');
        }
        function notBlockedByPeer() {
          return !exists(/databases/$(database)/documents/users/$(peerUid())/blocked/$(request.auth.uid));
        }

        allow read:   if inThisConversation() || isOps();
        allow write:  if (inThisConversation() && notBanned() && notBlockedByPeer())
                      || isOps();
      }
    }

    // ══════════════════════════════════════════════════════════════════════════
    // VIDEO CALLS
    // ══════════════════════════════════════════════════════════════════════════
    match /calls/{callId} {
      // ── Read-only to both parties. Written only by Cloud Functions. ─────────
      //
      // This document IS the bill: `startedAt`, `perMinRateDiamonds`,
      // `tickIndex` and `status` are the four numbers a call's charge is
      // computed from. Create and update were open to either participant, so
      // the caller's device set its own start time and its own rate — and
      // `tickIndex` was writable, which is the server's record of what it has
      // already billed.
      //
      // startCall, acceptCall, declineCall, tickCall and endCall own all of it
      // now, through the Admin SDK, which does not consult these rules.
      allow read:   if (request.auth != null
                        && (resource.data.callerId   == request.auth.uid
                         || resource.data.receiverId == request.auth.uid))
                    || isAdmin();
      allow write:  if isAdmin();

      // In-call chat. Either party may read and post; a message names its
      // sender and nothing else about the bill is reachable from here.
      match /messages/{msgId} {
        function isParty() {
          let call = get(/databases/$(database)/documents/calls/$(callId)).data;
          return request.auth != null
                 && (call.callerId == request.auth.uid || call.receiverId == request.auth.uid);
        }
        allow read:   if isParty() || isAdmin();
        allow create: if isParty() && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // ══════════════════════════════════════════════════════════════════════════
    // BROADCASTS + NOTIFICATIONS + APP CONFIG
    // ══════════════════════════════════════════════════════════════════════════
    match /broadcasts/{broadcastId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin() || isMarketing();
    }

    match /notifications/{notifId} {
      allow read:  if (request.auth != null && resource.data.userId == request.auth.uid)
                   || isAdmin();
      allow write: if isAdmin();
    }

    match /appConfig/{docId} {
      /*
       * `androidUpdate` is readable BEFORE sign-in. Everything else is not.
       *
       * The in-app updater checks this document on the login screen, and on the
       * login screen there is usually no session — a fresh install has none, and
       * so does anybody who has signed out. `request.auth != null` therefore
       * denied the read, `UpdateRepository` caught the denial and answered "up
       * to date" (it fails open by design, so a broken check can never lock
       * someone out), and the update dialog silently never appeared.
       *
       * That is the wrong way round for the case that matters most: a person
       * stuck on a build too old to get past Login is exactly who needs the
       * update, and gating the fix behind the thing that is broken guarantees
       * they never receive it.
       *
       * Nothing is disclosed. The document holds a version code, a version
       * name, release notes, a size, a SHA-256, and a URL to an APK that is
       * already public-read in Storage — it is the binary handed to anybody who
       * installs the app. The hash is what protects the download, not the ACL.
       *
       * Scoped to the one document id rather than opening the collection.
       * `appConfig` also holds `paymentCredentials`: the company bank account
       * and Binance UID that every coin seller in the country pays into.
       */
      allow read:  if request.auth != null || docId == 'androidUpdate';

      // paymentCredentials holds the company bank account / Binance UID that every
      // coin seller in the country pays into. Under the previous rule
      // (isTech() || isAdmin()) that included tech_member and EVERY department
      // admin — marketing_admin, support_admin and so on — any of whom could
      // silently redirect all incoming revenue to another account. Finance would
      // keep approving the payments because the screenshots still look valid.
      // Superadmin only.
      //
      // ── AND THE REST IS NO LONGER `isAdmin()` ──────────────────────────────
      //
      // `isAdmin()` matches `.*_admin`, so the second clause admitted
      // marketing_admin and support_admin to `appConfig/economy` — the document
      // holding the commission slab table, the bean rate and the diamond price,
      // which the backend reads to compute what every agency is owed. The
      // capability that nominally governs it, `CAN_ECONOMY_CONFIG`, belongs to
      // Tech alone (plus the owner), and the paragraph above makes exactly this
      // argument about `paymentCredentials` and then stops.
      //
      // Tech and the owner. A department that cannot configure the economy from
      // the API should not be able to configure it from a browser.
      allow write: if (docId == 'paymentCredentials' && isSuperAdmin())
                    || (docId != 'paymentCredentials' && (isTech() || isSuperAdmin()));
    }

    match /announcements/{docId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // POLICIES — terms, privacy, community guidelines
    //
    // This collection had NO rule at all, so every read and write fell to the
    // catch-all deny at the foot of this file. `/policies` was dead for every
    // account including superadmin, and `lib/policies.ts::getPolicy` failed
    // silently on a screen whose whole job is publishing the documents users
    // are held to.
    //
    // Read is open to any signed-in account because the Android app shows these
    // to the user — a person cannot agree to terms they are not allowed to
    // read. Writing is `superadmin` + `app_admin`, matching ALLOWED_ROLES on
    // app/policies/page.tsx:29.
    // ══════════════════════════════════════════════════════════════════════════
    match /policies/{docType} {
      allow read:  if request.auth != null;
      allow write: if isSuperAdmin() || isApp();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // HOST WITHDRAWAL REQUESTS
    //
    // Also had no rule, so the queue on /finance/withdrawals never loaded for
    // anyone — the page correctly said the list could not be read, and the
    // reason was that nothing was allowed to read it.
    //
    // Finance and admins work the queue. A host reads their own request and
    // nothing else. Nobody writes a balance here: approving records a decision,
    // and the money itself moves as a signed card on the money board.
    // ══════════════════════════════════════════════════════════════════════════
    match /withdrawalRequests/{reqId} {
      allow read:   if isFinance() || isAdmin()
                    || (request.auth != null
                        && resource.data.get('hostUid', '') == request.auth.uid);
      // A host raises their own. `create` is where the requester is pinned —
      // an update cannot change whose request it is because the field is not
      // in any allowed key set below.
      //
      // The STATUS is pinned here too, and that was missing. Pinning only
      // `hostUid` stopped a host filing on somebody else's behalf and did not
      // stop them filing their own already marked `approved` or `paid` — the
      // update clause below is finance-only, so the state could not be changed
      // afterwards, but it could be chosen at birth.
      allow create: if (isFinance() || isSuperAdmin())
                    || (request.auth != null
                        && request.resource.data.get('hostUid', '') == request.auth.uid
                        && request.resource.data.get('status', '') == 'pending');
      // Deciding a withdrawal is Finance's, for the same reason as above:
      // `isAdmin()` let every department admin approve one.
      allow update: if isFinance() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // SALARY REQUESTS (host withdrawal requests via agency)
    // ══════════════════════════════════════════════════════════════════════════
    /*
     * HOST PAY, REQUESTED BY THE AGENCY THAT EMPLOYS THEM.
     *
     * Despite the name this is not staff salary — that is `staff.salary_minor`
     * in Mongo and never appears in Firestore. This queue is an agency asking
     * the business to pay one of its hosts, and a human reads `amountInr` off
     * the row and sends real money against it.
     *
     * ── WHAT `create: if request.auth != null` MEANT ─────────────────────────
     *
     * Every signed-in account on the platform — every app user, every throwaway
     * made against the public web API key — could file one, naming any agency,
     * any host and any amount. And because `update` keyed on
     * `agencyOwnerUid == request.auth.uid` with no field allowlist, the same
     * account could name itself in that field on create and then approve its own
     * request. An injected payout, self-approved, with no backend involvement
     * and nothing in the audit log.
     *
     * Now: only the agency the request is FOR may raise one, and only as
     * `pending`. Staff may raise one on an agency's behalf for the cases that
     * arrive by email.
     */
    match /salaryRequests/{reqId} {
      allow read: if isFinance() || isAdmin()
                  || (isAgencyCrmUser() && crmUserAgencyId() == resource.data.agencyId)
                  || (request.auth != null
                      && (resource.data.hostUid        == request.auth.uid
                       || resource.data.agencyOwnerUid == request.auth.uid));

      // Pinned to the caller's own agency, and pinned to `pending` — a request
      // cannot be born approved or paid.
      allow create: if request.resource.data.get('status', '') == 'pending'
                    && (
                         isFinance() || isAdmin()
                      || (isAgencyCrmUser()
                          && crmUserAgencyId() == request.resource.data.get('agencyId', ''))
                    );

      /*
       * Deciding it is staff work. The agency's own update is the last step of
       * the flow — marking that they have passed the money on — and is pinned
       * to that one field, because the clause it replaces allowed the requester
       * to write `status: 'approved'` and `amountInr` on their own record.
       */
      // Finance or the owner. `isAdmin()` matched `.*_admin`, so marketing_admin
      // and support_admin could mark a host payout approved and paid from a
      // browser — an authority `CAN_PROCESS_PAYOUT` gives to Finance alone.
      allow update: if isFinance() || isSuperAdmin()
                    || (isAgencyCrmUser()
                        && crmUserAgencyId() == resource.data.agencyId
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status', 'distributedAt'])
                        && request.resource.data.get('status', '') == 'distributed');

      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // APPROVAL REQUESTS (non-superadmin actions pending review)
    // ══════════════════════════════════════════════════════════════════════════
    match /approvalRequests/{requestId} {
      // Superadmin sees all. Requester sees their own.
      allow read: if isSuperAdmin()
                  || (isCrmUser() && resource.data.requestedBy.uid == request.auth.uid);
      // isStaff(), not isCrmUser(). isCrmUser() is true for role 'agency' and
      // 'seller', so external partners could file requests straight into the
      // owners' approval queue — including, before the Cloud Function was
      // stripped, requests that credited diamonds.
      //
      // This queue is legacy. Money never travels through it any more (see
      // functions/src/index.ts::handleCustomApproval); anything that moves a
      // balance must be raised as a card on the money board, where it gets a
      // separate verifier and an owner signature.
      //
      // THE ONE EXCEPTION: an agency inviting a host.
      //
      // The agency dashboard's "Invite Host" flow writes a `hostApplications`
      // document and then files an `add_host` request here for the superadmin
      // to approve. Locking this rule to isStaff() blocked the second write
      // while the first had already succeeded, so every attempt failed with
      // "missing or insufficient permissions" AND left an orphaned pending
      // application behind — one more on every retry.
      //
      // So agencies may file, but only this one shape: type `add_host`,
      // targeting `hostApplications`, an update whose entire payload is
      // `status: approved`, and only against an application belonging to THEIR
      // OWN agency. That last check is the one that matters — without it an
      // agency could queue an approval against another agency's host.
      //
      // Nothing here can move a balance. The payload is pinned to a single
      // field with a single value, and money has not travelled through this
      // queue since handleCustomApproval was stripped; anything that moves a
      // balance is a card on the money board with its own verifier and an
      // owner signature.
      function agencyInvitingOwnHost() {
        return isAgencyCrmUser()
            && request.resource.data.type == 'add_host'
            && request.resource.data.targetCollection == 'hostApplications'
            && request.resource.data.operation == 'update'
            && request.resource.data.payload.keys().hasOnly(['status'])
            && request.resource.data.payload.status == 'approved'
            && get(/databases/$(database)/documents/hostApplications/$(request.resource.data.targetDocId))
                 .data.get('agencyId', '') == crmUserAgencyId();
      }

      allow create: if (isStaff() || agencyInvitingOwnHost())
                    && request.resource.data.requestedBy.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      // Only superadmin can approve/reject (change status)
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // COIN PURCHASE REQUESTS (seller buys coin inventory from Zipper)
    // sellerUid = sellers collection doc ID (NOT Firebase auth uid)
    // ══════════════════════════════════════════════════════════════════════════
    // Legacy alias. READ-ONLY, because it is legacy in the literal sense: a
    // search of all four codebases finds no writer and no reader for this
    // collection name. The live one is `coinPurchaseRequests` below.
    //
    // It kept a full create/update/delete surface open to every `.*_admin` for a
    // collection nothing uses. Reads stay — there may be old documents, and
    // Finance should be able to see them — and every write is closed. A
    // collection nobody writes needs no write rule, and leaving one open is how a
    // forged purchase record gets filed against a seller years later.
    match /coinPurchases/{purchaseId} {
      allow read: if isStaff()
                  || (isCrmUser()
                      && get(/databases/$(database)/documents/sellers/$(resource.data.sellerUid))
                           .data.get('crmUid', '') == request.auth.uid);
      allow write: if false;
    }

    // Primary collection used by the CRM lib (coinPurchases.ts → coinPurchaseRequests)
    match /coinPurchaseRequests/{purchaseId} {
      // Single-document get: admin/finance see all; seller sees own (resource.data available).
      allow get: if isAdmin() || isFinance()
                 || (isCrmUser()
                     && get(/databases/$(database)/documents/sellers/$(resource.data.sellerUid))
                          .data.get('crmUid', '') == request.auth.uid);
      // List queries (getDocs): resource.data is unavailable, so allow any authenticated CRM user.
      // Client always queries with where('sellerUid','==',sellerId) — no extra enforcement needed.
      allow list: if isAdmin() || isFinance() || isCrmUser();

      // ── Who files one ───────────────────────────────────────────────────────
      //
      // A seller, for themselves. `isAdmin()` is dropped: no CRM screen files a
      // purchase on a seller's behalf, and the server path that does
      // (`POST /sellers/{id}/coin-purchases`) runs through the Admin SDK, which
      // bypasses this file entirely and needs no clause.
      //
      // Two bindings, because a seller reaches this from two places and they
      // identify themselves differently. The CRM seller dashboard knows its
      // seller DOCUMENT ID; `BuyCoinScreen` in the Android app writes
      // `sellerUid = Firebase.auth.currentUser.uid`. The first binding is the
      // original one; the second accepts the app's spelling by requiring that the
      // named uid be the caller's OWN and that the seller record it points at name
      // the caller back. Both pin to the caller's own identity, so the second
      // widens availability and not authority.
      //
      // `status == 'pending'` is new and is the security half: the previous clause
      // let a seller file a request ALREADY MARKED 'approved'. Nothing triggers on
      // create, so no coins moved — but `/coin-purchases` shows staff a board of
      // these, and a row that arrives pre-approved is a row somebody acts on.
      allow create: if request.resource.data.get('status', '') == 'pending'
                    && (
                      (isCrmUser()
                       && get(/databases/$(database)/documents/sellers/$(request.resource.data.sellerUid))
                            .data.get('crmUid', '') == request.auth.uid)
                      || (request.auth != null
                          && request.resource.data.get('sellerUid', '') == request.auth.uid)
                    );

      // ── Who decides one ─────────────────────────────────────────────────────
      //
      // Finance at admin tier, or the owner — and ONLY to reject.
      //
      // Approval left the browser already: `lib/coinPurchases.ts` says so in its
      // own header, and `approveCoinPurchase` is gone, replaced by
      // `api.partnerOps.requestCoinPurchase` → a card that moves the balance
      // server-side after signature, with `POST /coin-purchases/{id}/execute`
      // carrying `require_owner`. What remains in the browser is
      // `rejectCoinPurchase`, which "moves no money, it only closes a request
      // document with a reason".
      //
      // So the rule now says exactly that. `isAdmin() || isFinance()` permitted
      // any `.*_admin` — marketing included — to write `status: 'approved'` from a
      // console, which is the browser approval path the CRM deliberately gave up.
      allow update: if canDecideCoinOps()
                    && request.resource.data.get('status', '') == 'rejected';
      // Owner only — this is the evidence a seller paid for inventory.
      allow delete: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // PACKAGES (recharge, wholesale diamond packs, coin packages)
    // App reads; superadmin manages via CRM
    // ══════════════════════════════════════════════════════════════════════════
    match /rechargePackages/{docId} {
      allow read:  if request.auth != null;
      allow write: if isSuperAdmin();
    }

    match /diamondPacks/{docId} {
      allow read:  if request.auth != null;
      allow write: if isSuperAdmin();
    }

    match /coinPackages/{docId} {
      allow read:  if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // COLLECTION-GROUP READS — the CRM's cross-user currency queries
    // ══════════════════════════════════════════════════════════════════════════
    //
    // A rule under `match /users/{uid}/diamondTransactions/{txId}` governs reads
    // at that PATH. It does not govern a collection-group query, which is a
    // different operation and is matched only by a `{path=**}` rule. There was
    // no such rule in this file, so it fell through to the catch-all `if false`
    // below and both of these queries were rejected with permission-denied on
    // EVERY account, superadmin included:
    //
    //   lib/finance.ts getDiamondEconomy()      → collectionGroup('diamondTransactions')
    //   lib/finance.ts getWeeklyBeansBreakdown() → collectionGroup('beanTransactions')
    //
    // On the dashboard those two sat in a `Promise.all` beside a third read that
    // worked, so a refusal discarded all three and the owner read "Diamond
    // Economy 0 · Beans This Week 0 · Net Profit ₹0" — three refusals rendered
    // as three facts.
    //
    // WHY THESE ARE GATED THIS TIGHTLY.
    //   A collection-group rule applies to EVERY subcollection of that name
    //   ANYWHERE in the database — today only `users/{uid}/…`, but any
    //   subcollection added later under any parent is covered automatically and
    //   silently. So:
    //
    //   * READ ONLY. Writes stay on the document-path rules under /users/{uid},
    //     where they are already bound to the account that owns them. A
    //     collection-group write rule would let a holder of one of these roles
    //     rewrite a transaction record anywhere, and these records are the
    //     evidence behind every revenue figure the CRM reports.
    //   * isFinance() || isAdmin() ONLY, and deliberately NOT isStaff(): these
    //     are the whole platform's money movements in one query. A marketing or
    //     support member has no business reading every user's diamond and bean
    //     history, and isCrmUser() would have included agency owners and coin
    //     sellers, who hold crmUsers documents too.
    //   * NO owner clause. A collection-group query cannot be scoped to one
    //     user's own rows — there is no uid to bind against in the path — so
    //     admitting an owner here would admit them to everybody's. A user
    //     reading their OWN history still does so through the document-path
    //     rules above, which are unaffected by this block.
    //
    // Rules are OR'd across every matching block, so this ADDS a permission and
    // removes none: the existing `isOwner(uid) || isFinance() || isAdmin()` read
    // at the document path continues to work exactly as before.
    //
    // Cost: isFinance() and isAdmin() each perform one exists() plus one get()
    // on the same crmUsers document — four document accesses at worst, well
    // inside the ten-per-request limit.
    match /{path=**}/diamondTransactions/{txId} {
      allow read: if isFinance() || isAdmin();
    }

    match /{path=**}/beanTransactions/{txId} {
      allow read: if isFinance() || isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // DENY EVERYTHING ELSE
    // ══════════════════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Gifts ─────────────────────────────────────────────────────────────────
    //
    // Four shapes, four visibilities. Firestore filters DOCUMENTS, not fields —
    // any rule that lets a visitor read a gift transaction hands them senderUid
    // too. So the public views are separate documents that never contained a
    // counterparty, written server-side by settleGift.
    //
    // Every one of these is money-derived, so every one is write:false. The
    // client asks the Cloud Function; it never writes the outcome itself.


    // PAIRWISE — powers the "you sent this 2x" highlight on someone's profile.
    // Readable only by the two uids in the pair id, so opening a profile tells
    // you about your own history and nothing about anybody else's.
    match /giftPairs/{pairId}/gifts/{giftId} {
      allow read: if request.auth != null
                  && pairId.split('_').hasAny([request.auth.uid]);
      allow write: if false;
    }

    // Replay guard for settleGift. Server-only, and never read by a client.
    match /giftIdempotency/{claimId} {
      allow read, write: if false;
    }

  }
}
