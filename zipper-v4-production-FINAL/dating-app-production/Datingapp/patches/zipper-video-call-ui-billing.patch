+    /**
+     * Chamet-style **real-time per-minute billing**.
+     *
+     * Charges exactly [diamondsPerMinute] from [payerUid] for one minute and routes the
+     * receiver's share via the agent-aware split (same logic as
+     * [chargeCallDiamondSessionWithAgentSplit] but always `billedMinutes = 1`).
+     *
+     * Call this:
+     *  - Immediately when the call connects (payer side) — first minute.
+     *  - Every 60 s thereafter while the call is alive.
+     *
+     * @return [Result] wrapping the payer's **new coin balance** after the deduction, or the
+     *         **current balance unchanged** when it was already below [diamondsPerMinute]
+     *         (so the caller knows to auto-end the call).  Returns [Result.failure] only on
+     *         unexpected Firestore errors.
+     */
+    suspend fun chargeOneCallMinute(
+        payerUid: String,
+        receiverUid: String,
+        diamondsPerMinute: Int
+    ): Result<Int> {
+        if (payerUid.isBlank() || receiverUid.isBlank() || payerUid == receiverUid) {
+            return Result.success(Int.MAX_VALUE) // guard: sentinel so caller doesn't auto-end
+        }
+        val rate = diamondsPerMinute.coerceAtLeast(0)
+        if (rate <= 0) return Result.success(Int.MAX_VALUE)
+
+        return try {
+            data class MinuteCharge(val newBalance: Int, val charged: Int, val referralCode: String)
+            val result = db.runTransaction { tx ->
+                val payerRef    = usersCollection.document(payerUid)
+                val receiverRef = usersCollection.document(receiverUid)
+                val payerSnap    = tx.get(payerRef)
+                val receiverSnap = tx.get(receiverRef)
+                if (!payerSnap.exists()) throw IllegalStateException("Payer profile missing")
+                val bal = (payerSnap.getLong("coins") ?: payerSnap.getLong("walletBalance"))?.toInt() ?: 0
+                if (bal < rate) {
+                    // Insufficient — sentinel -1 tells the caller to end the call.
+                    // We do NOT charge; the balance is unchanged.
+                    return@runTransaction MinuteCharge(-1, 0, "")
+                }
+                tx.update(payerRef, mapOf(
+                    "coins"         to FieldValue.increment(-rate.toLong()),
+                    "walletBalance" to FieldValue.increment(-rate.toLong())
+                ))
+                val agentCode = receiverSnap.getString("referralCode")?.trim().orEmpty()
+                MinuteCharge(bal - rate, rate, agentCode)
+            }.await()
+
+            if (result.charged > 0) {
+                if (result.referralCode.isNotBlank()) {
+                    runCatching { creditCallReceiverBeansForDiamonds(payerUid, receiverUid, result.charged) }
+                } else {
+                    runCatching { routeReceiverShareToCompanyAccount(payerUid, receiverUid, result.charged) }
+                }
+            }
+            Log.d(tag, "chargeOneCallMinute: charged=${result.charged} newBal=${result.newBalance} payer=$payerUid")
+            // -1 = insufficient (caller must end call). ≥ 0 = charge succeeded, this is new balance.
+            Result.success(result.newBalance)
+        } catch (e: Exception) {
+            Log.w(tag, "chargeOneCallMinute payer=$payerUid receiver=$receiverUid", e)
+            Result.failure(e)
+        }
+    }
+
+    /**
+     * When the receiver has no agent referral, their call revenue share is credited as raw 💎
+     * to the platform company wallet at Firestore path `company_wallet/main`.
+     *
+     * No Firebase Auth account is required — the document is created automatically on first
+     * billing via `set(..., merge = true)`. The Firestore rule for `company_wallet` allows
+     * any signed-in user to create/update so the SDK transaction can write freely.
+     *
+     * The share fraction mirrors [VirtualEconomyMath.callReceiverBeansEarned]:
+     *   male→female: 50 %, female→male: 40 %, same-gender / unknown: 30 %.
+     * Accumulated fields on `company_wallet/main`:
+     *   `totalDiamonds` — running total of all routed diamonds (never decremented).
+     *   `lastUpdatedMs`  — epoch-ms of the most recent credit.
+     */
+    private suspend fun routeReceiverShareToCompanyAccount(payerId: String, receiverId: String, diamondCost: Int) {
+        if (diamondCost <= 0) return
+        try {
+            db.runTransaction { tx ->
+                val receiverSnap = tx.get(usersCollection.document(receiverId))
+                val payerSnap = if (payerId.isNotBlank()) tx.get(usersCollection.document(payerId)) else null
+                val receiverGender = receiverSnap.getString("gender")?.trim().orEmpty().ifBlank {
+                    receiverSnap.getString("genderText")?.trim().orEmpty()
+                }
+                val payerGender = payerSnap?.takeIf { it.exists() }?.let {
+                    it.getString("gender")?.trim().orEmpty().ifBlank { it.getString("genderText")?.trim().orEmpty() }
+                }.orEmpty()
+                val shareAsDiamonds = VirtualEconomyMath.callReceiverBeansEarned(
+                    diamondCost.toLong(),
+                    payerGender.takeIf { it.isNotBlank() },
+                    receiverGender.takeIf { it.isNotBlank() }
+                ).toInt()
+                if (shareAsDiamonds <= 0) return@runTransaction
+                val companyRef = db.collection(COMPANY_WALLET_COLLECTION).document(COMPANY_WALLET_DOC_ID)
+                // merge=true → creates the document automatically if it doesn't exist yet.
+                tx.set(
+                    companyRef,
+                    mapOf(
+                        "totalDiamonds" to FieldValue.increment(shareAsDiamonds.toLong()),
+                        "lastUpdatedMs" to System.currentTimeMillis()
+                    ),
+                    com.google.firebase.firestore.SetOptions.merge()
+                )
+                Log.d(tag, "routeReceiverShareToCompanyAccount: +$shareAsDiamonds 💎 → company_wallet/main (payer=$payerId receiver=$receiverId)")
+            }.await()
+        } catch (e: Exception) {
+            Log.w(tag, "routeReceiverShareToCompanyAccount failed payer=$payerId receiver=$receiverId", e)
+        }
+    }
