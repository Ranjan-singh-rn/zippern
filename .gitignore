# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firebase-debug.*.log*

# Firebase cache
.firebase/

# Firebase config

# Uncomment this if you'd like others to create their own Firebase project.
# For a team working on the same Firebase project(s), it is recommended to leave
# it commented so all members can deploy to the same project(s) in .firebaserc.
# .firebaserc

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.*
!.env.example

# ── Secrets — never commit ───────────────────────────────────────────────────
# Firebase Admin SDK service account private keys. Anything matching these
# grants full admin access to the project, bypassing all security rules.
serviceAccountKey.json
serviceAccount*.json
*-firebase-adminsdk-*.json
**/serviceAccountKey.json

# Gradle local config. Machine-specific (sdk.dir) and the place where the Agora
# Primary Certificate now lives — see zipper-app/app/build.gradle.kts. This file
# was previously tracked; it must never be committed again.
local.properties
**/local.properties

# dataconnect generated files
.dataconnect

# Backend secrets
backend/.env
backend/.venv/
backend/__pycache__/
**/__pycache__/
*.pyc

# Firestore exports — may contain personal data
backend/backups/

# P0-10 (OPS-D): reset plans and post-checks name production records
# (uids, document ids). Kept on the operator's disk, never committed.
backend/reset-plan*.json
backend/reset-postcheck*.json

# scripts/reset (spec §14): every run's artifacts — backup manifests, Mongo
# dumps, Storage inventories, frozen manifests, execute logs, seed results —
# name production records and people. Operator's disk only.
backend/reset-runs/
# The Owner-supplied Observer/Owner list (names, emails, phones). Never committed;
# ship seed-accounts.example.json instead.
backend/scripts/reset/seed-accounts.json

# Build output — never commit.
# zipper-crm/out held a stale bundle containing a removed superadmin bootstrap
# and real bank details long after both were deleted from source. A single
# `git add .` would have published them.
zipper-crm/out/
zipper-crm/.next/
functions/lib/
**/build/
.gradle/

# TypeScript incremental build cache. Regenerated by every `tsc` run, and it
# records absolute paths from whichever machine last compiled — so it conflicts
# on every pull for no benefit.
*.tsbuildinfo

# macOS Finder metadata. Seven of these were tracked and showed up as modified
# whenever a folder was opened in Finder. They are untracked by the baseline
# commit (the files stay on disk; Finder simply rewrites them).
.DS_Store

# local validation output (never committed)
validation-logs/
